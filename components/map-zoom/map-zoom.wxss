.map-zoom { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 3000; background: rgba(6, 9, 14, 0.96); }
.map-zoom-area { width: 100%; height: 100%; }
/* movable-view 撑满全屏，aspectFit 让任意比例的地图完整居中；缩放后 movable-view 大于区域即可全向拖动。 */
.map-zoom-view { width: 100%; height: 100%; }
.map-zoom-image { width: 100%; height: 100%; }
.map-zoom-close { position: absolute; right: 36rpx; width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, 0.14); color: #FFFFFF; font-size: 44rpx; }
.map-zoom-hint { position: absolute; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 56rpx); color: rgba(255, 255, 255, 0.72); font-size: 24rpx; text-align: center; pointer-events: none; }
