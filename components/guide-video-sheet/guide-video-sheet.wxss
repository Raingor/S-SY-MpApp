/* 购买和播放器均随课程内页排版，不遮住介绍，不锁定页面滚动。 */
.gvm-inline { margin: 12rpx 0 24rpx; border: 1rpx solid #E5DDD0; border-radius: 16rpx; overflow: hidden; background: #FAF7F2; }
.gvm-player { display: block; width: 100%; height: 388rpx; background: #000000; }
.gvm-state { display: flex; flex-direction: column; align-items: center; gap: 18rpx; padding: 32rpx 24rpx; text-align: center; color: #65605A; font-size: 25rpx; }
.gvm-state-copy { line-height: 1.6; }
.gvm-price { color: #947644; font-size: 40rpx; font-weight: 700; }
.gvm-action { margin: 0; padding: 0 44rpx; min-height: 76rpx; line-height: 76rpx; border-radius: 12rpx; background: #F34C48; color: #FFFFFF; font-size: 25rpx; }
.gvm-action::after { border: none; }
.gvm-action-muted { background: #E7E2D8; color: #514B42; }
.gvm-retry { color: #947644; }
