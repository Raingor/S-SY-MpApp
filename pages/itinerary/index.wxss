/* ============ 参考行程列表页 ============ */
.iti-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: #F4F7FA;
  color: #16283A;
}

.iti-hero {
  position: relative;
  padding: 0 32rpx 70rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #071F34, #0B3C5D 70%, #364D71);
  color: #FFFFFF;
}

.iti-hero::after {
  content: '';
  position: absolute;
  right: -140rpx;
  top: 200rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
  box-shadow: 0 0 0 60rpx rgba(255, 255, 255, 0.025);
}

.iti-nav {
  position: relative;
  z-index: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.82);
}

.iti-brand { font-size: 20rpx; letter-spacing: 2rpx; }
.iti-mark { color: #D8B878; font-size: 26rpx; }

.iti-hero-body { position: relative; z-index: 1; padding-top: 40rpx; }

.iti-kicker {
  color: #C6A15B;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.iti-title { margin-top: 16rpx; font-size: 52rpx; line-height: 1.35; }

.iti-subtitle {
  max-width: 600rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 27rpx;
  line-height: 1.8;
}

.iti-pills { display: flex; gap: 12rpx; margin-top: 28rpx; }

.iti-pills text {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 22rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 18rpx;
}

.iti-list { padding: 44rpx 32rpx 0; }

.iti-card { margin-bottom: 26rpx; overflow: hidden; }

.iti-img-wrap { position: relative; }

.iti-img { width: 100%; height: 300rpx; display: block; }

.iti-tag {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(11, 60, 93, 0.72);
  color: #FFFFFF;
  font-size: 18rpx;
}

.iti-days {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(198, 161, 91, 0.9);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
}

.iti-body { padding: 24rpx 28rpx 26rpx; }

.iti-name { color: #0B3C5D; font-size: 32rpx; }

.iti-highlights {
  margin-top: 10rpx;
  color: #5B6B7A;
  font-size: 25rpx;
}

.iti-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.iti-cta {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #D8B878 0%, #C6A15B 60%, #B08D45 100%);
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 600;
}

.iti-crowd { color: #8AA3B5; font-size: 21rpx; }

.iti-consult {
  display: flex;
  align-items: center;
  margin: 26rpx 32rpx 0;
  padding: 26rpx 24rpx;
}

.iti-consult-kicker {
  color: #C6A15B;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.iti-consult-title { margin-top: 8rpx; color: #0B3C5D; font-size: 28rpx; }

.iti-consult-copy {
  max-width: 560rpx;
  margin-top: 6rpx;
  color: #8AA3B5;
  font-size: 22rpx;
  line-height: 1.7;
}

.iti-consult-arrow {
  margin-left: auto;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 34rpx;
}

.iti-footer {
  margin: 56rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid #DCE8ED;
  color: #8AA3B5;
  font-size: 21rpx;
  text-align: center;
}
