<view class="itd-page" wx:if="{{itinerary}}">
  <!-- 头图 -->
  <view class="itd-hero">
    <image class="itd-hero-img" src="{{itinerary.img}}" mode="aspectFill" />
    <view class="itd-hero-mask"></view>
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="itd-nav sy-nav">
      <view class="itd-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="itd-brand">{{i18n.brand}}</view>
      <view class="itd-mark">✦</view>
    </view>
    <view class="itd-hero-body">
      <view class="itd-tag" wx:if="{{isCustom}}">{{i18n.contentPage.customTag}}</view>
      <view class="itd-tag itd-tag-ref" wx:else>{{i18n.contentPage.referenceTag}}</view>
      <view class="itd-title serif">{{itinerary.title}}</view>
      <view class="itd-meta">
        <text wx:if="{{isCustom}}">{{itinerary.period}}</text>
        <text>{{itinerary.days}}{{locale === 'en' ? ' days ' : '天'}}{{itinerary.days - 1}}{{locale === 'en' ? ' nights' : '晚'}}</text>
        <text wx:if="{{itinerary.tag}}">{{itinerary.tag}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 定制行程：订单信息 ===== -->
  <view class="itd-section card" wx:if="{{isCustom}}">
    <view class="itd-kicker">ITINERARY DETAILS</view>
    <view class="itd-heading serif">{{i18n.contentPage.infoHeading}}</view>
    <view class="itd-info">
      <view class="itd-info-row" wx:for="{{itinerary.header}}" wx:key="label">
        <view class="itd-info-label">{{item.label}}</view>
        <view class="itd-info-value">{{item.value}}</view>
      </view>
      <view class="itd-info-row itd-info-fee">
        <view class="itd-info-label">{{i18n.contentPage.fee}}</view>
        <view class="itd-info-value itd-fee">{{itinerary.fee}}</view>
      </view>
    </view>
    <view class="itd-share">
      <button class="itd-share-btn" open-type="share">{{i18n.contentPage.shareTrip}}</button>
    </view>
  </view>

  <!-- ===== 参考行程：概览 ===== -->
  <view class="itd-section card" wx:else>
    <view class="itd-kicker">OVERVIEW</view>
    <view class="itd-heading serif">{{i18n.contentPage.overviewHeading}}</view>
    <view class="itd-overview">
      <view class="itd-ov-row"><text>{{i18n.contentPage.highlightLabel}}</text><view>{{itinerary.highlights}}</view></view>
      <view class="itd-ov-row"><text>{{i18n.contentPage.suitableLabel}}</text><view>{{itinerary.crowd}}</view></view>
    </view>
  </view>

  <!-- ===== 服务图例（定制） ===== -->
  <view class="itd-legend card" wx:if="{{isCustom}}">
    <view class="itd-legend-title">{{i18n.contentPage.serviceLegend}}</view>
    <view class="itd-legend-list">
      <text wx:for="{{serviceKeys}}" wx:key="*this"><text class="star">★</text> {{item}}</text>
    </view>
  </view>

  <!-- ===== 每日行程 ===== -->
  <view class="itd-days">
    <view class="itd-days-head">
      <view class="itd-kicker">DAILY ITINERARY</view>
      <view class="itd-heading serif">{{i18n.contentPage.daily}}</view>
    </view>

    <scroll-view class="itd-day-jump" scroll-x enable-flex>
      <view
        wx:for="{{itinerary.schedule}}"
        wx:for-item="jumpDay"
        wx:key="key"
        class="itd-day-jump-item"
        data-key="{{jumpDay.key}}"
        bindtap="onJumpDay"
      >{{i18n.contentPage.day}}{{isCustom ? jumpDay.no : jumpDay.day}}{{locale === 'en' ? '' : '天'}}</view>
    </scroll-view>

    <view class="itd-day card" wx:for="{{itinerary.schedule}}" wx:for-item="day" wx:key="key" id="itd-day-{{day.key}}">
      <view class="itd-day-head">
        <view class="itd-day-no">
          <text class="itd-day-num">{{isCustom ? day.no : day.day}}</text>
          <text class="itd-day-unit">DAY</text>
        </view>
        <view class="itd-day-info">
          <view class="itd-day-date">{{isCustom ? day.date : i18n.contentPage.day + day.day + (locale === 'en' ? '' : '天')}}</view>
          <view class="itd-day-stay" wx:if="{{day.stay}}">{{i18n.contentPage.night}}{{day.stay}}</view>
          <view class="itd-day-stay" wx:elif="{{day.city}}">{{i18n.contentPage.stay}}{{day.city}}</view>
        </view>
      </view>

      <view class="itd-entry" wx:for="{{day.entries}}" wx:for-item="entry" wx:key="period">
        <view class="itd-entry-period">{{entry.period}}</view>
        <view class="itd-entry-body">
          <text class="itd-entry-title">{{entry.entryTitle}}</text>
          <text wx:if="{{entry.entryDescription}}" class="itd-entry-text">{{entry.entryDescription}}</text>
          <view class="itd-entry-services" wx:if="{{entry.services.length}}">
            <text wx:for="{{entry.services}}" wx:for-item="svc" wx:key="*this" class="svc-chip"><text class="star">★</text>{{svc}}</text>
          </view>
          <view class="itd-entry-spots" wx:if="{{entry.spots.length}}">
            <view
              wx:for="{{entry.spots}}"
              wx:for-item="spot"
              wx:key="id"
              class="spot-card"
              data-id="{{spot.id}}"
              bindtap="onSpotTap"
              hover-class="spot-card-press"
            >
              <image wx:if="{{spot.image}}" class="spot-card-img" src="{{spot.image}}" mode="aspectFill" lazy-load />
              <view wx:else class="spot-card-img spot-card-img-empty"></view>
              <view class="spot-card-mask"></view>
              <view class="spot-card-name">{{spot.name}}</view>
              <view class="spot-card-arrow">›</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 定制行程：服务须知 ===== -->
  <view class="itd-section card itd-notices" wx:if="{{isCustom}}">
    <view class="itd-kicker">NOTICES</view>
    <view class="itd-heading serif">{{i18n.contentPage.notices}}</view>
    <view class="itd-notice-group" wx:for="{{itinerary.notices}}" wx:for-item="group" wx:key="title">
      <view class="itd-notice-title">{{group.title}}</view>
      <view class="itd-notice-item" wx:for="{{group.items}}" wx:for-item="note" wx:key="*this"><text>·</text>{{note}}</view>
    </view>
  </view>

  <!-- ===== CTA ===== -->
  <view class="itd-cta card" bindtap="onCtaTap">
    <view>
      <view class="itd-cta-kicker">{{isCustom ? 'ANY CHANGES?' : 'CUSTOMIZE THIS ROUTE'}}</view>
      <view class="itd-cta-title serif">{{isCustom ? i18n.contentPage.changes : i18n.contentPage.customizeRoute}}</view>
      <view class="itd-cta-copy">{{isCustom ? i18n.contentPage.changesDesc : i18n.contentPage.customizeRouteDesc}}</view>
    </view>
    <view class="itd-cta-arrow">›</view>
  </view>

  <view class="itd-footer">{{i18n.contentPage.footerSlogan}}</view>
</view>
