<view class="iti-page">
  <view class="iti-hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="iti-nav sy-nav">
      <view class="iti-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="iti-brand">SY 希旅人</view>
      <view class="iti-mark">✦</view>
    </view>
    <view class="iti-hero-body">
      <view class="iti-kicker">REFERENCE ITINERARIES</view>
      <view class="iti-title serif">{{i18n.itineraryPage.title}}</view>
      <view class="iti-subtitle">{{i18n.itineraryPage.subtitle}}</view>
      <view class="iti-pills"><text>{{i18n.itineraryPage.pill1}}</text><text>{{i18n.itineraryPage.pill2}}</text><text>{{i18n.itineraryPage.pill3}}</text></view>
    </view>
  </view>

  <view class="iti-list">
    <view class="iti-card card" hover-class="card-press" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="iti-img-wrap">
        <image class="iti-img" src="{{item.img}}" mode="aspectFill" />
        <view class="iti-tag">{{item.tag}}</view>
        <view class="iti-days">{{item.days}}{{locale === 'en' ? ' days ' : '天'}}{{item.days - 1}}{{locale === 'en' ? ' nights' : '晚'}}</view>
      </view>
      <view class="iti-body">
        <view class="iti-name serif">{{item.title}}</view>
        <view class="iti-highlights ellipsis">{{item.highlights}}</view>
        <view class="iti-foot">
          <view class="iti-cta">{{i18n.itineraryPage.cta}}</view>
          <view class="iti-crowd">{{item.crowd}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="iti-consult card" bindtap="onConsult">
    <view>
      <view class="iti-consult-kicker">CUSTOM ITINERARY</view>
      <view class="iti-consult-title serif">{{i18n.itineraryPage.custom}}</view>
      <view class="iti-consult-copy">{{i18n.itineraryPage.customDesc}}</view>
    </view>
    <view class="iti-consult-arrow">›</view>
  </view>

  <view class="iti-footer">{{i18n.commonSlogan}}</view>
</view>
