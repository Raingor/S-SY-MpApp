/* ============ 行程详情页（参考 / 定制） ============ */
.itd-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: #F4F7FA;
  color: #16283A;
}

/* 头图 */
.itd-hero {
  position: relative;
  height: 560rpx;
  overflow: hidden;
  color: #FFFFFF;
}

.itd-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.itd-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(7, 31, 52, 0.42) 0%, rgba(7, 31, 52, 0.05) 40%, rgba(7, 31, 52, 0.78) 100%);
}

.itd-nav {
  position: relative;
  z-index: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: rgba(255, 255, 255, 0.82);
}

.itd-brand {
  max-width: 360rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.itd-mark { color: #D8B878; font-size: 26rpx; }

.itd-hero-body {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 40rpx;
  z-index: 1;
}

.itd-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(198, 161, 91, 0.92);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.itd-tag-ref { background: rgba(21, 103, 168, 0.88); }

.itd-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  line-height: 1.3;
  text-shadow: 0 4rpx 16rpx rgba(7, 31, 52, 0.45);
}

.itd-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.itd-meta text {
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 18rpx;
  font-size: 18rpx;
}

/* 通用区块 */
.itd-section,
.itd-legend,
.itd-cta {
  margin: 24rpx 32rpx 0;
  padding: 30rpx 28rpx;
}

.itd-kicker {
  color: #C6A15B;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.itd-heading {
  margin-top: 10rpx;
  color: #0B3C5D;
  font-size: 34rpx;
}

/* 定制：行程信息 */
.itd-info { margin-top: 20rpx; }

.itd-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EAF0F4;
}

.itd-info-row:last-child { border-bottom: none; }

.itd-info-label {
  flex-shrink: 0;
  max-width: 46%;
  margin-right: 20rpx;
  color: #8AA3B5;
  font-size: 22rpx;
  line-height: 1.6;
}

.itd-info-value {
  flex: 1;
  color: #16283A;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.6;
  text-align: right;
}

.itd-info-fee .itd-info-value { color: #B08D45; }

.itd-fee { font-size: 30rpx; font-weight: 700; }

.itd-share { margin-top: 22rpx; }

.itd-share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #1E7BC0 0%, #1567A8 55%, #0F5488 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
}

.itd-share-btn::after { border: none; }

/* 参考：概览 */
.itd-overview { margin-top: 16rpx; }

.itd-ov-row {
  display: flex;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  line-height: 1.8;
}

.itd-ov-row text {
  flex-shrink: 0;
  margin-right: 18rpx;
  color: #1567A8;
  font-weight: 600;
}

.itd-ov-row view { color: #5B6B7A; }

/* 服务图例 */
.itd-legend-title {
  color: #0B3C5D;
  font-size: 24rpx;
  font-weight: 600;
}

.itd-legend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 26rpx;
  margin-top: 16rpx;
  color: #5B6B7A;
  font-size: 24rpx;
}

.star { color: #C6A15B; margin-right: 4rpx; }

/* 每日行程 */
.itd-days { padding: 8rpx 32rpx 0; }

.itd-days-head { padding: 12rpx 0 4rpx; }

.itd-day-jump {
  width: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
}

.itd-day-jump-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 106rpx;
  height: 54rpx;
  margin-right: 12rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #DCE8ED;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #5B6B7A;
  font-size: 23rpx;
}

.itd-day-jump-item:active {
  border-color: #1567A8;
  background: #EAF4F9;
  color: #1567A8;
}

.itd-day {
  position: relative;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(220, 232, 237, 0.74);
  box-shadow: 0 12rpx 26rpx rgba(11, 60, 93, 0.06);
}

.itd-day::before {
  content: '';
  position: absolute;
  left: 130rpx;
  top: 118rpx;
  bottom: 28rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #C6A15B 0%, #DCE8ED 76%, rgba(220, 232, 237, 0) 100%);
}

.itd-day-head {
  display: flex;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #EAF0F4;
}

.itd-day-no {
  display: flex;
  align-items: baseline;
  margin-right: 22rpx;
}

.itd-day-num {
  color: #1567A8;
  font-family: Georgia, serif;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.itd-day-unit {
  margin-left: 6rpx;
  color: #8AA3B5;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.itd-day-info { flex: 1; }

.itd-day-date { color: #0B3C5D; font-size: 24rpx; font-weight: 600; }

.itd-day-stay {
  display: inline-block;
  margin-top: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: #EAF4F9;
  color: #1567A8;
  font-size: 21rpx;
}

.itd-entry {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 22rpx;
}

.itd-entry-period {
  position: relative;
  flex-shrink: 0;
  width: 92rpx;
  margin-right: 20rpx;
  padding-top: 4rpx;
  color: #1567A8;
  font-size: 24rpx;
  font-weight: 600;
}

.itd-entry-period::after {
  content: '';
  position: absolute;
  right: -15rpx;
  top: 10rpx;
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 50%;
  background: #1567A8;
  box-shadow: 0 0 0 3rpx #C6A15B;
}

.itd-entry-body { flex: 1; min-width: 0; }

.itd-entry-title {
  display: block;
  color: #284D66;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.65;
  white-space: pre-line;
}

.itd-entry-text {
  display: block;
  margin-top: 8rpx;
  color: #5B6B7A;
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-line;
}

/* 服务标记 */
.itd-entry-services {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.svc-chip {
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  background: #FBF6EC;
  color: #B08D45;
  font-size: 18rpx;
}

/* 关联景点 */
.itd-entry-spots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 缩略图 + 名称的胶囊卡：点击进入景点详情 */
.spot-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  max-width: 100%;
  padding: 8rpx 18rpx 8rpx 8rpx;
  border: 1rpx solid #BBD8EA;
  border-radius: 30rpx;
  background: #EAF4F9;
  color: #1567A8;
  font-size: 23rpx;
}

.spot-chip-press {
  background: #D8EAF5;
}

.spot-chip-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #FFFFFF;
}

.spot-chip-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.spot-chip-arrow {
  font-family: Georgia, serif;
  flex-shrink: 0;
}

/* 服务须知 */
.itd-notices { padding-bottom: 26rpx; }

.itd-notice-group { margin-top: 24rpx; }

.itd-notice-title {
  color: #0B3C5D;
  font-size: 24rpx;
  font-weight: 600;
}

.itd-notice-item {
  display: flex;
  margin-top: 10rpx;
  color: #5B6B7A;
  font-size: 24rpx;
  line-height: 1.75;
}

.itd-notice-item text {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: #C6A15B;
}

/* CTA */
.itd-cta {
  display: flex;
  align-items: center;
}

.itd-cta-kicker {
  color: #C6A15B;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.itd-cta-title { margin-top: 8rpx; color: #0B3C5D; font-size: 28rpx; }

.itd-cta-copy {
  max-width: 540rpx;
  margin-top: 6rpx;
  color: #8AA3B5;
  font-size: 22rpx;
  line-height: 1.7;
}

.itd-cta-arrow {
  margin-left: auto;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 34rpx;
}

.itd-footer {
  margin: 56rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid #DCE8ED;
  color: #8AA3B5;
  font-size: 21rpx;
  text-align: center;
}
