/* ============ P2 行程资讯咨询页 ============ */
.page {
  padding: 0 32rpx var(--tabbar-safe-bottom);
}

/* ===== 深蓝引导横幅 ===== */
.banner {
  margin: 0 -32rpx;
  background: linear-gradient(150deg, #0B3C5D 0%, #1567A8 78%, #1E7BC0 100%);
  color: #FFFFFF;
  padding-bottom: 56rpx;
  overflow: hidden;
  position: relative;
}

/* 波纹装饰 */
.banner::after {
  content: '';
  position: absolute;
  right: -80rpx;
  top: 30rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 0 0 60rpx rgba(255, 255, 255, 0.05), 0 0 0 120rpx rgba(255, 255, 255, 0.03);
}

.banner-inner {
  position: relative;
  padding: 24rpx 40rpx 0;
  z-index: 1;
}

.banner-en {
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 6rpx;
}

.banner-title {
  margin-top: 12rpx;
  font-size: 44rpx;
  letter-spacing: 2rpx;
}

.banner-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 1rpx;
}

/* ===== 表单卡片 ===== */
.form {
  margin-top: -36rpx;
  position: relative;
  z-index: 2;
  padding: 8rpx 32rpx;
}

.form-section-label {
  padding: 22rpx 0 2rpx;
  color: var(--c-gold);
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.form-section-label-spaced {
  margin-top: 12rpx;
  border-top: 1rpx solid var(--c-line);
}

.field {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #EEF3F7;
}

.field-last {
  border-bottom: none;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 16rpx;
}

.req {
  color: #D65A5A;
}

.hint {
  font-weight: 400;
  font-size: 22rpx;
  color: var(--c-weak);
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #F4F7FA;
  font-size: 28rpx;
  color: var(--c-text);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ph {
  overflow: hidden;
  color: var(--c-weak);
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  color: var(--c-weak);
  font-size: 30rpx;
  transform: rotate(90deg);
  display: inline-block;
}

.field-textarea {
  width: auto;
  min-height: 180rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  background: #F4F7FA;
  font-size: 30rpx;
  color: var(--c-text);
  line-height: 1.6;
}

/* 旅行主题多选 */
.theme-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.theme-chip {
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  background: #F4F7FA;
  font-size: 28rpx;
  color: var(--c-sub);
  border: 2rpx solid #E1E9F0;
  transition: all 0.2s;
}

.theme-chip-on {
  background: rgba(21, 103, 168, 0.08);
  border-color: var(--c-primary);
  color: var(--c-primary);
  font-weight: 600;
}

/* 合规说明 */
.compliance-note {
  margin: 26rpx 12rpx 0;
  color: var(--c-weak);
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}

/* ===== 主 CTA ===== */
.cta-wrap {
  margin-top: 36rpx;
}

.cta-wrap .btn-primary {
  width: 100%;
}

/* ===== 中文顾问微信卡片 ===== */
.consultant {
  margin-top: 40rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  border: 1rpx solid rgba(21, 103, 168, 0.08);
  box-shadow: 0 18rpx 44rpx rgba(11, 60, 93, 0.08);
}

.consultant::after {
  content: '';
  position: absolute;
  right: -110rpx;
  top: -150rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(211, 170, 91, 0.16);
  box-shadow: 0 0 0 36rpx rgba(211, 170, 91, 0.05);
  pointer-events: none;
}

.consultant-top {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.consultant-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid #EAF1F7;
}

.consultant-info {
  min-width: 0;
}

.consultant-name {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 600;
  color: var(--c-text);
}

.consultant-title {
  margin-top: 5rpx;
  color: var(--c-primary);
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.consultant-slogan {
  margin-top: 9rpx;
  font-size: 24rpx;
  color: var(--c-sub);
}

.consultant-wechat {
  margin-top: 13rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #F2F7FA;
  font-size: 24rpx;
  color: var(--c-primary);
  line-height: 1.45;
}

.consultant-qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.qr-img {
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  border: 6rpx solid #FFFFFF;
  background: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(11, 60, 93, 0.12);
}

.qr-tip {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--c-weak);
}

/* ===== 电话辅助 ===== */
.phone-row {
  margin-top: 20rpx;
  margin-bottom: 180rpx;
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--c-sub);
  padding: 20rpx 12rpx 0;
  border-top: 1rpx solid var(--c-line);
}

.phone-row > text:first-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.phone-arrow {
  flex-shrink: 0;
  color: var(--c-primary);
  font-weight: 600;
}

/* ===== 定制行程链接说明卡 ===== */
.trip-link {
  margin-top: 28rpx;
  padding: 28rpx;
}

.trip-link-kicker {
  color: var(--c-gold);
}

.trip-link-title {
  margin-top: 10rpx;
  color: var(--c-deep);
  font-size: 32rpx;
}

.trip-link-flow {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
}

.flow-step {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.flow-no {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #EAF4F9;
  color: var(--c-primary);
  font-family: Georgia, serif;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.flow-name {
  margin-top: 12rpx;
  color: var(--c-deep);
  font-size: 21rpx;
  font-weight: 600;
}

.flow-desc {
  margin-top: 4rpx;
  color: var(--c-weak);
  font-size: 20rpx;
  line-height: 1.5;
}

.flow-arrow {
  align-self: center;
  margin: 0 8rpx;
  color: var(--c-weak);
  font-family: Georgia, serif;
  font-size: 30rpx;
}

.trip-link-sample {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #F4F7FA;
}

.trip-link-img {
  flex-shrink: 0;
  width: 108rpx;
  height: 82rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
}

.trip-link-info { flex: 1; min-width: 0; }

.trip-link-name {
  color: var(--c-deep);
  font-size: 23rpx;
  font-weight: 600;
}

.trip-link-copy {
  margin-top: 4rpx;
  color: var(--c-weak);
  font-size: 20rpx;
}

.trip-link-arrow {
  margin-left: 12rpx;
  color: var(--c-weak);
  font-family: Georgia, serif;
  font-size: 32rpx;
}
