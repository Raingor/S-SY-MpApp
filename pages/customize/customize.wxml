<view class="page">

  <!-- ===== 深蓝引导横幅 ===== -->
  <view class="banner">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="banner-inner">
      <view class="eyebrow banner-en">TELL US YOUR PLAN</view>
      <view class="banner-title serif">{{i18n.forms.planIntro}}</view>
      <view class="banner-sub">{{i18n.forms.planSub}}</view>
    </view>
  </view>

  <!-- ===== 留资表单 ===== -->
  <view class="form card">
    <view class="form-section-label">{{i18n.forms.formOverview}}</view>
    <!-- 出行目的地 -->
    <view class="field">
      <view class="field-label">{{i18n.forms.destination}} <text class="req">*</text></view>
      <input
        class="field-input"
        placeholder="{{i18n.forms.destinationPlaceholder}}"
        placeholder-class="ph"
        value="{{form.destination}}"
        data-field="destination"
        bindinput="onInput"
      />
    </view>

    <!-- 出行时间 -->
    <view class="field">
      <view class="field-label">{{i18n.forms.travelDate}}</view>
      <picker mode="date" start="2026-09-14" bindchange="onDateChange">
        <view class="field-input {{form.date ? '' : 'ph'}}">
          {{form.date || i18n.forms.chooseDate}}
        </view>
      </picker>
    </view>

    <!-- 出行天数 -->
    <view class="field">
      <view class="field-label">{{i18n.forms.travelDays}}</view>
      <picker range="{{daysOptions}}" bindchange="onPickerChange" data-field="days" data-options="daysOptions">
        <view class="field-input {{form.days ? '' : 'ph'}}">
          {{form.days || i18n.forms.choosePeriod}}<text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 出行人数 -->
    <view class="field">
      <view class="field-label">{{i18n.forms.travelers}}</view>
      <picker range="{{peopleOptions}}" bindchange="onPickerChange" data-field="people" data-options="peopleOptions">
        <view class="field-input {{form.people ? '' : 'ph'}}">
          {{form.people || i18n.forms.chooseTravelers}}<text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 儿童年龄 -->
    <view class="field">
      <view class="field-label">{{i18n.forms.childAge}} <text class="hint">{{i18n.forms.childAgeHint}}</text></view>
      <input
        class="field-input"
        placeholder="{{i18n.forms.childAgePlaceholder}}"
        placeholder-class="ph"
        value="{{form.childAge}}"
        data-field="childAge"
        bindinput="onInput"
      />
    </view>

    <!-- 单日车程上限 -->
    <view class="field">
      <view class="field-label">{{i18n.forms.carDistance}}</view>
      <picker range="{{carDistanceOptions}}" bindchange="onPickerChange" data-field="carDistance" data-options="carDistanceOptions">
        <view class="field-input {{form.carDistance ? '' : 'ph'}}">
          {{form.carDistance || i18n.forms.chooseDistance}}<text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 人均预算 -->
    <view class="field">
      <view class="field-label">{{i18n.forms.budget}}</view>
      <picker range="{{budgetOptions}}" bindchange="onPickerChange" data-field="budget" data-options="budgetOptions">
        <view class="field-input {{form.budget ? '' : 'ph'}}">
          {{form.budget || i18n.forms.chooseBudget}}<text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 旅行主题（多选） -->
    <view class="form-section-label form-section-label-spaced">{{i18n.forms.formPreferences}}</view>
    <view class="field">
      <view class="field-label">{{i18n.forms.theme}} <text class="hint">{{i18n.forms.multiSelect}}</text></view>
      <view class="theme-wrap">
        <view
          class="theme-chip {{form.themes.includes(item) ? 'theme-chip-on' : ''}}"
          wx:for="{{themes}}"
          wx:key="*this"
          data-theme="{{item}}"
          bindtap="onThemeToggle"
        >{{item}}</view>
      </view>
    </view>

    <!-- 需求描述 -->
    <view class="form-section-label form-section-label-spaced">{{i18n.forms.formContact}}</view>
    <view class="field">
      <view class="field-label">{{i18n.forms.requirements}}</view>
      <textarea
        class="field-textarea"
        placeholder="{{i18n.forms.requirementsPlaceholder}}"
        placeholder-class="ph"
        maxlength="300"
        value="{{form.desc}}"
        data-field="desc"
        bindinput="onInput"
      ></textarea>
    </view>

    <!-- 联系电话 -->
    <view class="field field-last">
      <view class="field-label">{{i18n.forms.phone}} <text class="req">*</text></view>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        placeholder="{{i18n.forms.phonePlaceholder}}"
        placeholder-class="ph"
        value="{{form.phone}}"
        data-field="phone"
        bindinput="onInput"
      />
    </view>
  </view>

  <view class="compliance-note">{{i18n.forms.compliance}}</view>

  <!-- 主 CTA（页面唯一） -->
  <view class="cta-wrap">
    <button class="btn-primary" hover-class="btn-primary-hover" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? i18n.submitting : i18n.forms.submitConsultation}}
    </button>
  </view>

  <!-- ===== 定制行程链接说明 ===== -->
  <view class="trip-link card">
    <view class="trip-link-head">
      <view class="eyebrow trip-link-kicker">YOUR CUSTOM ITINERARY</view>
      <view class="trip-link-title serif">{{i18n.forms.afterSubmitTitle}}</view>
    </view>
    <view class="trip-link-flow">
      <view class="flow-step">
        <view class="flow-no">1</view>
        <view class="flow-name">{{i18n.forms.flowStep1}}</view>
        <view class="flow-desc">{{i18n.forms.flowDesc1}}</view>
      </view>
      <view class="flow-arrow">›</view>
      <view class="flow-step">
        <view class="flow-no">2</view>
        <view class="flow-name">{{i18n.forms.flowStep2}}</view>
        <view class="flow-desc">{{i18n.forms.flowDesc2}}</view>
      </view>
      <view class="flow-arrow">›</view>
      <view class="flow-step">
        <view class="flow-no">3</view>
        <view class="flow-name">{{i18n.forms.flowStep3}}</view>
        <view class="flow-desc">{{i18n.forms.flowDesc3}}</view>
      </view>
    </view>
    <view class="trip-link-sample" bindtap="onViewSampleTrip">
      <image class="trip-link-img" src="/assets/images/hero/hero-santorini.jpg" mode="aspectFill" />
      <view class="trip-link-info">
        <view class="trip-link-name">{{i18n.forms.sampleTripTitle}}</view>
        <view class="trip-link-copy">{{i18n.forms.sampleTripDesc}}</view>
      </view>
      <view class="trip-link-arrow">›</view>
    </view>
  </view>

  <!-- ===== 中文顾问微信卡片（第二咨询通道） ===== -->
  <view class="consultant card">
    <view class="consultant-top" bindtap="onCopyWechat">
      <image class="consultant-avatar" src="{{consultant.avatar}}" mode="aspectFill" />
      <view class="consultant-info">
        <view class="consultant-name">{{i18n.forms.consultantTitle}} · {{consultant.name}}</view>
        <view class="consultant-title">{{consultant.title}}</view>
        <view class="consultant-slogan">{{consultant.slogan}}</view>
        <view class="consultant-wechat">{{i18n.forms.wechatId}}：{{consultant.wechat}}（{{i18n.forms.tapToCopy}}）</view>
      </view>
    </view>
    <view class="consultant-qr" bindtap="onPreviewQr">
      <image class="qr-img" src="{{consultant.qr}}" mode="aspectFit" />
      <view class="qr-tip">{{i18n.forms.qrTip}}</view>
    </view>
  </view>

  <!-- 电话辅助 -->
  <view class="phone-row" bindtap="onCallPhone">
    <text>{{i18n.forms.phone}}：{{consultant.phone}}</text>
    <text class="phone-arrow">{{i18n.forms.call}} ›</text>
  </view>

</view>
