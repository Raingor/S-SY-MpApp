<view class="page">

  <!-- ===== 渐变头部 ===== -->
  <view class="head">
    <view style="height: {{statusBarHeight + 8}}px;"></view>
    <view class="head-inner">
      <view wx:if="{{loggedIn}}">
        <view class="head-row">
          <view class="avatar-picker" bindtap="onAvatarTap" hover-class="avatar-picker-hover" aria-label="更换头像">
            <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
            <view class="avatar-edit-badge">{{avatarUploading ? i18n.profile.avatarUploading : i18n.profile.avatarChange}}</view>
          </view>
          <view class="head-info">
            <view class="nick-row">
              <text class="nick">{{user.nickname}}</text>
              <view wx:if="{{user.member}}" class="member-badge">✦ {{user.member}}</view>
              <text class="edit-profile" bindtap="onEditProfile">{{i18n.profile.change}}</text>
            </view>
            <view class="verified">{{phoneBound ? i18n.profile.phoneBound : i18n.profile.phoneRequired}}</view>
          </view>
        </view>

        <!-- 数据行 -->
        <view class="stats">
          <view class="stat" wx:for="{{stats}}" wx:key="label">
            <view class="stat-value">{{item.value}}</view>
            <view class="stat-label">{{item.label}}</view>
          </view>
        </view>
      </view>

      <view wx:else class="login-prompt">
        <view class="login-title">{{i18n.profile.login}}</view>
        <view class="login-desc">{{i18n.profile.loginDesc}}</view>
        <button class="login-button" bindtap="onWechatLogin" loading="{{authLoading}}" disabled="{{authLoading}}">{{i18n.profile.wechatLogin}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{loggedIn}}" class="phone-bind-card card">
    <view class="phone-bind-copy">
      <view class="phone-bind-title">{{phoneBound ? i18n.profile.changePhone : i18n.profile.bindPhone}}</view>
      <view class="phone-bind-desc">{{phoneBound ? i18n.profile.changePhoneDesc : i18n.profile.bindPhoneDesc}}</view>
    </view>
    <button class="bind-button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{authLoading}}" disabled="{{authLoading}}">{{phoneBound ? i18n.profile.reauthorize : i18n.profile.bind}}</button>
  </view>

  <view wx:if="{{loggedIn}}" class="knowledge-member-card card">
    <view class="knowledge-member-top"><view><view class="eyebrow">KNOWLEDGE MEMBERSHIP</view><view class="knowledge-member-title serif">{{memberStatus || i18n.paidContent.member}}</view><view class="knowledge-member-desc">{{memberStatus ? i18n.paidContent.memberUnlocked : i18n.paidContent.memberDesc}}</view></view><view class="knowledge-member-mark">✦</view></view>
    <view class="knowledge-stats"><view><text>{{purchasedCount}}</text><label>{{i18n.paidContent.purchased}}</label></view><view><text>{{favoriteCount}}</text><label>{{i18n.profileDetail.favorites || '收藏'}}</label></view><view><text>{{liveBookingCount}}</text><label>{{i18n.liveBooking.title}}</label></view><view><text>{{historyCount}}</text><label>{{i18n.profileDetail.history || '观看历史'}}</label></view></view>
    <button class="knowledge-member-action" bindtap="onKnowledgeTap">{{memberStatus ? i18n.paidContent.memberUnlocked : i18n.paidContent.member}}</button>
  </view>

  <!-- ===== 服务单元格卡 ===== -->
  <view class="panel card">
    <view class="panel-heading">
      <view class="panel-heading-en eyebrow">MY JOURNEY</view>
      <view class="panel-heading-title serif">{{i18n.profile.myJourney}}</view>
    </view>
    <view
      class="cell"
      hover-class="cell-press"
      wx:for="{{services}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onServiceTap"
    >
      <view class="cell-icon cell-icon-{{item.key}}">
        <!-- 订单 -->
        <view wx:if="{{item.key === 'orders'}}" class="i-order">
          <view class="i-order-line l1"></view>
          <view class="i-order-line l2"></view>
        </view>
        <!-- 行程 -->
        <view wx:elif="{{item.key === 'trips'}}" class="i-trip">
          <view class="i-trip-pin"></view>
          <view class="i-trip-line"></view>
        </view>
        <!-- 优惠券 -->
        <view wx:else class="i-coupon">
          <view class="i-coupon-body"></view>
          <view class="i-coupon-hole h1"></view>
          <view class="i-coupon-hole h2"></view>
        </view>
      </view>
      <view class="cell-label">{{item.label}}</view>
      <view wx:if="{{item.badge}}" class="cell-badge">{{item.badge}}</view>
      <view class="cell-arrow">›</view>
    </view>
  </view>

  <!-- ===== 资料与帮助卡 ===== -->
  <view class="panel card">
    <view class="panel-heading">
      <view class="panel-heading-en eyebrow">PROFILE &amp; HELP</view>
      <view class="panel-heading-title serif">{{i18n.profile.profileHelp}}</view>
    </view>
    <view
      class="cell"
      hover-class="cell-press"
      wx:for="{{helps}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onHelpTap"
    >
      <view class="cell-dot dot-{{item.key}}"></view>
      <view class="cell-label">{{item.label}}</view>
      <view class="cell-arrow">›</view>
    </view>
  </view>

  <view class="panel card language-panel">
    <view class="panel-heading">
      <view class="panel-heading-en eyebrow">LANGUAGE</view>
      <view class="panel-heading-title serif">{{i18n.language}}</view>
    </view>
    <view class="language-hint">{{i18n.languageHint}}</view>
    <view class="language-options">
      <view wx:for="{{languageOptions}}" wx:key="value" class="language-option {{locale === item.value ? 'language-option-on' : ''}}" data-locale="{{item.value}}" bindtap="onLanguageTap">{{item.label}}</view>
    </view>
  </view>

  <!-- 品牌署名 -->
  <view class="foot-brand">
    <view class="foot-en eyebrow">{{i18n.brandEn}}</view>
    <view class="foot-site">sy-greece.com</view>
    <view class="foot-slogan">{{i18n.commonSlogan}}</view>
  </view>

</view>
