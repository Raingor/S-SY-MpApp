<view class="page">

  <!-- ===== 渐变头部 ===== -->
  <view class="head">
    <view style="height: {{statusBarHeight + 8}}px;"></view>
    <view class="head-inner">
      <view wx:if="{{loggedIn}}">
        <view class="head-row">
          <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
          <view class="head-info">
            <view class="nick-row">
              <text class="nick">{{user.nickname}}</text>
              <view wx:if="{{user.member}}" class="member-badge">✦ {{user.member}}</view>
              <text class="edit-profile" bindtap="onEditProfile">修改</text>
            </view>
            <view class="verified">{{phoneBound ? '已绑定手机号' : '请绑定手机号后预约服务'}}</view>
          </view>
        </view>

        <!-- 数据行 -->
        <view class="stats">
          <view class="stat" wx:for="{{stats}}" wx:key="label">
            <view class="stat-value">{{item.value}}</view>
            <view class="stat-label">{{item.label}}</view>
          </view>
        </view>
      </view>

      <view wx:else class="login-prompt">
        <view class="login-title">登录 SY 希腊蔚蓝海岸</view>
        <view class="login-desc">微信登录后，绑定手机号即可预约服务</view>
        <button class="login-button" bindtap="onWechatLogin" loading="{{authLoading}}" disabled="{{authLoading}}">微信登录</button>
      </view>
    </view>
  </view>

  <view wx:if="{{loggedIn && !phoneBound}}" class="phone-bind-card card">
    <view class="phone-bind-copy">
      <view class="phone-bind-title">完成手机号绑定</view>
      <view class="phone-bind-desc">预约或提交咨询前，需要先绑定手机号</view>
    </view>
    <button class="bind-button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{authLoading}}" disabled="{{authLoading}}">绑定手机号</button>
  </view>

  <!-- ===== 服务单元格卡 ===== -->
  <view class="panel card">
    <view
      class="cell"
      wx:for="{{services}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onServiceTap"
    >
      <view class="cell-icon cell-icon-{{item.key}}">
        <!-- 订单 -->
        <view wx:if="{{item.key === 'orders'}}" class="i-order">
          <view class="i-order-line l1"></view>
          <view class="i-order-line l2"></view>
        </view>
        <!-- 行程 -->
        <view wx:elif="{{item.key === 'trips'}}" class="i-trip">
          <view class="i-trip-pin"></view>
          <view class="i-trip-line"></view>
        </view>
        <!-- 优惠券 -->
        <view wx:else class="i-coupon">
          <view class="i-coupon-body"></view>
          <view class="i-coupon-hole h1"></view>
          <view class="i-coupon-hole h2"></view>
        </view>
      </view>
      <view class="cell-label">{{item.label}}</view>
      <view wx:if="{{item.badge}}" class="cell-badge">{{item.badge}}</view>
      <view class="cell-arrow">›</view>
    </view>
  </view>

  <!-- ===== 资料与帮助卡 ===== -->
  <view class="panel card">
    <view
      class="cell"
      wx:for="{{helps}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onHelpTap"
    >
      <view class="cell-dot dot-{{item.key}}"></view>
      <view class="cell-label">{{item.label}}</view>
      <view class="cell-arrow">›</view>
    </view>
  </view>

  <!-- 品牌署名 -->
  <view class="foot-brand">
    <view class="foot-en eyebrow">GREECE BLUE COAST</view>
    <view class="foot-site">sy-greece.com</view>
    <view class="foot-slogan">只为一生美好回忆</view>
  </view>

</view>
