.page {
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
  box-sizing: border-box;
  background: var(--c-bg);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
}

.title {
  color: var(--c-deep);
  font-size: 36rpx;
  font-weight: 600;
}

.topbar-space {
  width: 72rpx;
}

.content {
  padding-bottom: 40rpx;
}

.state {
  padding: 100rpx 0;
  color: var(--c-sub);
  font-size: 29rpx;
  text-align: center;
}

.card {
  background: var(--c-card);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 28rpx rgba(11, 60, 93, 0.08);
}

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 28rpx 34rpx;
}

.avatar {
  width: 148rpx;
  height: 148rpx;
  border: 5rpx solid #DCEAF4;
  border-radius: 50%;
  background: #EAF3F8;
}

.avatar-picker {
  position: relative;
  display: block;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  line-height: 1;
  overflow: visible;
}

.avatar-picker-trigger {
  position: absolute;
  z-index: 2;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
}

.avatar-picker-trigger::after {
  border: 0;
}

.avatar-picker .avatar {
  display: block;
}

.avatar-picker-hover {
  opacity: 0.78;
}

.avatar-edit-badge {
  position: absolute;
  right: -12rpx;
  bottom: 0;
  padding: 6rpx 12rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 18rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 1;
  white-space: nowrap;
}

.avatar-note,
.field-note {
  color: var(--c-weak);
  font-size: 25rpx;
}

.avatar-note {
  margin-top: 18rpx;
}

.avatar-source-button {
  margin: 12rpx 0 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--c-primary);
  font-size: 24rpx;
  line-height: 1.5;
}

.avatar-source-button::after {
  border: 0;
}

.form {
  margin-top: 24rpx;
  padding: 8rpx 28rpx 30rpx;
}

.field {
  padding: 26rpx 0;
  border-bottom: 2rpx solid #EEF3F7;
}

.field-last {
  border-bottom: none;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--c-text);
  font-size: 28rpx;
  font-weight: 600;
}

.input,
.readonly {
  width: 100%;
  min-height: 52rpx;
  box-sizing: border-box;
  color: var(--c-text);
  font-size: 30rpx;
  line-height: 52rpx;
}

.input::placeholder {
  color: var(--c-weak);
}

.readonly {
  color: var(--c-sub);
}

.phone-edit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.phone-edit-row .readonly {
  flex: 1;
  min-width: 0;
}

.rebind-button {
  flex-shrink: 0;
  margin: 0;
  padding: 0 18rpx;
  height: 54rpx;
  border: 1rpx solid var(--c-primary);
  border-radius: 28rpx;
  background: transparent;
  color: var(--c-primary);
  font-size: 22rpx;
  line-height: 52rpx;
}

.rebind-button::after {
  border: none;
}

.field-note {
  margin-top: 12rpx;
  line-height: 1.5;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border: none;
  border-radius: 38rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 27rpx;
  line-height: 1;
}

.save-button::after {
  border: none;
}
