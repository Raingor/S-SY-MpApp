/* ============ P3 我的页面 ============ */
.page {
  padding: 0 32rpx var(--tabbar-safe-bottom);
}

/* ===== 渐变头部 ===== */
.head {
  margin: 0 -32rpx;
  background: linear-gradient(160deg, #0B3C5D 0%, #1567A8 70%, #1E7BC0 100%);
  padding-bottom: 72rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆环 */
.head::after {
  content: '';
  position: absolute;
  right: -100rpx;
  top: -60rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 0 70rpx rgba(255, 255, 255, 0.04);
}

.head-inner {
  position: relative;
  z-index: 1;
  padding: 24rpx 40rpx 0;
}

.head-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 8rpx;
  color: #FFFFFF;
}

.login-title {
  font-size: 34rpx;
  font-weight: 600;
}

.login-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.75);
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 72rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border: none;
  border-radius: 36rpx;
  background: #FFFFFF;
  color: var(--c-primary);
  font-size: 26rpx;
  line-height: 1;
}

.login-button::after,
.bind-button::after {
  border: none;
}

.phone-bind-card {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
}

.phone-bind-copy {
  min-width: 0;
  flex: 1;
}

.phone-bind-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}

.phone-bind-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-sub);
}

.bind-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0;
  padding: 0 22rpx;
  height: 64rpx;
  border: none;
  border-radius: 32rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 23rpx;
  line-height: 1;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.35);
  flex-shrink: 0;
}

.avatar-picker {
  position: relative;
  display: block;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  line-height: 1;
  overflow: visible;
}

.avatar-picker .avatar {
  display: block;
}

.avatar-picker-hover {
  opacity: 0.78;
}

.avatar-edit-badge {
  position: absolute;
  right: -8rpx;
  bottom: -2rpx;
  padding: 6rpx 10rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 18rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 1;
  white-space: nowrap;
}

.head-info {
  color: #FFFFFF;
}

.language-panel {
  padding-bottom: 28rpx;
}

.language-hint {
  margin: -8rpx 28rpx 18rpx;
  color: var(--c-weak);
  font-size: 22rpx;
}

.language-options {
  display: flex;
  gap: 14rpx;
  padding: 0 28rpx;
}

.language-option {
  flex: 1;
  padding: 16rpx 8rpx;
  border: 1rpx solid #DDE7EE;
  border-radius: 18rpx;
  color: var(--c-sub);
  font-size: 22rpx;
  text-align: center;
  background: #FFFFFF;
}

.language-option-on {
  border-color: var(--c-primary);
  color: var(--c-primary);
  background: #EEF6FB;
  font-weight: 600;
}

.nick-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.nick {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.edit-profile {
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 21rpx;
}

/* 沙金会员标 */
.member-badge {
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #D8B878, #C6A15B);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 14rpx rgba(198, 161, 91, 0.4);
}

.verified {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 1rpx;
}

/* 数据行 */
.stats {
  margin-top: 40rpx;
  display: flex;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10rpx);
  border-radius: 28rpx;
  padding: 26rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-right: 2rpx solid rgba(255, 255, 255, 0.15);
}

.stat:last-child {
  border-right: none;
}

.stat-value {
  font-family: 'Inter', sans-serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.stat-label {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ===== 单元格卡 ===== */
.panel {
  margin-top: 32rpx;
  padding: 0 32rpx 8rpx;
}

.panel-heading {
  padding: 26rpx 0 10rpx;
}

.panel-heading-en {
  color: var(--c-gold);
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.panel-heading-title {
  margin-top: 4rpx;
  color: var(--c-deep);
  font-size: 28rpx;
}

.cell {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #EEF3F7;
}

.cell-press {
  opacity: 0.72;
  transform: translateX(4rpx);
}

.cell:last-child {
  border-bottom: none;
}

.cell-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.cell-icon-orders { background: linear-gradient(140deg, #E3F2FC, #CDE6F8); }
.cell-icon-trips { background: linear-gradient(140deg, #E8F3EC, #D9EBDF); }
.cell-icon-coupons { background: linear-gradient(140deg, #FBF3E3, #F3E5CB); }

.cell-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--c-text);
}

.cell-badge {
  font-size: 22rpx;
  color: var(--c-primary);
  background: rgba(21, 103, 168, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
  margin-right: 12rpx;
}

.cell-arrow {
  color: var(--c-weak);
  font-size: 32rpx;
}

/* 图标：订单 */
.i-order { position: relative; width: 40rpx; height: 44rpx; }
.i-order-line {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  height: 6rpx;
  border-radius: 3rpx;
  background: #1567A8;
}
.i-order-line.l1 { top: 8rpx; width: 34rpx; }
.i-order-line.l2 { top: 24rpx; width: 22rpx; }

/* 图标：行程（定位点+虚线） */
.i-trip { position: relative; width: 40rpx; height: 44rpx; }
.i-trip-pin {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 18rpx;
  border-radius: 50% 50% 50% 0;
  background: #2E7D5B;
  transform: translateX(-50%) rotate(45deg);
}
.i-trip-line {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 16rpx;
  background: #2E7D5B;
  border-radius: 2rpx;
}

/* 图标：优惠券 */
.i-coupon { position: relative; width: 44rpx; height: 34rpx; }
.i-coupon-body {
  width: 44rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: #C6A15B;
  position: relative;
}
.i-coupon-hole {
  position: absolute;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #F3E5CB;
  transform: translateY(-50%);
}
.i-coupon-hole.h1 { left: -6rpx; }
.i-coupon-hole.h2 { right: -6rpx; }

/* 帮助卡小圆点 */
.cell-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.dot-travelers { background: #1567A8; }
.dot-visa { background: #2E7D5B; }
.dot-service { background: #C6A15B; }
.dot-about { background: #8AA3B5; }

/* ===== 品牌署名 ===== */
.foot-brand {
  margin-top: 56rpx;
  padding-bottom: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.foot-site {
  font-family: 'Inter', sans-serif;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-primary);
  letter-spacing: 2rpx;
}

.foot-slogan {
  margin-top: 8rpx;
  color: var(--c-weak);
  font-size: 25rpx;
  letter-spacing: 1rpx;
}
