/* 出行人编辑页 */
.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  box-sizing: border-box;
  background: var(--c-bg);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--c-deep);
}

.topbar-space {
  width: 72rpx;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--c-sub);
  font-size: 29rpx;
}

.form {
  padding: 8rpx 0 28rpx;
}

.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #EEF3F7;
}

.field-last {
  border-bottom: none;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--c-text);
  font-size: 27rpx;
  font-weight: 600;
}

.required {
  color: #C75D5D;
}

.input {
  width: 100%;
  min-height: 48rpx;
  color: var(--c-text);
  font-size: 29rpx;
}

.input::placeholder {
  color: var(--c-weak);
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin-top: 32rpx;
  padding: 0;
  border: none;
  border-radius: 38rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.save-button::after {
  border: none;
}

.privacy-note {
  margin-top: 20rpx;
  color: var(--c-weak);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}
