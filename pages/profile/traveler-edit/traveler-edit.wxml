<!-- 出行人/护照签证资料编辑页 -->
<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar">
    <view class="back sy-back-button sy-back-button-light" bindtap="onBack" hover-class="sy-back-button-light-hover" aria-label="返回上一页">
      <view class="sy-back-chevron"></view>
    </view>
    <text class="title">{{itemId ? (type === 'travelers' ? '编辑出行人' : '编辑资料') : (type === 'travelers' ? '添加出行人' : '添加资料')}}</text>
    <view class="topbar-space"></view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:else class="content">
    <view class="form card">
      <view class="field">
        <view class="field-label">姓名或称呼 <text class="required">*</text></view>
        <input class="input" placeholder="例如：张先生 / 小朋友" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="40" />
      </view>
      <view wx:if="{{type === 'travelers'}}" class="field">
        <view class="field-label">与本人关系</view>
        <input class="input" placeholder="例如：本人 / 配偶 / 子女" value="{{form.relation}}" data-field="relation" bindinput="onInput" maxlength="20" />
      </view>
      <view class="field {{type === 'travelers' ? 'field-last' : ''}}">
        <view class="field-label">护照号码</view>
        <input class="input" placeholder="选填，便于顾问核对签证信息" value="{{form.passportNo}}" data-field="passportNo" bindinput="onInput" maxlength="20" />
      </view>
      <block wx:if="{{type === 'visa'}}">
        <view class="field">
          <view class="field-label">护照有效期</view>
          <input class="input" placeholder="例如：2030-06-30" value="{{form.expiry}}" data-field="expiry" bindinput="onInput" maxlength="20" />
        </view>
        <view class="field field-last">
          <view class="field-label">签证备注</view>
          <input class="input" placeholder="例如：已持申根签 / 待确认" value="{{form.visaStatus}}" data-field="visaStatus" bindinput="onInput" maxlength="40" />
        </view>
      </block>
      <button class="save-button" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存</button>
    </view>

    <view class="privacy-note">资料由服务端按当前微信账号隔离保存，仅用于后续服务沟通。</view>
  </view>
</view>
