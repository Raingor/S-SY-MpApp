<!-- 出行人/护照签证资料编辑页 -->
<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar">
    <view class="back sy-back-button sy-back-button-light" bindtap="onBack" hover-class="sy-back-button-light-hover" aria-label="{{i18n.back}}">
      <view class="sy-back-chevron"></view>
    </view>
    <text class="title">{{itemId ? (type === 'travelers' ? i18n.travelerEdit.editTraveler : i18n.travelerEdit.editDocument) : (type === 'travelers' ? i18n.travelerEdit.addTraveler : i18n.travelerEdit.addDocument)}}</text>
    <view class="topbar-space"></view>
  </view>

  <view wx:if="{{loading}}" class="state">{{i18n.travelerEdit.loading}}</view>
  <view wx:else class="content">
    <view class="form card">
      <view class="field">
        <view class="field-label">{{i18n.travelerEdit.name}} <text class="required">*</text></view>
        <input class="input" placeholder="{{i18n.travelerEdit.namePlaceholder}}" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="40" />
      </view>
      <view wx:if="{{type === 'travelers'}}" class="field">
        <view class="field-label">{{i18n.travelerEdit.relation}}</view>
        <input class="input" placeholder="{{i18n.travelerEdit.relationPlaceholder}}" value="{{form.relation}}" data-field="relation" bindinput="onInput" maxlength="20" />
      </view>
      <view class="field {{type === 'travelers' ? 'field-last' : ''}}">
        <view class="field-label">{{i18n.travelerEdit.passport}}</view>
        <input class="input" placeholder="{{i18n.travelerEdit.passportPlaceholder}}" value="{{form.passportNo}}" data-field="passportNo" bindinput="onInput" maxlength="20" />
      </view>
      <block wx:if="{{type === 'visa'}}">
        <view class="field">
          <view class="field-label">{{i18n.travelerEdit.expiry}}</view>
          <input class="input" placeholder="{{i18n.travelerEdit.expiryPlaceholder}}" value="{{form.expiry}}" data-field="expiry" bindinput="onInput" maxlength="20" />
        </view>
        <view class="field field-last">
          <view class="field-label">{{i18n.travelerEdit.visaStatus}}</view>
          <input class="input" placeholder="{{i18n.travelerEdit.visaStatusPlaceholder}}" value="{{form.visaStatus}}" data-field="visaStatus" bindinput="onInput" maxlength="40" />
        </view>
      </block>
      <button class="save-button" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">{{i18n.travelerEdit.save}}</button>
    </view>

    <view class="privacy-note">{{i18n.travelerEdit.privacy}}</view>
  </view>
</view>
