<!-- 出行人编辑页 -->
<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar">
    <text class="back" bindtap="onBack">‹</text>
    <text class="title">{{itemId ? '编辑出行人' : '添加出行人'}}</text>
    <view class="topbar-space"></view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:else class="content">
    <view class="form card">
      <view class="field">
        <view class="field-label">姓名或称呼 <text class="required">*</text></view>
        <input class="input" placeholder="例如：张先生 / 小朋友" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="40" />
      </view>
      <view class="field">
        <view class="field-label">与本人关系</view>
        <input class="input" placeholder="例如：本人 / 配偶 / 子女" value="{{form.relation}}" data-field="relation" bindinput="onInput" maxlength="20" />
      </view>
      <view class="field field-last">
        <view class="field-label">护照号码</view>
        <input class="input" placeholder="选填，便于顾问核对签证信息" value="{{form.passportNo}}" data-field="passportNo" bindinput="onInput" maxlength="20" />
      </view>
      <button class="save-button" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存</button>
    </view>
  </view>
</view>
