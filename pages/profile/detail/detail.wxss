.page {
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--c-deep);
}

.topbar-space {
  width: 72rpx;
}

.content {
  padding-bottom: 40rpx;
}

.state,
.empty {
  text-align: center;
}

.state {
  padding: 80rpx 0;
  color: var(--c-sub);
  font-size: 29rpx;
}

.empty {
  padding: 76rpx 36rpx;
}

.empty-icon {
  color: var(--c-gold);
  font-size: 58rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 14rpx;
  color: var(--c-sub);
  font-size: 26rpx;
  line-height: 1.6;
}

.record-list,
.coupon-list,
.saved-list,
.payment-order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.payment-order {
  padding: 26rpx 28rpx;
}

.payment-order-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.payment-order-mark {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #EEF6FB;
  color: #1567A8;
  font-size: 23rpx;
  font-weight: 700;
}

.payment-order-main {
  min-width: 0;
  flex: 1;
}

.payment-order-title {
  overflow: hidden;
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.payment-order-meta,
.payment-order-time {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--c-weak);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.payment-order-arrow {
  flex-shrink: 0;
  color: #9AAAB6;
  font-size: 36rpx;
}

.payment-order-time {
  margin-left: 66rpx;
  font-size: 21rpx;
}

.payment-detail {
  padding: 30rpx 28rpx;
}

.payment-detail-kicker {
  color: var(--c-gold);
}

.payment-detail-title {
  margin-top: 12rpx;
  color: var(--c-deep);
  font-size: 36rpx;
}

.payment-detail-status {
  display: inline-block;
  margin-top: 16rpx;
  padding: 7rpx 16rpx;
  border-radius: 20rpx;
  background: #E8F5EE;
  color: #2C8C66;
  font-size: 23rpx;
  font-weight: 600;
}

.payment-detail-list {
  margin-top: 24rpx;
  border-top: 1rpx solid #EEF3F7;
}

.payment-detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EEF3F7;
  color: var(--c-sub);
  font-size: 24rpx;
  line-height: 1.45;
}

.payment-detail-row text:last-child {
  min-width: 0;
  color: var(--c-text);
  text-align: right;
  word-break: break-all;
}

.coupon {
  padding: 28rpx;
  border-left: 8rpx solid var(--c-gold);
}

.coupon-title {
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 600;
}

.coupon-desc,
.coupon-expiry {
  margin-top: 12rpx;
  color: var(--c-sub);
  font-size: 26rpx;
}

.coupon-expiry {
  color: var(--c-primary);
  font-size: 24rpx;
}

.record {
  padding: 28rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 600;
}

.record-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(21, 103, 168, 0.1);
  color: var(--c-primary);
  font-size: 24rpx;
}

.record-line,
.record-route {
  margin-top: 16rpx;
  color: var(--c-sub);
  font-size: 26rpx;
}

.record-route {
  padding-top: 16rpx;
  border-top: 2rpx solid #EEF3F7;
  color: var(--c-text);
  line-height: 1.55;
}

.privacy-note {
  margin-bottom: 20rpx;
  color: var(--c-weak);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.form {
  padding: 8rpx 28rpx 28rpx;
}

.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #EEF3F7;
}

.field-last {
  border-bottom: none;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--c-text);
  font-size: 27rpx;
  font-weight: 600;
}

.required {
  color: #C75D5D;
}

.input {
  width: 100%;
  min-height: 48rpx;
  color: var(--c-text);
  font-size: 29rpx;
}

.input::placeholder {
  color: var(--c-weak);
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border: none;
  border-radius: 36rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 1;
}

.save-button::after {
  border: none;
}

.saved-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
}

.saved-main {
  min-width: 0;
  flex: 1;
}

.saved-name {
  color: var(--c-text);
  font-size: 30rpx;
  font-weight: 600;
}

.saved-meta {
  margin-top: 8rpx;
  color: var(--c-sub);
  font-size: 25rpx;
}

.saved-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
  color: var(--c-primary);
  font-size: 25rpx;
  text-align: right;
}

.saved-actions text:last-child {
  color: #B05B5B;
}

/* ===== 列表页：添加按钮卡 ===== */
.list-add {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
}

.list-add-plus {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #EAF4F9;
  color: var(--c-primary);
  font-size: 40rpx;
  font-weight: 600;
}

.list-add-text {
  color: var(--c-primary);
  font-size: 27rpx;
  font-weight: 600;
}

/* 空状态里的添加入口 */
.empty-add {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 36rpx;
  border-radius: 34rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 24rpx;
}
