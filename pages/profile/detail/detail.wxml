<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar">
    <view class="back sy-back-button sy-back-button-light" bindtap="onBack" hover-class="sy-back-button-light-hover" aria-label="{{i18n.back}}">
      <view class="sy-back-chevron"></view>
    </view>
    <text class="title">{{title}}</text>
    <view class="topbar-space"></view>
  </view>

  <view wx:if="{{mode === 'payment-orders'}}" class="content">
    <view wx:if="{{loading}}" class="state">{{i18n.loading}}</view>
    <view wx:elif="{{!items.length}}" class="empty card">
      <view class="empty-icon">¥</view>
      <view class="empty-title">{{empty}}</view>
      <view class="empty-desc">{{i18n.profileDetail.emptyDesc}}</view>
    </view>
    <view wx:else class="payment-order-list">
      <view class="payment-order card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onPaymentOrderTap" hover-class="card-press">
        <view class="payment-order-head">
          <view class="payment-order-mark">¥</view>
          <view class="payment-order-main">
            <view class="payment-order-title">{{item.displayTitle}}</view>
            <view class="payment-order-meta">{{item.displayAmount}} · {{item.displayStatus}}</view>
          </view>
          <view class="payment-order-arrow">›</view>
        </view>
        <view class="payment-order-time">{{i18n.profileDetail.orderCreatedAt}}：{{item.displayCreated}}</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{mode === 'payment-order'}}" class="content">
    <view wx:if="{{loading}}" class="state">{{i18n.loading}}</view>
    <view wx:elif="{{!order}}" class="empty card">
      <view class="empty-icon">¥</view>
      <view class="empty-title">{{empty}}</view>
      <view class="empty-desc">{{i18n.profileDetail.emptyDesc}}</view>
    </view>
    <view wx:else class="payment-detail card">
      <view class="payment-detail-kicker eyebrow">{{i18n.profileDetail.paymentOrderKicker}}</view>
      <view class="payment-detail-title serif">{{order.displayTitle}}</view>
      <view class="payment-detail-status">{{order.displayStatus}}</view>
      <view class="payment-detail-list">
        <view class="payment-detail-row"><text>{{i18n.profileDetail.orderProduct}}</text><text>{{order.displayTitle}}</text></view>
        <view class="payment-detail-row"><text>{{i18n.profileDetail.orderNumber}}</text><text>{{order.id}}</text></view>
        <view wx:if="{{order.outTradeNo}}" class="payment-detail-row"><text>{{i18n.profileDetail.merchantOrderNumber}}</text><text>{{order.outTradeNo}}</text></view>
        <view class="payment-detail-row"><text>{{i18n.profileDetail.orderAmount}}</text><text>{{order.displayAmount}}</text></view>
        <view class="payment-detail-row"><text>{{i18n.profileDetail.orderStatus}}</text><text>{{order.displayStatus}}</text></view>
        <view class="payment-detail-row"><text>{{i18n.profileDetail.orderCreatedAt}}</text><text>{{order.displayCreated}}</text></view>
        <view wx:if="{{order.paidAt}}" class="payment-detail-row"><text>{{i18n.profileDetail.orderPaidAt}}</text><text>{{order.displayPaid}}</text></view>
        <view wx:if="{{order.transactionId}}" class="payment-detail-row"><text>{{i18n.profileDetail.transactionId}}</text><text>{{order.transactionId}}</text></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{mode === 'leads' || mode === 'trips'}}" class="content">
    <view wx:if="{{loading}}" class="state">{{i18n.loading}}</view>
    <view wx:elif="{{!items.length}}" class="empty card">
      <view class="empty-icon">○</view>
      <view class="empty-title">{{empty}}</view>
      <view class="empty-desc">{{i18n.profileDetail.emptyDesc}}</view>
    </view>
    <view wx:else class="record-list">
      <view class="record card" wx:for="{{items}}" wx:key="id">
        <view class="record-head">
          <text class="record-title">{{item.displayTitle}}</text>
          <text class="record-status">{{item.displayStatus}}</text>
        </view>
        <view class="record-line">{{i18n.profileDetail.recordDate}}：{{item.displayDate}}</view>
        <view class="record-line">{{i18n.profileDetail.createdAt}}：{{item.displayCreated}}</view>
        <view class="record-route">{{item.displayRoute}}</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{mode === 'coupons'}}" class="content">
    <view wx:if="{{loading}}" class="state">{{i18n.loading}}</view>
    <view wx:elif="{{!items.length}}" class="empty card">
      <view class="empty-icon">✦</view>
      <view class="empty-title">{{empty}}</view>
      <view class="empty-desc">{{i18n.profileDetail.couponEmpty}}</view>
    </view>
    <view wx:else class="coupon-list">
      <view class="coupon card" wx:for="{{items}}" wx:key="id">
        <view class="coupon-title">{{item.displayTitle}}</view>
        <view class="coupon-desc">{{item.displayDesc}}</view>
        <view class="coupon-expiry">{{item.displayExpiry}}</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{mode === 'traveler' || mode === 'document'}}" class="content">
    <view wx:if="{{loading}}" class="state">{{i18n.loading}}</view>
    <view wx:elif="{{!items.length}}" class="empty card">
      <view class="empty-icon">○</view>
      <view class="empty-title">{{empty}}</view>
      <view class="empty-desc">{{i18n.profileDetail.profileEmpty}}</view>
      <view class="empty-add" bindtap="onAddItem">+ {{mode === 'traveler' ? i18n.profileDetail.addTraveler : i18n.profileDetail.addDocument}}</view>
    </view>
    <block wx:else>
      <view class="list-add card" bindtap="onAddItem">
        <view class="list-add-plus">+</view>
        <view class="list-add-text">{{mode === 'traveler' ? i18n.profileDetail.addTraveler : i18n.profileDetail.addDocument}}</view>
      </view>
      <view class="saved-list">
        <view class="saved-card card" wx:for="{{items}}" wx:key="id" data-index="{{index}}" bindtap="onEditItem">
          <view class="saved-main">
            <view class="saved-name">{{item.name}}</view>
            <view wx:if="{{item.relation}}" class="saved-meta">{{item.relation}}</view>
            <view wx:if="{{item.passportNo}}" class="saved-meta">{{i18n.profileDetail.passport}}：{{item.passportNo}}</view>
            <view wx:if="{{item.expiry}}" class="saved-meta">{{i18n.profileDetail.expiry}}：{{item.expiry}}</view>
            <view wx:if="{{item.visaStatus}}" class="saved-meta">{{i18n.profileDetail.visaStatus}}：{{item.visaStatus}}</view>
          </view>
          <view class="saved-actions">
            <text catchtap="onEditItem" data-index="{{index}}">{{i18n.profileDetail.edit}}</text>
            <text catchtap="onDeleteProfile" data-index="{{index}}">{{i18n.profileDetail.delete}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
