<view class="page">
  <view class="topbar">
    <text class="back" bindtap="onBack">‹</text>
    <text class="title">{{title}}</text>
    <view class="topbar-space"></view>
  </view>

  <view wx:if="{{mode === 'leads' || mode === 'trips'}}" class="content">
    <view wx:if="{{loading}}" class="state">正在加载记录…</view>
    <view wx:elif="{{!items.length}}" class="empty card">
      <view class="empty-icon">○</view>
      <view class="empty-title">{{empty}}</view>
      <view class="empty-desc">提交咨询后，顾问确认的进度会显示在这里</view>
    </view>
    <view wx:else class="record-list">
      <view class="record card" wx:for="{{items}}" wx:key="id">
        <view class="record-head">
          <text class="record-title">{{item.displayTitle}}</text>
          <text class="record-status">{{item.displayStatus}}</text>
        </view>
        <view class="record-line">预约日期：{{item.displayDate}}</view>
        <view class="record-line">提交时间：{{item.displayCreated}}</view>
        <view class="record-route">{{item.displayRoute}}</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{mode === 'coupons'}}" class="content">
    <view class="empty card">
      <view class="empty-icon">✦</view>
      <view class="empty-title">{{empty}}</view>
      <view class="empty-desc">如有适用权益，顾问会在确认咨询时为您说明</view>
    </view>
  </view>

  <view wx:elif="{{mode === 'traveler' || mode === 'document'}}" class="content">
    <view class="privacy-note">资料仅保存在当前设备，并按当前微信账号隔离。</view>
    <view class="form card">
      <view class="field">
        <view class="field-label">姓名或称呼 <text class="required">*</text></view>
        <input class="input" placeholder="例如：张先生 / 小朋友" value="{{form.name}}" data-field="name" bindinput="onInput" />
      </view>
      <view wx:if="{{mode === 'traveler'}}" class="field">
        <view class="field-label">与本人关系</view>
        <input class="input" placeholder="例如：本人 / 配偶 / 子女" value="{{form.relation}}" data-field="relation" bindinput="onInput" />
      </view>
      <view class="field">
        <view class="field-label">护照号码</view>
        <input class="input" placeholder="选填" value="{{form.passportNo}}" data-field="passportNo" bindinput="onInput" />
      </view>
      <view wx:if="{{mode === 'document'}}" class="field">
        <view class="field-label">护照有效期</view>
        <input class="input" placeholder="例如：2030-06-30" value="{{form.expiry}}" data-field="expiry" bindinput="onInput" />
      </view>
      <view wx:if="{{mode === 'document'}}" class="field field-last">
        <view class="field-label">签证备注</view>
        <input class="input" placeholder="例如：已持申根签 / 待确认" value="{{form.visaStatus}}" data-field="visaStatus" bindinput="onInput" />
      </view>
      <button class="save-button" bindtap="onSaveLocal">{{editingIndex >= 0 ? '保存修改' : '添加资料'}}</button>
    </view>

    <view wx:if="{{items.length}}" class="saved-list">
      <view class="saved-card card" wx:for="{{items}}" wx:key="updatedAt">
        <view class="saved-main">
          <view class="saved-name">{{item.name}}</view>
          <view wx:if="{{item.relation}}" class="saved-meta">{{item.relation}}</view>
          <view wx:if="{{item.passportNo}}" class="saved-meta">护照：{{item.passportNo}}</view>
          <view wx:if="{{item.expiry}}" class="saved-meta">有效期：{{item.expiry}}</view>
          <view wx:if="{{item.visaStatus}}" class="saved-meta">签证：{{item.visaStatus}}</view>
        </view>
        <view class="saved-actions">
          <text data-index="{{index}}" bindtap="onEditLocal">编辑</text>
          <text data-index="{{index}}" bindtap="onDeleteLocal">删除</text>
        </view>
      </view>
    </view>
  </view>
</view>
