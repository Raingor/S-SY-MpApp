/* 与文史专辑页共用版式，不新增图片素材。 */
@import "../audio/album.wxss";
/* 抵消专辑页的小尺寸黑箭头覆盖，沿用 app.wxss 的蓝色玻璃返回按钮。 */
.video-back { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; }
.video-back .sy-back-chevron { width: 18rpx; height: 18rpx; margin-left: 0; border-left: 4rpx solid #FFFFFF; border-bottom: 4rpx solid #FFFFFF; transform: translateX(3rpx) rotate(45deg); }
.video-subject { margin-top: 14rpx; color: #77716A; font-size: 21rpx; line-height: 1.6; }
.video-cover { background: #10141B; }
.humanities-detail .audio-album-top-inset,
.humanities-detail .audio-nav { background: #F4F0E7; }
.humanities-detail .audio-album-overview { background: linear-gradient(180deg, #F4F0E7, #F7F7FA); }
.humanities-detail .audio-album-kicker { color: #9A7737; }
.humanities-detail .audio-title { color: #0B3C5D; }
.humanities-detail .audio-album-tab-active::after { background: #B79656; }
.humanities-detail .audio-album-play-button { background: #0B3C5D; }
.video-lock { position: relative; width: 36rpx; height: 30rpx; border: 2rpx solid #BDA46C; border-radius: 6rpx; }
.video-lock::before { content: ''; position: absolute; top: -25rpx; left: 7rpx; width: 18rpx; height: 23rpx; border: 2rpx solid #BDA46C; border-bottom: 0; border-radius: 14rpx 14rpx 0 0; }
.video-lock::after { content: ''; position: absolute; top: 10rpx; left: 16rpx; width: 3rpx; height: 9rpx; background: #BDA46C; }
.album-section-scroll { width: 100%; white-space: nowrap; }
.album-section-chips { display: inline-flex; align-items: center; padding: 8rpx 24rpx 18rpx; }
.album-section-chip { flex: 0 0 auto; margin-right: 14rpx; padding: 10rpx 22rpx; border: 1rpx solid #D9D2C4; border-radius: 999rpx; color: #5F5A52; font-size: 22rpx; line-height: 1.4; background: #FFFFFF; }
.album-section-chip-active { color: #0B3C5D; border-color: #B79656; background: #F4F0E7; }
.album-section-heading { display: flex; align-items: center; justify-content: space-between; margin: 22rpx 24rpx 10rpx; color: #0B3C5D; font-size: 24rpx; font-weight: 600; }
.album-section-heading-count { color: #8B857C; font-size: 20rpx; font-weight: 400; }
.episode-item { margin: 0 24rpx 14rpx; }
.episode-item-active { margin-bottom: 18rpx; }
.episode-item .audio-list-row { margin: 0; }
