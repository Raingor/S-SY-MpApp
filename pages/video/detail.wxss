/* 与文史专辑页共用版式，不新增图片素材。 */
@import "../audio/album.wxss";
/* 抵消专辑页的小尺寸黑箭头覆盖，沿用 app.wxss 的蓝色玻璃返回按钮。 */
.video-back { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; }
.video-back .sy-back-chevron { width: 18rpx; height: 18rpx; margin-left: 0; border-left: 4rpx solid #FFFFFF; border-bottom: 4rpx solid #FFFFFF; transform: translateX(3rpx) rotate(45deg); }
.video-subject { margin-top: 14rpx; color: #77716A; font-size: 21rpx; line-height: 1.6; }
.video-cover { background: #10141B; }
.video-lock { position: relative; width: 36rpx; height: 30rpx; border: 2rpx solid #BDA46C; border-radius: 6rpx; }
.video-lock::before { content: ''; position: absolute; top: -25rpx; left: 7rpx; width: 18rpx; height: 23rpx; border: 2rpx solid #BDA46C; border-bottom: 0; border-radius: 14rpx 14rpx 0 0; }
.video-lock::after { content: ''; position: absolute; top: 10rpx; left: 16rpx; width: 3rpx; height: 9rpx; background: #BDA46C; }
