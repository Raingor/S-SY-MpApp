<view class="travel-guide-page">
  <view class="travel-hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="travel-nav sy-nav">
      <view class="travel-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="travel-brand">{{i18n.brand}}</view>
      <view class="travel-mark">✦</view>
    </view>
    <view class="travel-hero-body">
      <view class="travel-kicker">TRAVEL GUIDE</view>
      <view class="travel-title serif">{{i18n.travel.title}}</view>
      <view class="travel-subtitle">{{i18n.travel.subtitle}}</view>
      <view class="travel-promise"><text>{{i18n.travel.promise1}}</text><text>{{i18n.travel.promise2}}</text><text>{{i18n.travel.promise3}}</text></view>
    </view>
  </view>

  <view class="travel-content">
    <view class="travel-section-kicker">FROM OUR GUIDE LIBRARY</view>
    <view class="travel-heading serif">{{i18n.travel.heading}}</view>
    <view class="travel-intro">{{i18n.travel.intro}}</view>

    <view class="travel-section" wx:for="{{sections}}" wx:key="key">
      <view class="travel-section-head">
        <view>
          <view class="travel-section-kicker">{{item.kicker}}</view>
          <view class="travel-subheading serif">{{item.title}}</view>
        </view>
        <view class="travel-section-line"></view>
      </view>
      <view class="travel-section-intro">{{item.intro}}</view>

      <view class="travel-grid">
        <view class="travel-card card" wx:for="{{item.guides}}" wx:key="key" wx:for-item="guide">
          <view class="travel-card-top">
            <view class="travel-icon travel-icon-{{guide.key}}">{{guide.mark}}</view>
            <view class="travel-card-source">{{i18n.travel.onlineRead}} · {{guide.source}}</view>
          </view>
          <view class="travel-card-title">{{guide.title}}</view>
          <view class="travel-card-desc">{{guide.desc}}</view>
          <view class="travel-points">
            <view class="travel-point" wx:for="{{guide.points}}" wx:key="*this" wx:for-item="point">
              <view class="travel-point-dot"></view>
              <text>{{point}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="travel-note">
      <view class="travel-note-mark">i</view>
      <view class="travel-note-copy">{{i18n.travel.note}}</view>
    </view>
  </view>

  <view class="travel-consult card" bindtap="onConsult">
    <view class="travel-consult-copy">
      <view class="travel-consult-kicker">NEED A CUSTOM PLAN?</view>
      <view class="travel-consult-title serif">{{i18n.travel.consultTitle}}</view>
      <view class="travel-consult-desc">{{i18n.travel.consultDesc}}</view>
    </view>
    <view class="travel-consult-arrow">›</view>
  </view>

  <view class="travel-footer">{{i18n.brandEn}} · {{i18n.commonSlogan}}</view>
</view>
