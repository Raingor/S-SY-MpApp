/* ============ 出行指南 ============ */
.travel-guide-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: #F4F7FA;
  color: #16283A;
}

.travel-hero {
  position: relative;
  padding: 0 32rpx 64rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #071F34, #0B3C5D 68%, #28678B);
  color: #FFFFFF;
}

.travel-hero::after {
  content: '';
  position: absolute;
  right: -130rpx;
  top: 170rpx;
  width: 380rpx;
  height: 380rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  box-shadow: 0 0 0 58rpx rgba(255, 255, 255, 0.03);
}

.travel-nav {
  position: relative;
  z-index: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.82);
}

.travel-brand {
  max-width: 360rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.travel-mark {
  color: #D8B878;
  font-size: 26rpx;
}

.travel-hero-body {
  position: relative;
  z-index: 1;
  padding-top: 48rpx;
}

.travel-kicker,
.travel-section-kicker,
.travel-consult-kicker {
  color: #D8B878;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.travel-title {
  margin-top: 16rpx;
  font-size: 54rpx;
  line-height: 1.3;
}

.travel-subtitle {
  max-width: 620rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 27rpx;
  line-height: 1.8;
}

.travel-promise {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

.travel-promise text {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.travel-content {
  padding: 56rpx 32rpx 0;
}

.travel-heading {
  margin-top: 14rpx;
  color: #0B3C5D;
  font-size: 38rpx;
}

.travel-intro {
  margin-top: 10rpx;
  color: #5B6B7A;
  font-size: 25rpx;
  line-height: 1.7;
}

.travel-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 28rpx;
}

.travel-card {
  width: calc((100% - 20rpx) / 2);
  min-height: 296rpx;
  box-sizing: border-box;
  padding: 24rpx 22rpx 22rpx;
}

.travel-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #EAF4F9;
  color: #1567A8;
  font-family: Georgia, serif;
  font-size: 30rpx;
  font-weight: 700;
}

.travel-icon-visa { background: #EAF4F9; color: #1567A8; }
.travel-icon-airport { background: #FBF3E3; color: #B08D45; }
.travel-icon-island { background: #E4F2F8; color: #2E75A0; }
.travel-icon-season { background: #FFF3D8; color: #B08D45; }
.travel-icon-daily { background: #E8F3EC; color: #2E7D5B; }
.travel-icon-etiquette { background: #F3EAF7; color: #7B579B; }

.travel-card-title {
  margin-top: 20rpx;
  color: #0B3C5D;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.travel-card-desc {
  margin-top: 10rpx;
  color: #5B6B7A;
  font-size: 22rpx;
  line-height: 1.65;
}

.travel-card-more {
  margin-top: 14rpx;
  color: #1567A8;
  font-size: 22rpx;
  font-weight: 600;
}

.travel-card-more text {
  margin-left: 4rpx;
  font-family: Georgia, serif;
  font-size: 28rpx;
}

.travel-consult {
  display: flex;
  align-items: center;
  margin: 44rpx 32rpx 0;
  padding: 28rpx 24rpx;
}

.travel-consult-copy { flex: 1; min-width: 0; }

.travel-consult-title {
  margin-top: 8rpx;
  color: #0B3C5D;
  font-size: 30rpx;
}

.travel-consult-desc {
  margin-top: 6rpx;
  color: #8AA3B5;
  font-size: 23rpx;
  line-height: 1.6;
}

.travel-consult-arrow {
  margin-left: 18rpx;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 38rpx;
}

.travel-footer {
  margin: 56rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid #DCE8ED;
  color: #8AA3B5;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}
