/* ============ 出行指南 ============ */
.travel-guide-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: #F4F7FA;
  color: #16283A;
}

.travel-hero {
  position: relative;
  padding: 0 32rpx 64rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #071F34, #0B3C5D 68%, #28678B);
  color: #FFFFFF;
}

.travel-hero::after {
  content: '';
  position: absolute;
  right: -130rpx;
  top: 170rpx;
  width: 380rpx;
  height: 380rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  box-shadow: 0 0 0 58rpx rgba(255, 255, 255, 0.03);
}

.travel-nav {
  position: relative;
  z-index: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.82);
}

.travel-brand {
  max-width: 360rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.travel-mark {
  color: #D8B878;
  font-size: 26rpx;
}

.travel-hero-body {
  position: relative;
  z-index: 1;
  padding-top: 48rpx;
}

.travel-kicker,
.travel-section-kicker,
.travel-consult-kicker {
  color: #D8B878;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.travel-title {
  margin-top: 16rpx;
  font-size: 54rpx;
  line-height: 1.3;
}

.travel-subtitle {
  max-width: 620rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 31rpx;
  line-height: 1.8;
}

.travel-promise {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

.travel-promise text {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
}

.travel-content {
  padding: 56rpx 32rpx 0;
}

.travel-heading {
  margin-top: 14rpx;
  color: #0B3C5D;
  font-size: 38rpx;
}

.travel-intro {
  margin-top: 10rpx;
  color: #5B6B7A;
  font-size: 29rpx;
  line-height: 1.7;
}

.travel-section {
  margin-top: 48rpx;
}

.travel-section:first-of-type {
  margin-top: 36rpx;
}

.travel-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.travel-subheading {
  margin-top: 8rpx;
  color: #0B3C5D;
  font-size: 32rpx;
}

.travel-section-line {
  width: 130rpx;
  height: 1rpx;
  margin-bottom: 12rpx;
  background: #D8B878;
  opacity: 0.7;
}

.travel-section-intro {
  margin-top: 10rpx;
  color: #6B7C8B;
  font-size: 28rpx;
  line-height: 1.65;
}

.travel-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 28rpx;
}

.travel-card {
  width: 100%;
  min-height: 0;
  box-sizing: border-box;
  padding: 26rpx 24rpx 24rpx;
}

.travel-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.travel-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #EAF4F9;
  color: #1567A8;
  font-family: Georgia, serif;
  font-size: 30rpx;
  font-weight: 700;
}

.travel-icon-visa { background: #EAF4F9; color: #1567A8; }
.travel-icon-airport { background: #FBF3E3; color: #B08D45; }
.travel-icon-island { background: #E4F2F8; color: #2E75A0; }
.travel-icon-season { background: #FFF3D8; color: #B08D45; }
.travel-icon-daily { background: #E8F3EC; color: #2E7D5B; }
.travel-icon-etiquette { background: #F3EAF7; color: #7B579B; }

.travel-icon-packing { background: #F4EDE2; color: #A37537; }
.travel-icon-outfit { background: #F7EAF0; color: #A05A77; }
.travel-icon-food { background: #FFF0DE; color: #B8753D; }
.travel-icon-photo { background: #E9F2F6; color: #37778E; }
.travel-icon-athens { background: #EAF0F8; color: #38678F; }
.travel-icon-mythology { background: #F2ECF8; color: #795A98; }
.travel-icon-destinations { background: #E8F3EC; color: #39765B; }

.travel-card-source {
  flex: 1;
  min-width: 0;
  padding-top: 8rpx;
  color: #9A7B43;
  font-size: 21rpx;
  line-height: 1.35;
  text-align: right;
}

.travel-card-title {
  margin-top: 20rpx;
  color: #0B3C5D;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.travel-card-desc {
  margin-top: 10rpx;
  color: #5B6B7A;
  font-size: 28rpx;
  line-height: 1.65;
}

.travel-points {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #E8EEF1;
}

.travel-point {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: #6B7C8B;
  font-size: 26rpx;
  line-height: 1.45;
}

.travel-point:first-child {
  margin-top: 0;
}

.travel-point-dot {
  width: 8rpx;
  height: 8rpx;
  flex: 0 0 8rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #D8B878;
}

.travel-note {
  display: flex;
  align-items: flex-start;
  margin-top: 42rpx;
  padding: 20rpx;
  border: 1rpx solid #DCE8ED;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
}

.travel-note-mark {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #EAF4F9;
  color: #1567A8;
  font-family: Georgia, serif;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.travel-note-copy {
  color: #7B8E9D;
  font-size: 25rpx;
  line-height: 1.6;
}

.travel-consult {
  display: flex;
  align-items: center;
  margin: 44rpx 32rpx 0;
  padding: 28rpx 24rpx;
}

.travel-consult-copy { flex: 1; min-width: 0; }

.travel-consult-title {
  margin-top: 8rpx;
  color: #0B3C5D;
  font-size: 30rpx;
}

.travel-consult-desc {
  margin-top: 6rpx;
  color: #8AA3B5;
  font-size: 26rpx;
  line-height: 1.6;
}

.travel-consult-arrow {
  margin-left: 18rpx;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 38rpx;
}

.travel-footer {
  margin: 56rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid #DCE8ED;
  color: #8AA3B5;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}
