<view class="page">

  <!-- ===== 1. 品牌头图轮播（沉浸式） ===== -->
  <view class="hero">
    <swiper
      class="hero-swiper"
      autoplay
      circular
      interval="4500"
      duration="600"
      bindchange="onHeroChange"
    >
      <swiper-item wx:for="{{heroList}}" wx:key="img">
        <image class="hero-img" src="{{item.img}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
    <!-- 深海蓝渐变遮罩（62%） -->
    <view class="hero-mask"></view>

    <!-- 状态栏占位 + 毛玻璃搜索栏 -->
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="hero-search" bindtap="onSearchTap">
      <view class="hero-search-icon"></view>
      <text class="hero-search-text">{{i18n.search}}</text>
    </view>
    <view class="country-switch" wx:if="{{countries.length > 1}}" bindtap="onCountryTap" hover-class="country-switch-press">
      <text>{{selectedCountryLabel}}</text><text class="country-switch-arrow">⌄</text>
    </view>

    <!-- 品牌名 + 品牌 slogan（压左下 1/3） -->
    <view class="hero-brand">
      <view class="hero-brand-en eyebrow">{{i18n.brandEn}}</view>
      <view class="hero-brand-name serif">{{i18n.brand}}</view>
      <view class="hero-brand-slogan">{{i18n.homeSlogan}}</view>
    </view>

    <!-- 轮播指示点 -->
    <view class="hero-dots">
      <view
        wx:for="{{heroList}}"
        wx:key="img"
        class="hero-dot {{heroCurrent === index ? 'hero-dot-active' : ''}}"
      ></view>
    </view>
  </view>

  <!-- ===== 2. 知识库入口总览 ===== -->
  <view class="knowledge-search card">
    <view class="knowledge-search-icon"></view>
    <input value="{{searchQuery}}" confirm-type="search" placeholder="{{productHome.searchPlaceholder}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
  </view>
  <view wx:if="{{searchQuery && searchResults.length}}" class="search-results card">
    <view wx:for="{{searchResults}}" wx:key="id" class="search-result" data-index="{{index}}" bindtap="onHotSpotTap"><image src="{{item.image}}" mode="aspectFill" /><view><view class="search-result-name">{{item.name}}</view><view class="search-result-desc">{{item.category}}</view></view><text>›</text></view>
  </view>

  <swiper class="product-banner" circular autoplay interval="4800" duration="500" bindchange="onCampaignChange">
    <swiper-item><view class="campaign campaign-member" data-type="member" bindtap="onCampaignTap"><view class="campaign-tag">LIMITED · {{productHome.banners[0]}}</view><view class="campaign-title serif">{{productHome.memberTitle}}</view><view class="campaign-copy">{{productHome.memberDesc}}</view><view class="campaign-action">{{productHome.openMember}} ›</view></view></swiper-item>
    <swiper-item><view class="campaign campaign-spot" data-type="spot" bindtap="onCampaignTap"><view class="campaign-tag">POPULAR · {{productHome.banners[1]}}</view><view class="campaign-title serif">{{productHome.popular}}</view><view class="campaign-copy">{{productHome.freeTrial}}</view><view class="campaign-action">{{productHome.freeTrial}} ›</view></view></swiper-item>
    <swiper-item><view class="campaign campaign-live" data-type="live" bindtap="onCampaignTap"><view class="campaign-tag">LIVE TALK · {{productHome.banners[2]}}</view><view class="campaign-title serif">{{productHome.liveTitle}}</view><view class="campaign-copy">{{productHome.liveDesc}}</view><view class="campaign-action">{{productHome.reserve}} ›</view></view></swiper-item>
  </swiper>

  <view class="product-section-head"><view class="eyebrow">CATEGORIES</view><view class="product-section-title serif">{{i18n.knowledge}}</view></view>
  <scroll-view class="knowledge-categories" scroll-x="true" show-scrollbar="false"><view wx:for="{{productHome.categories}}" wx:key="*this" data-index="{{index}}" bindtap="onCategoryTap" class="knowledge-category {{categoryIndex === index ? 'knowledge-category-on' : ''}}">{{item}}</view></scroll-view>

  <view class="product-section-head"><view class="eyebrow">POPULAR</view><view class="product-section-title serif">{{productHome.popular}}</view></view>
  <view class="hot-spot-grid"><view wx:for="{{hotSpots}}" wx:key="id" class="hot-spot card" data-index="{{index}}" bindtap="onHotSpotTap"><view class="hot-spot-image"><image src="{{item.image}}" mode="aspectFill" /><view class="free-trial-badge">{{productHome.freeTrial}}</view></view><view class="hot-spot-body"><view class="hot-spot-name serif">{{item.name}}</view><view class="hot-spot-desc">{{item.summary}}</view></view></view></view>

  <view class="live-zone card" bindtap="onLiveTap"><view><view class="eyebrow">LIVE TALK</view><view class="live-zone-title serif">{{productHome.liveTitle}}</view><view class="live-zone-copy">{{productHome.liveDesc}}</view></view><view class="live-zone-button">{{productHome.reserve}} ›</view></view>
  <view class="member-zone card" bindtap="onMemberTap"><view class="eyebrow member-eyebrow">MEMBERSHIP</view><view class="member-zone-title serif">{{productHome.memberTitle}}</view><view class="member-zone-copy">{{productHome.memberDesc}}</view><view class="member-zone-button">{{productHome.openMember}} ›</view></view>

  <!-- ===== 2. 核心五大服务入口 ===== -->
  <view class="entries card">
    <view
      class="entry-item"
      hover-class="card-press"
      wx:for="{{entries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onEntryTap"
    >
      <view class="entry-icon entry-icon-{{item.key}}">
        <view wx:if="{{item.key === 'travel-guide'}}" class="entry-compass" aria-label="出行指南图标">
          <view class="entry-compass-needle"></view>
        </view>
        <image wx:else class="entry-icon-img" src="/assets/images/icons/entry-{{item.key}}.png" mode="aspectFit" />
      </view>
      <view class="entry-label">{{item.label}}</view>
      <view class="entry-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- ===== 3. 导游名片轮播 ===== -->
  <swiper class="guide-swiper" circular="{{guideCarouselEnabled}}" autoplay="{{guideCarouselEnabled}}" interval="5000" duration="450" indicator-dots="{{guideCarouselEnabled}}" indicator-color="rgba(255,255,255,.32)" indicator-active-color="#E2C47F">
    <swiper-item wx:for="{{guides}}" wx:key="name">
      <view class="guide-entry card" hover-class="card-press" data-index="{{index}}" bindtap="onGuideTap">
        <view class="guide-entry-main">
          <image class="guide-entry-avatar" src="{{item.avatar}}" mode="aspectFill" webp="{{true}}" />
          <view class="guide-entry-info">
            <view class="guide-entry-kicker eyebrow">{{item.eyebrow}}</view>
            <view class="guide-entry-name serif">{{item.name}}</view>
            <view class="guide-entry-role">{{item.role}}</view>
            <view class="guide-entry-proof">{{item.proof}}</view>
          </view>
        </view>
        <view class="guide-entry-cta">{{i18n.homeGuideCta}} <text>›</text></view>
      </view>
    </swiper-item>
  </swiper>

  <!-- ===== 4. 甄选路线 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <view class="eyebrow">SELECTED ROUTES</view>
        <view class="section-title serif">{{i18n.selectedRoutes}}</view>
      </view>
      <view class="section-more" bindtap="onMoreRoutes">{{i18n.viewAllRoutes}} ›</view>
    </view>

    <scroll-view class="route-scroll" scroll-x="true" enhanced="true" show-scrollbar="false" enable-flex="true">
      <view class="route-scroll-track">
        <view class="route-card card" hover-class="card-press" wx:for="{{routes}}" wx:key="id" data-id="{{item.id}}" bindtap="onRouteTap">
          <view class="route-img-wrap">
            <image class="route-img" src="{{item.img}}" mode="aspectFill" />
            <view class="route-tag">{{item.tag}}</view>
          </view>
          <view class="route-body">
            <view class="route-name ellipsis">{{item.name}}</view>
            <view class="route-highlights ellipsis">{{item.highlights}}</view>
            <view class="route-foot">
              <view class="btn-inquiry">{{i18n.viewReference}}</view>
              <view class="route-crowd">{{item.crowd}}</view>
            </view>
          </view>
        </view>
        <view class="route-scroll-end-gap" aria-hidden="true"></view>
      </view>
    </scroll-view>

    <!-- 定制行程入口（与路线区同屏，明显位置） -->
    <view class="custom-trip-entry card" bindtap="onCustomTripTap">
      <view class="custom-trip-main">
        <view class="eyebrow custom-trip-kicker">CUSTOM ITINERARY</view>
        <view class="custom-trip-title serif">{{i18n.customItinerary}}</view>
        <view class="custom-trip-desc">{{i18n.customItineraryDesc}}</view>
      </view>
      <view class="custom-trip-arrow">›</view>
    </view>
  </view>

  <!-- ===== 4. 奢享体验 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <view class="eyebrow">LUXURY EXPERIENCE</view>
        <view class="section-title serif">{{i18n.luxury}}</view>
      </view>
    </view>
    <view class="lux-row">
      <view class="lux-card card" hover-class="card-press" wx:for="{{luxuries}}" wx:key="id" data-id="{{item.id}}" bindtap="onLuxuryTap">
        <image class="lux-img" src="{{item.img}}" mode="aspectFill" />
        <view class="lux-mask"></view>
        <view class="lux-corner">{{i18n.luxuryTag}}</view>
        <view class="lux-body">
          <view class="lux-name serif">{{item.name}}</view>
          <view class="lux-desc">
            <view wx:for="{{item.descLines}}" wx:for-item="line" wx:key="*this">{{line}}</view>
          </view>
          <view class="lux-cta">{{i18n.luxuryCta}} ›</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 5. 精选目的地 ===== -->
  <view class="section">
    <view class="section-head">
      <view>
        <view class="eyebrow">DESTINATIONS</view>
        <view class="section-title serif">{{i18n.destinations}}</view>
      </view>
    </view>

    <!-- 双分类切换 -->
    <view class="dest-tabs">
      <view
        class="dest-tab {{destTab === index ? 'dest-tab-active' : ''}}"
        wx:for="{{destTabs}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onDestTab"
      >{{item}}</view>
    </view>

    <block wx:for="{{destinations}}" wx:key="tab" wx:for-item="group" wx:for-index="gi">
      <view wx:if="{{destTab === gi}}">
        <view class="dest-grid">
          <view class="dest-tile" hover-class="card-press" wx:for="{{group.tiles}}" wx:key="id" data-attraction-id="{{item.attractionId}}" bindtap="onDestTap">
            <image class="dest-img" src="{{item.img}}" mode="aspectFill" webp="{{true}}" lazy-load="{{true}}" />
            <view class="dest-mask"></view>
            <view class="dest-info">
              <view class="dest-en eyebrow">{{item.en}}</view>
              <view class="dest-name">{{item.name}}</view>
            </view>
          </view>
        </view>
        <view class="dest-chips">
          <view class="dest-chip" wx:for="{{group.chips}}" wx:key="*this" bindtap="onDestTap">{{item}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- ===== 6. 品牌页脚 ===== -->
  <view class="footer">
    <view class="footer-line"></view>
    <view class="footer-site" bindtap="onSiteTap">sy-greece.com</view>
    <view class="footer-slogan">{{i18n.homeSlogan}}</view>
  </view>

</view>
