/* ============ P1 首页 ============ */
.page {
  padding-bottom: var(--tabbar-safe-bottom); /* 给悬浮 TabBar 留空间 */
}

/* ===== 1. 品牌头图轮播 ===== */
.hero {
  position: relative;
  height: 900rpx;
}

.hero-swiper,
.hero-img {
  width: 100%;
  height: 100%;
}

.hero-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #0B3C5D, #1567A8);
  color: rgba(255, 255, 255, .8);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.hero-empty-mark {
  margin-bottom: 18rpx;
  color: #E2C47F;
  font-family: Georgia, serif;
  font-size: 50rpx;
  letter-spacing: 8rpx;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(180deg, rgba(11, 60, 93, 0) 0%, rgba(11, 60, 93, 0.45) 40%, rgba(11, 60, 93, 0.82) 100%);
  pointer-events: none;
}

/* 毛玻璃搜索栏 */
.hero-search {
  margin: 16rpx 32rpx 0;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.hero-search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.hero-search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 4rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.hero-search-text {
  margin-left: 18rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}

.country-switch {
  position: absolute;
  z-index: 3;
  right: 40rpx;
  bottom: 190rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 18rpx 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 28rpx;
  background: rgba(9, 43, 67, 0.34);
  color: #FFFFFF;
  font-size: 23rpx;
  backdrop-filter: blur(12rpx);
}

.country-switch-arrow { color: #E2C47F; font-size: 21rpx; }
.country-switch-press { opacity: .78; }

/* 品牌区（压左下） */
.hero-brand {
  position: absolute;
  left: 40rpx;
  bottom: 100rpx;
  right: 120rpx;
  color: #FFFFFF;
}

.hero-brand-en {
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 6rpx;
}

.hero-brand-name {
  margin-top: 8rpx;
  font-size: 64rpx;
  line-height: 1.25;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 24rpx rgba(11, 60, 93, 0.5);
}

.hero-brand-slogan {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

/* 轮播指示点 */
.hero-dots {
  position: absolute;
  right: 40rpx;
  bottom: 110rpx;
  display: flex;
  gap: 10rpx;
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.45);
  transition: all 0.3s;
}

.hero-dot-active {
  width: 36rpx;
  background: #FFFFFF;
}

/* ===== 2. 六大服务入口 ===== */
.entries {
  position: relative;
  margin: -70rpx 32rpx 0;
  padding: 28rpx 16rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  row-gap: 22rpx;
  z-index: 5;
}

.entry-item {
  flex: 0 0 33.3333%;
  box-sizing: border-box;
  min-width: 0;
  min-height: 164rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.entry-icon-customization { background: linear-gradient(140deg, #0B3C5D, #1567A8); }
.entry-icon-guide { background: linear-gradient(140deg, #E3F2FC, #CDE6F8); }
.entry-icon-vehicle { background: linear-gradient(140deg, #FBF3E3, #F3E5CB); }
.entry-icon-knowledge { background: linear-gradient(140deg, #E8F3EC, #D9EBDF); }
.entry-icon-business { background: linear-gradient(140deg, #F3EAF7, #E5D9EF); }
.entry-icon-travel-guide { background: linear-gradient(140deg, #F7F0E2, #EEDDB7); }

.entry-compass {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  border: 4rpx solid #B08D45;
  border-radius: 50%;
}

.entry-compass::before,
.entry-compass::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: #B08D45;
  transform: translate(-50%, -50%);
}

.entry-compass::before {
  width: 4rpx;
  height: 60rpx;
}

.entry-compass::after {
  width: 60rpx;
  height: 4rpx;
}

.entry-compass-needle {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 1;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid #B08D45;
  border-radius: 50%;
  background: #F7F0E2;
  transform: translate(-50%, -50%);
}

.entry-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
  text-align: center;
}

.entry-desc {
  font-size: 22rpx;
  color: var(--c-weak);
  line-height: 1.35;
  text-align: center;
}

/* 图标：波浪+太阳 */
.i-wave { position: relative; width: 52rpx; height: 44rpx; }
.i-wave-sun {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1567A8;
}
.i-wave-line {
  position: absolute;
  left: 0;
  width: 52rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #1567A8;
}
.i-wave-line.l1 { top: 16rpx; opacity: 0.85; }
.i-wave-line.l2 { bottom: 0; opacity: 0.4; }






/* ===== 3. 名人导游推荐 ===== */
.guide-swiper {
  height: 252rpx;
  margin: 26rpx 32rpx 0;
}

.guide-entry {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  height: 244rpx;
  margin: 0;
  padding: 24rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(135deg, #092B43 0%, #0B3C5D 72%, #1567A8 100%);
  color: #FFFFFF;
}

.guide-entry::after {
  content: '';
  position: absolute;
  right: -54rpx;
  top: -72rpx;
  width: 190rpx;
  height: 190rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  box-shadow: 0 0 0 24rpx rgba(255, 255, 255, 0.03);
  pointer-events: none;
}

.guide-entry-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.guide-entry-avatar {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  border: 3rpx solid #D8B878;
  border-radius: 50%;
}

.guide-entry-info {
  min-width: 0;
  flex: 1;
}

.guide-entry-kicker {
  color: #D8B878;
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.guide-entry-name {
  margin-top: 3rpx;
  font-size: 34rpx;
  line-height: 1.3;
}

.guide-entry-role {
  margin-top: 4rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-entry-proof {
  margin-top: 8rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-entry-cta {
  position: relative;
  z-index: 1;
  align-self: flex-end;
  margin-top: 16rpx;
  padding-right: 2rpx;
  color: #E2C47F;
  font-size: 20rpx;
}

.guide-entry-cta text {
  margin-left: 5rpx;
  font-size: 25rpx;
}

/* ===== 甄选路线语音导览 ===== */
.route-audio {
  margin: 48rpx 32rpx 0;
  padding: 26rpx 28rpx 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F8F4EA, #FFFFFF 72%);
  border: 1rpx solid #E7E0D1;
}

.route-audio-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.route-audio-kicker {
  color: #B2853E;
}

.route-audio-title {
  margin-top: 8rpx;
  color: var(--c-deep);
  font-size: 32rpx;
  font-weight: 700;
}

.route-audio-desc {
  margin-top: 7rpx;
  color: var(--c-sub);
  font-size: 22rpx;
  line-height: 1.5;
}

.route-audio-mark {
  flex-shrink: 0;
  color: #C6A15B;
  font-size: 48rpx;
  line-height: 1;
}

.route-audio-native {
  position: absolute;
  left: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
}

.route-audio-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.route-audio-main-control {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #0B3C5D, #1567A8);
  color: #FFFFFF;
}

.route-audio-control-press {
  opacity: .78;
  transform: scale(.98);
}

.route-audio-icon {
  position: relative;
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.route-audio-icon-play {
  margin-left: 3rpx;
  width: 0;
  height: 0;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 22rpx solid #FFFFFF;
}

.route-audio-icon-pause::before,
.route-audio-icon-pause::after {
  content: '';
  position: absolute;
  top: 1rpx;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: #FFFFFF;
}

.route-audio-icon-pause::before { left: 4rpx; }
.route-audio-icon-pause::after { right: 4rpx; }

.route-audio-control-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 700;
}

.route-audio-time {
  flex-shrink: 0;
  color: #0B3C5D;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.route-audio-time text {
  color: #93A5B3;
}

.route-audio-restart {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid #D8E2E8;
  border-radius: 50%;
  background: #FFFFFF;
  color: #0B3C5D;
  font-size: 40rpx;
  line-height: 1;
}

.route-audio-progress {
  height: 8rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #E5EBEF;
}

.route-audio-progress-bar {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #C6A15B, #E2C47F);
  transition: width .2s linear;
}

.route-audio-note {
  margin-top: 8rpx;
  color: #B2853E;
  font-size: 20rpx;
  line-height: 1.4;
}

.route-audio-more {
  margin-top: 14rpx;
  color: #1567A8;
  font-size: 23rpx;
  font-weight: 600;
  text-align: right;
}

/* ===== 通用 section ===== */
.section {
  margin-top: 48rpx;
  padding: 0 32rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 44rpx;
  color: var(--c-deep);
  letter-spacing: 2rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--c-sub);
  padding-bottom: 6rpx;
}

/* ===== 3. 甄选路线 ===== */
.route-scroll {
  width: calc(100% + 32rpx);
  margin-right: -32rpx;
  white-space: nowrap;
}

.route-scroll-track {
  display: flex;
  gap: 24rpx;
  padding-right: 32rpx;
}

/* 用真实的可滚动占位保证最后一张路线卡右侧留白。 */
.route-scroll-end-gap {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 1rpx;
}

.route-card {
  flex: 0 0 590rpx;
  width: 590rpx;
  overflow: hidden;
  white-space: normal;
}

.route-img-wrap {
  position: relative;
  height: 300rpx;
}

.route-img {
  width: 100%;
  height: 100%;
}

.route-tag {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8rpx);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-primary);
  letter-spacing: 1rpx;
}

.route-body {
  padding: 24rpx 28rpx 28rpx;
}

.route-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}

.route-highlights {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--c-sub);
}

.route-foot {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.route-crowd {
  font-size: 24rpx;
  color: var(--c-weak);
}

/* ===== 5. 奢享体验 ===== */
.lux-scroll {
  width: calc(100% + 32rpx);
  margin-right: -32rpx;
  white-space: nowrap;
}

.lux-row {
  display: flex;
  gap: 24rpx;
  padding-right: 32rpx;
}

.lux-card {
  position: relative;
  flex: 0 0 500rpx;
  width: 500rpx;
  height: 420rpx;
  overflow: hidden;
  white-space: normal;
}

.lux-scroll-end-gap {
  flex: 0 0 1rpx;
  width: 1rpx;
}

.lux-img {
  width: 100%;
  height: 100%;
}

.lux-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(11, 60, 93, 0) 30%, rgba(11, 60, 93, 0.85) 100%);
}

.lux-corner {
  position: absolute;
  right: -2rpx;
  top: 24rpx;
  padding: 8rpx 20rpx 8rpx 24rpx;
  border-radius: 24rpx 0 0 24rpx;
  background: linear-gradient(135deg, #D8B878, #C6A15B);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(198, 161, 91, 0.4);
}

.lux-body {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 26rpx;
  color: #FFFFFF;
}

.lux-name {
  font-size: 36rpx;
  letter-spacing: 2rpx;
}

.lux-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  white-space: pre-line;
}

.lux-cta {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #EBD7AE;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ===== 5. 精选目的地 ===== */
.dest-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.dest-tab {
  padding: 12rpx 34rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--c-sub);
  background: #FFFFFF;
  border: 2rpx solid #E1E9F0;
}

.dest-tab-active {
  background: var(--c-primary);
  border-color: var(--c-primary);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(21, 103, 168, 0.3);
}

.dest-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.dest-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  border: 2rpx solid #E1E9F0;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: var(--c-sub);
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.dest-tile {
  position: relative;
  width: calc((100% - 18rpx) / 2);
  height: 240rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.dest-img {
  width: 100%;
  height: 100%;
}

.dest-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(11, 60, 93, 0) 35%, rgba(11, 60, 93, 0.8) 100%);
}

.dest-info {
  position: absolute;
  left: 22rpx;
  bottom: 18rpx;
  color: #FFFFFF;
}

.dest-en {
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
}

.dest-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.dest-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.dest-chip {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  color: var(--c-sub);
  border: 2rpx solid #E1E9F0;
}

/* ===== 6. 品牌页脚 ===== */
.footer {
  margin-top: 64rpx;
  /* 预留自定义 TabBar 及中间凸起按钮的安全区 */
  padding: 0 32rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-line {
  width: 64rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--c-gold);
  margin-bottom: 24rpx;
}

.footer-site {
  font-family: 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-primary);
  letter-spacing: 2rpx;
}

.footer-slogan {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--c-weak);
  letter-spacing: 1rpx;
}

/* ===== 定制行程入口（路线区底部） ===== */
.custom-trip-entry {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  background: linear-gradient(135deg, #0B3C5D 0%, #1567A8 100%);
}

.custom-trip-main { flex: 1; min-width: 0; }

.custom-trip-kicker {
  color: #D8B878;
}

.custom-trip-title {
  margin-top: 10rpx;
  color: #FFFFFF;
  font-size: 32rpx;
}

.custom-trip-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.7;
}

.custom-trip-arrow {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  font-family: Georgia, serif;
  font-size: 44rpx;
}
