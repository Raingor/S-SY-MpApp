page { min-height: 100vh; background: #111214; }
.audio-experience-page { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; background: #111214; color: #f2f1ed; }
.audio-experience-hero { position: relative; height: 100vh; min-height: 100vh; overflow: hidden; background: #202126; }
.audio-experience-cover { position: absolute; inset: 0; width: 100%; height: 100%; }
.audio-experience-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,9,11,.55), rgba(8,9,11,.02) 38%, rgba(8,9,11,.18) 63%, rgba(8,9,11,.88)); }
.audio-experience-nav { position: absolute; top: env(safe-area-inset-top); right: 26rpx; left: 26rpx; display: flex; align-items: center; justify-content: space-between; height: 85rpx; color: #fff; font-size: 25rpx; }
.audio-back { width: 57rpx; height: 57rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.35); border-radius: 50%; background: rgba(14,15,18,.50); }
.audio-back .sy-back-chevron { width: 16rpx; height: 16rpx; margin-left: 7rpx; border-left: 4rpx solid #fff; border-bottom: 4rpx solid #fff; transform: rotate(45deg); }
.audio-nav-spacer { width: 57rpx; }
.audio-experience-caption { position: absolute; right: 34rpx; bottom: 50rpx; left: 34rpx; }
.audio-caption-kicker { color: rgba(255,255,255,.72); font-size: 19rpx; letter-spacing: 2.4rpx; }
.audio-experience-title { margin-top: 9rpx; color: #fff; font-size: 40rpx; line-height: 1.3; font-weight: 650; text-shadow: 0 2rpx 14rpx rgba(0,0,0,.45); }
.audio-experience-subtitle { margin-top: 7rpx; color: rgba(255,255,255,.78); font-size: 21rpx; }
.audio-experience-panel { position: fixed; z-index: 2; right: 0; bottom: 0; left: 0; min-height: 330rpx; max-height: 48vh; padding: 27rpx 30rpx calc(25rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-y: auto; border-radius: 22rpx 22rpx 0 0; background: #1b1c20; }
.audio-panel-loading { display: flex; align-items: center; justify-content: center; color: #aaaab0; font-size: 24rpx; }
.audio-panel-heading { color: #f1f0ec; font-size: 27rpx; font-weight: 600; }
.audio-experience-description { margin-top: 12rpx; color: #b5b6bb; font-size: 22rpx; line-height: 1.65; }
.audio-experience-location { margin-top: 14rpx; color: #9c9da4; font-size: 20rpx; }
.audio-demo-notice { margin-top: 18rpx; padding: 15rpx 17rpx; border: 1rpx solid rgba(215,185,118,.28); border-radius: 11rpx; background: rgba(124,96,39,.10); color: #d8c18d; font-size: 20rpx; line-height: 1.55; }
.audio-demo-play { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 19rpx; padding: 18rpx 20rpx; border-radius: 36rpx; background: #3d67ef; color: #fff; font-size: 23rpx; }
.audio-demo-play text { font-size: 22rpx; }
.audio-progress-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; color: #b3b4ba; font-size: 19rpx; }
.audio-progress-track { position: relative; flex: 1; height: 6rpx; border-radius: 6rpx; background: #45464b; }
.audio-progress-fill { height: 100%; border-radius: inherit; background: #5278ff; }
.audio-controls { display: flex; align-items: center; gap: 14rpx; margin-top: 21rpx; }
.audio-round-control { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #777981; border-radius: 50%; color: #fff; font-size: 24rpx; }
.audio-preview-control,.audio-full-control { flex: 1; padding: 18rpx 13rpx; border-radius: 32rpx; background: #33353c; color: #eee; font-size: 19rpx; text-align: center; }
.audio-full-control { background: #3b64e6; }
.audio-control-locked { background: #2c2d33; color: #aaaab0; }
.audio-point-tracks { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 15rpx; }
.audio-track-option { padding: 10rpx 14rpx; border: 1rpx solid #45464c; border-radius: 25rpx; color: #b8b9bf; font-size: 19rpx; }
.audio-selected { border-color: #6380ff; color: #dce2ff; }
.audio-simulation { margin-top: 20rpx; }
.audio-simulation button { margin-top: 12rpx; }
