page { height: 100%; background: #FFFFFF; }
.audio-experience-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #FFFFFF;
  color: #222222;
}
.audio-experience-nav {
  position: absolute;
  z-index: 3;
  right: 30rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  color: #1F1F1F;
  font-size: 26rpx;
  font-weight: 600;
}
.audio-back {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E1E1E1;
  border-radius: 50%;
  background: #FFFFFF;
}
.audio-back .sy-back-chevron {
  width: 16rpx;
  height: 16rpx;
  margin-left: 7rpx;
  border-left: 4rpx solid #222222;
  border-bottom: 4rpx solid #222222;
  transform: rotate(45deg);
}
.audio-nav-spacer { width: 58rpx; }
.audio-detail-scroll { flex: 1; min-height: 0; box-sizing: border-box; }
.audio-detail-content { padding: 20rpx 36rpx 430rpx; }
.audio-player-artwork {
  width: 88vw;
  height: 88vw;
  max-width: 670rpx;
  max-height: 670rpx;
  margin: 0 auto;
  overflow: hidden;
  background: #F5F5F5;
}
.audio-player-cover { display: block; width: 100%; height: 100%; }
.audio-cover-placeholder { display: flex; align-items: center; justify-content: center; }
.audio-wave-mark { position: relative; display: flex; align-items: center; justify-content: center; gap: 14rpx; width: 240rpx; height: 220rpx; }
.audio-wave-dot { position: absolute; top: 10rpx; left: 50%; width: 30rpx; height: 30rpx; margin-left: -15rpx; border-radius: 50%; background: #DEDEDE; }
.audio-wave-bar { width: 27rpx; border-radius: 16rpx; background: #DEDEDE; }
.audio-wave-bar-short { height: 96rpx; }
.audio-wave-bar-tall { height: 160rpx; margin-top: 55rpx; }
.audio-wave-bar-mid { height: 126rpx; margin-top: 24rpx; }
.audio-track-heading { margin: 30rpx 6rpx 0; }
.audio-track-title { overflow: hidden; color: #171717; font-size: 31rpx; line-height: 1.5; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.audio-track-subtitle { margin-top: 4rpx; color: #9A9A9A; font-size: 21rpx; }
.audio-point-tracks { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 18rpx 6rpx 0; }
.audio-track-option { padding: 10rpx 16rpx; border: 1rpx solid #E2E2E2; border-radius: 28rpx; background: #FFFFFF; color: #6C6C6C; font-size: 20rpx; }
.audio-selected { border-color: #333333; color: #222222; }
.audio-player-notice { margin: 18rpx 6rpx 0; color: #8A8A8A; font-size: 21rpx; line-height: 1.5; }
.audio-player-notice text { color: #236FA8; }
.audio-panel-loading { flex: 1; display: flex; align-items: center; justify-content: center; color: #8A8A8A; font-size: 24rpx; }
.audio-player-dock {
  position: absolute;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 8rpx 48rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EEEEEE;
  background: rgba(255,255,255,.98);
}
.audio-player-slider { margin: 0; padding: 0; }
.audio-player-times { display: flex; align-items: center; justify-content: space-between; margin-top: -4rpx; color: #858585; font-size: 25rpx; }
.audio-speed-button { display: flex; align-items: baseline; gap: 7rpx; color: #222222; font-size: 26rpx; }
.audio-speed-label { color: #777777; font-size: 22rpx; }
.audio-player-controls { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; }
.audio-skip-control { flex: 0 0 60rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #222222; }
.audio-skip-icon { height: 45rpx; font-size: 42rpx; line-height: 1; }
.audio-skip-seconds { margin-top: -3rpx; font-size: 19rpx; line-height: 1; }
.audio-track-step { flex: 0 0 45rpx; color: #2A2A2A; font-size: 34rpx; text-align: center; }
.audio-track-step-disabled { color: #E4E4E4; }
.audio-round-control {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #E1E1E1;
  border-radius: 50%;
  background: #FFFFFF;
  color: #222222;
}
.audio-round-control text { margin-left: 8rpx; font-size: 48rpx; line-height: 1; }
.audio-player-actions { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; color: #777777; font-size: 20rpx; }
.audio-preview-caption { flex: 1; min-width: 0; }
.audio-full-action {
  flex: 0 1 auto;
  max-width: 68%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 60rpx;
  margin: 0;
  padding: 10rpx 18rpx;
  border-radius: 32rpx;
  background: #EEF6FB;
  color: #176AA7;
  font-size: 21rpx;
  line-height: 1.4;
  text-align: center;
}
.audio-full-action::after { border: 0; }
.audio-full-action-hover { background: #DFEEF7; }
.audio-full-action-disabled { max-width: 68%; color: #9A9A9A; text-align: right; }
.audio-simulation { margin-top: 20rpx; color: #526777; font-size: 22rpx; }
.audio-simulation button { margin-top: 12rpx; }
.audio-paywall-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 24, 31, .64);
}
.audio-paywall-sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 14rpx 34rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #F8F7F3;
  color: #202C32;
  box-shadow: 0 -12rpx 50rpx rgba(14, 27, 37, .18);
}
.audio-paywall-topbar { position: relative; display: flex; justify-content: center; height: 34rpx; }
.audio-paywall-handle { width: 68rpx; height: 7rpx; margin-top: 4rpx; border-radius: 8rpx; background: #D8D5CE; }
.audio-paywall-close {
  position: absolute;
  top: -2rpx;
  right: -8rpx;
  width: 48rpx;
  height: 48rpx;
  color: #667179;
  font-size: 42rpx;
  line-height: 42rpx;
  text-align: center;
}
.audio-paywall-eyebrow { margin-top: 8rpx; color: #A37F4D; font-size: 18rpx; line-height: 1.4; font-weight: 700; letter-spacing: 3rpx; }
.audio-paywall-title { margin-top: 7rpx; color: #1F3039; font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.audio-paywall-subtitle { margin-top: 6rpx; color: #778087; font-size: 22rpx; line-height: 1.5; }
.audio-paywall-feature {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #E8E0D2;
  border-radius: 16rpx;
  background: #F1ECE2;
}
.audio-paywall-feature-mark { flex: 0 0 50rpx; width: 50rpx; height: 50rpx; border-radius: 50%; background: #DFD1B6; color: #80653D; font-size: 27rpx; line-height: 50rpx; text-align: center; }
.audio-paywall-feature-copy { flex: 1; min-width: 0; margin-left: 15rpx; }
.audio-paywall-track-title { overflow: hidden; color: #26343B; font-size: 23rpx; line-height: 1.4; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.audio-paywall-feature-desc { margin-top: 3rpx; color: #7C7971; font-size: 19rpx; line-height: 1.4; }
.audio-paywall-auth-card {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #D9E6EC;
  border-radius: 16rpx;
  background: #F0F6F8;
}
.audio-paywall-auth-title { color: #263943; font-size: 22rpx; line-height: 1.4; font-weight: 700; }
.audio-paywall-auth-desc { margin-top: 3rpx; color: #718087; font-size: 18rpx; line-height: 1.45; }
.audio-paywall-auth-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  margin: 13rpx 0 0;
  padding: 10rpx 20rpx;
  border: 0;
  border-radius: 36rpx;
  background: #176AA7;
  color: #FFFFFF;
  font-size: 21rpx;
  line-height: 1.4;
  font-weight: 600;
}
.audio-paywall-auth-button::after { border: 0; }
.audio-paywall-auth-button[disabled] { opacity: .65; }
.audio-paywall-auth-error { margin-top: 8rpx; color: #B44F45; font-size: 18rpx; line-height: 1.4; }
.audio-paywall-auth-state { margin-top: 12rpx; padding: 15rpx; border-radius: 14rpx; background: #F0F6F8; color: #718087; font-size: 19rpx; text-align: center; }
.audio-paywall-options { margin-top: 16rpx; }
.audio-paywall-plan {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #E2E4E3;
  border-radius: 17rpx;
  background: #FFFFFF;
}
.audio-paywall-plan-featured { border-color: #C5A66C; background: #FFFEFA; }
.audio-paywall-plan-copy { flex: 1; min-width: 0; }
.audio-paywall-plan-title { color: #273943; font-size: 23rpx; line-height: 1.4; font-weight: 700; }
.audio-paywall-plan-badge { margin-left: 9rpx; padding: 3rpx 8rpx; border-radius: 10rpx; background: #E8DDC8; color: #80653D; font-size: 16rpx; font-weight: 500; }
.audio-paywall-plan-desc { margin-top: 5rpx; color: #7B8589; font-size: 19rpx; line-height: 1.4; }
.audio-paywall-plan-price { flex: 0 0 auto; margin-left: 12rpx; color: #176AA7; font-size: 25rpx; line-height: 1; font-weight: 700; }
.audio-paywall-plan-price text { margin-left: 11rpx; color: #8EA5B0; font-size: 34rpx; font-weight: 400; vertical-align: -2rpx; }
.audio-paywall-loading,
.audio-paywall-empty { margin-top: 16rpx; padding: 24rpx 18rpx; border-radius: 15rpx; background: #FFFFFF; color: #758087; font-size: 21rpx; line-height: 1.5; text-align: center; }
.audio-paywall-footnote { margin-top: 15rpx; color: #9A9D9B; font-size: 17rpx; line-height: 1.4; text-align: center; }
.audio-paywall-later { margin-top: 18rpx; padding: 10rpx; color: #69757B; font-size: 21rpx; line-height: 1.4; text-align: center; }
