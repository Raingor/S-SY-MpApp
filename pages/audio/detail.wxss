page { height: 100%; background: #FFFFFF; }
.audio-experience-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #FFFFFF;
  color: #222222;
}
.audio-experience-nav {
  position: absolute;
  z-index: 3;
  right: 30rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  color: #1F1F1F;
  font-size: 26rpx;
  font-weight: 600;
}
.audio-back {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E1E1E1;
  border-radius: 50%;
  background: #FFFFFF;
}
.audio-back .sy-back-chevron {
  width: 16rpx;
  height: 16rpx;
  margin-left: 7rpx;
  border-left: 4rpx solid #222222;
  border-bottom: 4rpx solid #222222;
  transform: rotate(45deg);
}
.audio-nav-spacer { width: 58rpx; }
.audio-detail-scroll { flex: 1; min-height: 0; box-sizing: border-box; }
.audio-detail-content { padding: 20rpx 36rpx 430rpx; }
.audio-player-artwork {
  width: 88vw;
  height: 88vw;
  max-width: 670rpx;
  max-height: 670rpx;
  margin: 0 auto;
  overflow: hidden;
  background: #F5F5F5;
}
.audio-player-cover { display: block; width: 100%; height: 100%; }
.audio-cover-placeholder { display: flex; align-items: center; justify-content: center; }
.audio-wave-mark { position: relative; display: flex; align-items: center; justify-content: center; gap: 14rpx; width: 240rpx; height: 220rpx; }
.audio-wave-dot { position: absolute; top: 10rpx; left: 50%; width: 30rpx; height: 30rpx; margin-left: -15rpx; border-radius: 50%; background: #DEDEDE; }
.audio-wave-bar { width: 27rpx; border-radius: 16rpx; background: #DEDEDE; }
.audio-wave-bar-short { height: 96rpx; }
.audio-wave-bar-tall { height: 160rpx; margin-top: 55rpx; }
.audio-wave-bar-mid { height: 126rpx; margin-top: 24rpx; }
.audio-track-heading { margin: 30rpx 6rpx 0; }
.audio-track-title { overflow: hidden; color: #171717; font-size: 31rpx; line-height: 1.5; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.audio-track-subtitle { margin-top: 4rpx; color: #9A9A9A; font-size: 21rpx; }
.audio-point-tracks { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 18rpx 6rpx 0; }
.audio-track-option { padding: 10rpx 16rpx; border: 1rpx solid #E2E2E2; border-radius: 28rpx; background: #FFFFFF; color: #6C6C6C; font-size: 20rpx; }
.audio-selected { border-color: #333333; color: #222222; }
.audio-player-notice { margin: 18rpx 6rpx 0; color: #8A8A8A; font-size: 21rpx; line-height: 1.5; }
.audio-player-notice text { color: #236FA8; }
.audio-panel-loading { flex: 1; display: flex; align-items: center; justify-content: center; color: #8A8A8A; font-size: 24rpx; }
.audio-player-dock {
  position: absolute;
  z-index: 2;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 8rpx 48rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EEEEEE;
  background: rgba(255,255,255,.98);
}
.audio-player-slider { margin: 0; padding: 0; }
.audio-player-times { display: flex; align-items: center; justify-content: space-between; margin-top: -4rpx; color: #858585; font-size: 25rpx; }
.audio-speed-button { display: flex; align-items: baseline; gap: 7rpx; color: #222222; font-size: 26rpx; }
.audio-speed-label { color: #777777; font-size: 22rpx; }
.audio-player-controls { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; }
.audio-skip-control { flex: 0 0 60rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #222222; }
.audio-skip-icon { height: 45rpx; font-size: 42rpx; line-height: 1; }
.audio-skip-seconds { margin-top: -3rpx; font-size: 19rpx; line-height: 1; }
.audio-track-step { flex: 0 0 45rpx; color: #2A2A2A; font-size: 34rpx; text-align: center; }
.audio-track-step-disabled { color: #E4E4E4; }
.audio-round-control {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #E1E1E1;
  border-radius: 50%;
  background: #FFFFFF;
  color: #222222;
}
.audio-round-control text { margin-left: 8rpx; font-size: 48rpx; line-height: 1; }
.audio-player-actions { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; color: #777777; font-size: 20rpx; }
.audio-preview-caption { flex: 1; min-width: 0; }
.audio-full-action { max-width: 65%; color: #236FA8; text-align: right; }
.audio-full-action-disabled { color: #9A9A9A; }
.audio-preview-ended { margin-top: 12rpx; color: #8A8A8A; font-size: 20rpx; text-align: center; }
.audio-simulation { margin-top: 20rpx; color: #526777; font-size: 22rpx; }
.audio-simulation button { margin-top: 12rpx; }
