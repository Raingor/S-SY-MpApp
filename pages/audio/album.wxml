<view class="audio-page"><view class="audio-nav"><view class="sy-back-button" bindtap="onBack"><view class="sy-back-chevron"></view></view><text>{{i18n.heritage.history}}</text></view><view wx:if="{{loading}}" class="audio-card">{{i18n.loading}}</view><view wx:elif="{{album}}"><view class="audio-card"><image wx:if="{{album.cover}}" class="audio-cover" src="{{album.cover}}" mode="aspectFill"/><view class="audio-title">{{album.displayTitle}}</view><view class="audio-description">{{album.displayDescription}}</view><view class="audio-meta">{{episodes.length}} {{i18n.heritage.episodes}}<text wx:if="{{album.totalDuration}}"> · {{i18n.heritage.duration}} {{album.totalDuration}}</text></view></view><view wx:if="{{episodes.length}}" class="audio-card"><view wx:for="{{episodes}}" wx:key="id" class="audio-list-row" data-id="{{item.id}}" bindtap="onEpisodeTap"><view>{{index + 1}} · {{item.displayTitle}}<view class="audio-description">{{item.displayDescription}} <text wx:if="{{item.displayDuration}}">· {{item.displayDuration}}</text></view></view><text>›</text></view></view><view wx:else class="audio-card">{{i18n.heritage.noAudio}}</view></view><view wx:else class="audio-card">{{failed ? i18n.heritage.networkFailed : i18n.heritage.noAlbums}}</view></view>
