<view class="audio-experience-page">
  <view class="audio-experience-nav" style="top: {{statusBarHeight + 8}}px;">
    <view class="audio-back" bindtap="onBack"><view class="sy-back-chevron"></view></view>
    <text>{{i18n.brand}}</text>
    <view class="audio-nav-spacer"></view>
  </view>

  <scroll-view wx:if="{{!loading}}" class="audio-detail-scroll" scroll-y="true" style="padding-top: {{statusBarHeight + 100}}px;">
    <view class="audio-detail-content">
      <view class="audio-player-artwork">
        <image wx:if="{{cover}}" class="audio-player-cover" src="{{cover}}" mode="aspectFill" />
        <view wx:else class="audio-player-cover audio-cover-placeholder">
          <view class="audio-wave-mark"><view class="audio-wave-dot"></view><view class="audio-wave-bar audio-wave-bar-short"></view><view class="audio-wave-bar audio-wave-bar-tall"></view><view class="audio-wave-bar audio-wave-bar-mid"></view><view class="audio-wave-bar audio-wave-bar-short"></view></view>
        </view>
      </view>

      <view class="audio-track-heading">
        <view class="audio-track-title">{{title}}</view>
        <view wx:if="{{point.author || displayLocation}}" class="audio-track-subtitle">{{point.author || displayLocation}}</view>
      </view>

      <view wx:if="{{pointTracks.length > 1}}" class="audio-point-tracks">
        <view wx:for="{{pointTracks}}" wx:key="id" class="audio-track-option {{track.id === item.id ? 'audio-selected' : ''}}" data-id="{{item.id}}" bindtap="onPointTrackTap">{{item.displayTitle}}</view>
      </view>

      <view wx:if="{{demoMode}}" class="audio-player-notice">{{i18n.heritage.demoAudioPending}}</view>
      <view wx:elif="{{unavailable}}" class="audio-player-notice">{{i18n.heritage.noAudio}}</view>
      <view wx:elif="{{accessError}}" class="audio-player-notice">{{i18n.heritage.networkFailed}} <text bindtap="refreshAccess">{{i18n.heritage.retry}} ›</text></view>
      <view wx:if="{{pendingOrder && simulation}}" class="audio-simulation">
        <view>{{i18n.paidContent.simulationTitle}}</view>
        <button data-outcome="paid" bindtap="onSimulationPay">{{i18n.paidContent.simulationSuccess}}</button>
        <button data-outcome="failed" bindtap="onSimulationPay">{{i18n.paidContent.simulationFailure}}</button>
      </view>
    </view>
  </scroll-view>
  <view wx:else class="audio-panel-loading">{{i18n.loading}}</view>

  <view wx:if="{{!loading && !demoMode && !unavailable && !accessError && track && track.previewUrl}}" class="audio-player-dock">
    <slider class="audio-player-slider" min="0" max="{{durationSeconds || 1}}" value="{{currentSeconds}}" bindchange="onSeekChange" activeColor="#303030" backgroundColor="#E4E4E4" block-color="#222222" block-size="13" disabled="{{!access}}" />
    <view class="audio-player-times">
      <text>{{currentTime}}</text>
      <view class="audio-speed-button" bindtap="onSpeedTap"><text>{{playbackRate}}×</text><text class="audio-speed-label">{{i18n.heritage.speed}}</text></view>
      <text>-{{remainingTime}}</text>
    </view>
    <view class="audio-player-controls">
      <view class="audio-skip-control" data-offset="-15" bindtap="onSeekOffset"><text class="audio-skip-icon">↶</text><text class="audio-skip-seconds">15</text></view>
      <view class="audio-track-step audio-track-step-disabled"><text>◀|</text></view>
      <view class="audio-round-control" bindtap="onPlayerToggle"><text>{{audioLoading ? '…' : (playing ? 'Ⅱ' : '▶')}}</text></view>
      <view class="audio-track-step audio-track-step-disabled"><text>|▶</text></view>
      <view class="audio-skip-control" data-offset="30" bindtap="onSeekOffset"><text class="audio-skip-icon">↷</text><text class="audio-skip-seconds">30</text></view>
    </view>
    <view class="audio-player-actions">
      <text wx:if="{{access && access.access === 'full'}}" class="audio-preview-caption">{{i18n.heritage.fullAccess}}</text>
      <text wx:elif="{{track.unlockMode === 'free'}}" class="audio-preview-caption">{{i18n.heritage.freeBadge}}</text>
      <text wx:elif="{{track.unlockMode === 'locked'}}" class="audio-preview-caption">{{i18n.heritage.previewOnlyShort}}</text>
      <text wx:else class="audio-preview-caption">{{i18n.heritage.preview}} · {{track.previewSeconds || 60}}s</text>
      <button wx:if="{{track.unlockMode !== 'locked'}}" class="audio-full-action" hover-class="audio-full-action-hover" disabled="{{accessLoading || purchaseLoading}}" bindtap="onFullAccessTap">{{accessLoading ? i18n.loading : fullActionText}}</button>
      <view wx:else class="audio-full-action audio-full-action-disabled">{{i18n.heritage.previewOnly}}</view>
    </view>
  </view>

  <view wx:if="{{showUnlockPaywall}}" class="audio-paywall-mask" bindtap="onUnlockPaywallClose" catchtouchmove="noop">
    <view class="audio-paywall-sheet" catchtap="noop">
      <view class="audio-paywall-topbar">
        <view class="audio-paywall-handle"></view>
        <view class="audio-paywall-close" bindtap="onUnlockPaywallClose">×</view>
      </view>
      <view class="audio-paywall-eyebrow">{{i18n.paidContent.paywallEyebrow}}</view>
      <view class="audio-paywall-title">{{i18n.paidContent.paywallTitle}}</view>
      <view class="audio-paywall-subtitle">{{i18n.paidContent.paywallSubtitle}}</view>
      <view class="audio-paywall-feature">
        <view class="audio-paywall-feature-mark">✦</view>
        <view class="audio-paywall-feature-copy">
          <view class="audio-paywall-track-title">{{title}}</view>
          <view class="audio-paywall-feature-desc">{{i18n.paidContent.paywallFeature}}</view>
        </view>
      </view>
      <view wx:if="{{paywallAuthState === 'checking'}}" class="audio-paywall-auth-state">{{i18n.paidContent.paywallAuthChecking}}</view>
      <view wx:elif="{{paywallAuthState === 'login'}}" class="audio-paywall-auth-card">
        <view class="audio-paywall-auth-copy">
          <view class="audio-paywall-auth-title">{{i18n.paidContent.paywallLoginTitle}}</view>
          <view class="audio-paywall-auth-desc">{{i18n.paidContent.paywallLoginDesc}}</view>
        </view>
        <button class="audio-paywall-auth-button" bindtap="onPaywallLogin" loading="{{paywallAuthLoading}}" disabled="{{paywallAuthLoading}}">{{i18n.paidContent.paywallLoginButton}}</button>
        <view wx:if="{{paywallAuthError}}" class="audio-paywall-auth-error">{{paywallAuthError}}</view>
      </view>
      <view wx:elif="{{paywallAuthState === 'phone'}}" class="audio-paywall-auth-card">
        <view class="audio-paywall-auth-copy">
          <view class="audio-paywall-auth-title">{{i18n.paidContent.paywallPhoneTitle}}</view>
          <view class="audio-paywall-auth-desc">{{i18n.paidContent.paywallPhoneDesc}}</view>
        </view>
        <button class="audio-paywall-auth-button" open-type="getPhoneNumber" bindgetphonenumber="onPaywallGetPhoneNumber" loading="{{paywallAuthLoading}}" disabled="{{paywallAuthLoading}}">{{i18n.paidContent.paywallPhoneButton}}</button>
        <view wx:if="{{paywallAuthError}}" class="audio-paywall-auth-error">{{paywallAuthError}}</view>
      </view>
      <view wx:if="{{paywallLoading}}" class="audio-paywall-loading">{{i18n.paidContent.paywallPriceLoading}}</view>
      <view wx:elif="{{unlockOptions.length}}" class="audio-paywall-options">
        <view wx:for="{{unlockOptions}}" wx:key="product" class="audio-paywall-plan {{item.featured ? 'audio-paywall-plan-featured' : ''}}" data-product="{{item.product}}" bindtap="onUnlockOptionTap">
          <view class="audio-paywall-plan-copy">
            <view class="audio-paywall-plan-title">{{item.title}}<text wx:if="{{item.featured}}" class="audio-paywall-plan-badge">{{i18n.paidContent.paywallRecommended}}</text></view>
            <view class="audio-paywall-plan-desc">{{item.description}}</view>
          </view>
          <view class="audio-paywall-plan-price">{{item.priceDisplay}}<text>›</text></view>
        </view>
      </view>
      <view wx:elif="{{track.unlockMode === 'locked'}}" class="audio-paywall-empty">{{i18n.heritage.previewOnly}}</view>
      <view wx:else class="audio-paywall-empty">{{i18n.paidContent.paywallUnavailable}}</view>
      <view class="audio-paywall-footnote">{{i18n.paidContent.paywallFootnote}}</view>
      <view class="audio-paywall-later" bindtap="onUnlockPaywallClose">{{i18n.paidContent.paywallLater}}</view>
    </view>
  </view>
</view>
