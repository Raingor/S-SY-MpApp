<view class="audio-page"><view class="audio-nav"><view class="sy-back-button" bindtap="onBack"><view class="sy-back-chevron"></view></view><text>{{i18n.brand}}</text></view>
<view wx:if="{{loading}}" class="audio-card">{{i18n.loading}}</view>
<block wx:else><image wx:if="{{cover}}" class="audio-cover" src="{{cover}}" mode="aspectFill" /><view class="audio-card"><view class="audio-title">{{title}}</view><view wx:if="{{description}}" class="audio-description">{{description}}</view><view wx:if="{{track.language || duration}}" class="audio-meta">{{track.language}}<text wx:if="{{duration}}"> · {{i18n.heritage.duration}} {{duration}}</text></view><view wx:if="{{pointTracks.length > 1}}" class="audio-point-tracks"><view wx:for="{{pointTracks}}" wx:key="id" class="audio-track-option {{track.id === item.id ? 'audio-selected' : ''}}" data-id="{{item.id}}" bindtap="onPointTrackTap">{{item.displayTitle}}</view></view>
<view wx:if="{{unavailable}}" class="audio-notice">{{i18n.heritage.noAudio}}</view><view wx:elif="{{accessError}}" class="audio-notice">{{i18n.heritage.networkFailed}} <text bindtap="refreshAccess">{{i18n.heritage.retry}} ›</text></view><view wx:else>
  <view wx:if="{{access.previewUrl}}" class="audio-button" bindtap="playPreview">{{playing && !fullPlayback ? i18n.heritage.pause : i18n.heritage.preview}} ▶</view><view wx:if="{{previewEnded}}" class="audio-notice">{{i18n.heritage.previewEnded}}</view><view wx:if="{{playing}}" class="audio-notice">{{currentSeconds}}s {{fullPlayback ? i18n.heritage.full : i18n.heritage.preview}}</view>
  <view wx:if="{{access.fullUrl}}" class="audio-button audio-button-full" bindtap="playFull">{{playing && fullPlayback ? i18n.heritage.pause : i18n.heritage.full}} ▶</view><view wx:elif="{{access.previewUrl && (access.mode === 'attraction' || access.mode === 'membership')}}" class="audio-button audio-button-locked" bindtap="onUnlock">{{i18n.heritage.unlockRequired}} ›</view><view wx:elif="{{access.previewUrl}}" class="audio-notice">{{i18n.heritage.previewOnly}}</view>
</view><view wx:if="{{pendingOrder && simulation}}" class="audio-simulation"><view>{{i18n.paidContent.simulationTitle}}</view><button data-outcome="paid" bindtap="onSimulationPay">{{i18n.paidContent.simulationSuccess}}</button><button data-outcome="failed" bindtap="onSimulationPay">{{i18n.paidContent.simulationFailure}}</button></view></view></block></view>
