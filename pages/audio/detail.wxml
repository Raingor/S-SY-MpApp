<view class="audio-experience-page">
  <view class="audio-experience-hero"><image wx:if="{{cover}}" class="audio-experience-cover" src="{{cover}}" mode="aspectFill"/><view class="audio-experience-shade"></view><view class="audio-experience-nav"><view class="audio-back" bindtap="onBack"><view class="sy-back-chevron"></view></view><text>{{i18n.brand}}</text><view class="audio-nav-spacer"></view></view><view class="audio-experience-caption"><view class="audio-caption-kicker">{{demoMode ? i18n.heritage.demoData : (demoCategory === 'expert' ? i18n.heritage.expert : (demoCategory === 'route' ? i18n.heritage.routes : i18n.heritage.online))}}</view><view class="audio-experience-title">{{title}}</view><view wx:if="{{point.author}}" class="audio-experience-subtitle">{{point.author}}</view></view></view>
  <view wx:if="{{loading}}" class="audio-experience-panel audio-panel-loading">{{i18n.loading}}</view>
  <view wx:else class="audio-experience-panel">
    <block wx:if="{{demoMode}}"><view class="audio-panel-heading">{{demoCategory === 'expert' ? i18n.heritage.expert : (demoCategory === 'route' ? i18n.heritage.routes : i18n.heritage.online)}}</view><view wx:if="{{description}}" class="audio-experience-description">{{description}}</view><view wx:if="{{displayLocation}}" class="audio-experience-location">⌖ {{displayLocation}}</view><view class="audio-demo-notice">{{i18n.heritage.demoAudioPending}}</view></block>
    <block wx:else><view wx:if="{{description}}" class="audio-experience-description">{{description}}</view><view wx:if="{{track.language || duration}}" class="audio-experience-location">{{track.language}}<text wx:if="{{duration}}"> · {{i18n.heritage.duration}} {{duration}}</text></view><view wx:if="{{pointTracks.length > 1}}" class="audio-point-tracks"><view wx:for="{{pointTracks}}" wx:key="id" class="audio-track-option {{track.id === item.id ? 'audio-selected' : ''}}" data-id="{{item.id}}" bindtap="onPointTrackTap">{{item.displayTitle}}</view></view><view wx:if="{{unavailable}}" class="audio-demo-notice">{{i18n.heritage.noAudio}}</view><view wx:elif="{{accessError}}" class="audio-demo-notice">{{i18n.heritage.networkFailed}} <text bindtap="refreshAccess">{{i18n.heritage.retry}} ›</text></view><view wx:else><view class="audio-progress-row"><view class="audio-progress-track"><view class="audio-progress-fill" style="width: {{progressPercent}}%;"></view></view><text>{{currentSeconds}}s</text></view><view class="audio-controls"><view wx:if="{{access.previewUrl}}" class="audio-round-control" bindtap="playPreview">{{playing && !fullPlayback ? 'Ⅱ' : '▶'}}</view><view wx:if="{{access.previewUrl}}" class="audio-preview-control" bindtap="playPreview">{{playing && !fullPlayback ? i18n.heritage.pause : i18n.heritage.preview}} · {{access.previewSeconds}}s</view><view wx:if="{{access.fullUrl}}" class="audio-full-control" bindtap="playFull">{{playing && fullPlayback ? i18n.heritage.pause : i18n.heritage.full}}</view><view wx:elif="{{access.previewUrl && (access.mode === 'attraction' || access.mode === 'membership')}}" class="audio-full-control audio-control-locked" bindtap="onUnlock">{{i18n.heritage.unlockRequired}}</view><view wx:elif="{{access.previewUrl}}" class="audio-full-control audio-control-locked">{{i18n.heritage.previewOnly}}</view></view><view wx:if="{{previewEnded}}" class="audio-demo-notice">{{i18n.heritage.previewEnded}}</view></view><view wx:if="{{pendingOrder && simulation}}" class="audio-simulation"><view>{{i18n.paidContent.simulationTitle}}</view><button data-outcome="paid" bindtap="onSimulationPay">{{i18n.paidContent.simulationSuccess}}</button><button data-outcome="failed" bindtap="onSimulationPay">{{i18n.paidContent.simulationFailure}}</button></view></block>
  </view>
</view>
