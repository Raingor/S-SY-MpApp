<view class="audio-page"><view class="audio-nav"><view class="sy-back-button" bindtap="onBack"><view class="sy-back-chevron"></view></view><text>{{i18n.heritage.routes}}</text></view><view wx:if="{{loading}}" class="audio-card">{{i18n.loading}}</view><view wx:else class="audio-card"><view class="audio-title">{{title || i18n.heritage.routes}}</view><view wx:if="{{points.length}}"><view wx:for="{{points}}" wx:key="id" class="audio-list-row" data-id="{{item.id}}" bindtap="onPointTap"><view>{{index + 1}} · {{item.displayName}}<view class="audio-description">{{item.displayDescription}}</view></view><text>›</text></view></view><view wx:else class="audio-notice">{{failed ? i18n.heritage.networkFailed : i18n.heritage.noRoutes}}</view></view></view>
