<view class="route-detail-page">
  <view class="route-detail-nav"><view class="sy-back-button" bindtap="onBack"><view class="sy-back-chevron"></view></view><view class="route-detail-nav-title">{{i18n.heritage.routes}}</view><view class="route-detail-nav-space"></view></view>
  <view wx:if="{{loading}}" class="route-detail-empty">{{i18n.loading}}</view>
  <view wx:elif="{{!title}}" class="route-detail-empty">{{failed ? i18n.heritage.networkFailed : i18n.heritage.noRoutes}}</view>
  <block wx:else>
    <view class="route-detail-hero"><image wx:if="{{coverImage}}" class="route-detail-hero-image" src="{{coverImage}}" mode="aspectFill"/><view class="route-detail-hero-shade"></view><view class="route-detail-hero-copy"><view wx:if="{{isDemo}}" class="route-detail-demo">{{i18n.heritage.demoData}}</view><view class="route-detail-title">{{title}}</view><view class="route-detail-hero-subtitle">{{i18n.heritage.routes}}</view></view></view>
    <view class="route-detail-body">
      <view class="route-detail-description">{{description}}</view>
      <view id="route-map" class="route-map-card"><view class="route-map-head"><view><view class="route-map-eyebrow">ROUTE MAP</view><view class="route-map-title">{{i18n.heritage.routeOrderMap}}</view></view><text class="route-map-compass">N ↑</text></view><image wx:if="{{mapImage}}" class="route-map-image" src="{{mapImage}}" mode="aspectFill"/><view class="route-map-flow"><view wx:for="{{points}}" wx:key="id" class="route-map-step"><view class="route-map-node">{{index + 1}}</view><view class="route-map-step-copy"><view class="route-map-point-name">{{item.displayName}}</view><view wx:if="{{item.displayLocation}}" class="route-map-point-location">{{item.displayLocation}}</view></view><text wx:if="{{index < points.length - 1}}" class="route-map-arrow">↓</text></view></view></view>
      <view class="route-point-section"><view class="route-point-heading">{{i18n.heritage.routes}} · {{points.length}}</view><view wx:for="{{points}}" wx:key="id" class="route-point-card" data-id="{{item.id}}" bindtap="onPointTap"><view class="route-point-number">0{{index + 1}}</view><image wx:if="{{item.image || coverImage}}" class="route-point-image" src="{{item.image || coverImage}}" mode="aspectFill"/><view class="route-point-copy"><view class="route-point-name">{{item.displayName}}</view><view wx:if="{{item.displayDescription}}" class="route-point-description">{{item.displayDescription}}</view></view><text class="route-point-arrow">›</text></view></view>
    </view>
    <view class="route-detail-bottom"><view class="route-detail-duration">{{durationLabel || i18n.heritage.routeDetails}}</view><view class="route-detail-open-map" bindtap="onMapTap">{{i18n.heritage.openMap}} ›</view></view>
  </block>
</view>
