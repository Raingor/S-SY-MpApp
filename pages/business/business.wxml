<view class="consult-page">
  <view class="consult-hero business-hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="consult-nav sy-nav">
      <view class="consult-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="consult-brand">SY 希旅人</view>
      <view class="consult-mark">✦</view>
    </view>
    <view class="consult-hero-body">
      <view class="consult-kicker">GREECE BUSINESS COMPANION</view>
      <view class="consult-title serif">{{i18n.businessTitle}}<br />{{i18n.businessSubtitle}}</view>
      <view class="consult-subtitle">{{i18n.businessDescription}}</view>
      <view class="consult-tag-row">
        <view class="consult-tag">{{i18n.businessTag1}}</view>
        <view class="consult-tag">{{i18n.businessTag2}}</view>
        <view class="consult-tag">{{i18n.businessTag3}}</view>
      </view>
    </view>
  </view>

  <view class="consult-card">
    <view class="consult-card-title serif">{{i18n.forms.businessTitle}}</view>
    <view class="consult-card-tip">{{i18n.forms.businessTip}}</view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.businessCycle}}</view>
      <view class="consult-options">
        <view wx:for="{{cycleOptions}}" wx:key="*this" class="consult-option {{form.cycle === item ? 'consult-option-on' : ''}}" data-field="cycle" data-value="{{item}}" bindtap="onOptionTap">{{item}}</view>
      </view>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.companionDuration}}</view>
      <view class="consult-options">
        <view wx:for="{{durationOptions}}" wx:key="*this" class="consult-option {{form.duration === item ? 'consult-option-on' : ''}}" data-field="duration" data-value="{{item}}" bindtap="onOptionTap">{{item}}</view>
      </view>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.languageNeeds}}</view>
      <view class="consult-options">
        <view wx:for="{{languageOptions}}" wx:key="*this" class="consult-option {{form.languageNeeds === item ? 'consult-option-on' : ''}}" data-field="languageNeeds" data-value="{{item}}" bindtap="onOptionTap">{{item}}</view>
      </view>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.industryNeeds}} <text>{{i18n.forms.industryRequired}}</text></view>
      <textarea class="consult-textarea" maxlength="300" placeholder="{{i18n.forms.industryPlaceholder}}" placeholder-class="consult-placeholder" value="{{form.industryNeeds}}" data-field="industryNeeds" bindinput="onInput"></textarea>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.people}}</view>
      <picker range="{{peopleOptions}}" value="0" bindchange="onPeopleChange">
        <view class="consult-picker">{{form.people}}<text>⌄</text></view>
      </picker>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.contactMethod}} <text>{{i18n.forms.contactChoose}}</text></view>
      <view class="consult-contact-switch">
        <view class="consult-contact-type {{form.contactType === 'wechat' ? 'consult-contact-on' : ''}}" data-type="wechat" bindtap="onContactTypeTap">{{i18n.forms.wechat}}</view>
        <view class="consult-contact-type {{form.contactType === 'phone' ? 'consult-contact-on' : ''}}" data-type="phone" bindtap="onContactTypeTap">{{i18n.profile.phone}}</view>
      </view>
      <input class="consult-input" type="{{form.contactType === 'phone' ? 'number' : 'text'}}" maxlength="{{form.contactType === 'phone' ? 11 : 40}}" placeholder="{{form.contactType === 'phone' ? i18n.forms.phonePlaceholderShort : i18n.forms.wechatPlaceholder}}" placeholder-class="consult-placeholder" value="{{form.contact}}" data-field="contact" bindinput="onInput" />
    </view>

    <button class="consult-submit" hover-class="consult-submit-hover" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? i18n.submitting : i18n.forms.submitBusiness}}</button>
    <view class="consult-note">{{i18n.businessNote}}</view>
  </view>
  <view class="consult-footer">{{i18n.commonSlogan}}</view>
</view>
