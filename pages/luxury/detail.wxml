<view class="lux-detail-page" wx:if="{{detail}}">
  <view class="lux-hero">
    <image class="lux-hero-image" src="{{detail.image}}" mode="aspectFill" />
    <view class="lux-hero-mask"></view>
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="lux-nav sy-nav">
      <view class="lux-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="lux-brand">{{i18n.brand}}</view>
      <view class="lux-mark">✦</view>
    </view>
    <view class="lux-hero-body">
      <view class="lux-kicker">{{detail.eyebrow}}</view>
      <view class="lux-title serif">{{detail.title}}</view>
      <view class="lux-intro">{{detail.intro}}</view>
    </view>
  </view>

  <view class="lux-content">
    <view class="lux-section card" wx:for="{{detail.sections}}" wx:key="title">
      <view class="lux-section-index">0{{index + 1}}</view>
      <view class="lux-section-title serif">{{item.title}}</view>
      <view class="lux-list">
        <view class="lux-list-item" wx:for="{{item.items}}" wx:key="*this">
          <view class="lux-list-dot"></view>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="lux-note">
      <view class="lux-note-mark">i</view>
      <view>{{detail.note}}</view>
    </view>

    <view class="consultant card">
      <view class="consultant-top" bindtap="onCopyWechat">
        <image class="consultant-avatar" src="{{consultant.avatar}}" mode="aspectFill" />
        <view class="consultant-info">
          <view class="consultant-name">{{i18n.forms.consultantTitle}} · {{consultant.name}}</view>
          <view class="consultant-title">{{consultant.title}}</view>
          <view class="consultant-slogan">{{consultant.slogan}}</view>
          <view class="consultant-wechat">{{i18n.forms.wechatId}}：{{consultant.wechat}}（{{i18n.forms.tapToCopy}}）</view>
        </view>
      </view>
      <view class="consultant-qr" bindtap="onPreviewQr">
        <image class="qr-img" src="{{consultant.qr}}" mode="aspectFit" />
        <view class="qr-tip">{{i18n.forms.qrTip}}</view>
      </view>
    </view>

    <view class="phone-row" bindtap="onCallPhone">
      <text>{{i18n.forms.phone}}：{{consultant.phone}}</text>
      <text class="phone-arrow">{{i18n.forms.call}} ›</text>
    </view>
  </view>
  <view class="lux-footer">{{i18n.brandEn}} · {{i18n.commonSlogan}}</view>
</view>
