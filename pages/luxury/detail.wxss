.lux-detail-page { min-height: 100vh; padding-bottom: 72rpx; background: #F4F7FA; color: #16283A; }
.lux-hero { position: relative; height: 610rpx; overflow: hidden; color: #FFFFFF; }
.lux-hero-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.lux-hero-mask { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 31, 52, .36) 0%, rgba(7, 31, 52, .16) 36%, rgba(7, 31, 52, .9) 100%); }
.lux-nav { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; height: 82rpx; padding: 0 24rpx; box-sizing: border-box; }
.lux-brand { max-width: 360rpx; overflow: hidden; color: rgba(255,255,255,.88); font-size: 27rpx; font-weight: 600; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.lux-mark { color: #D8B878; font-size: 27rpx; }
.lux-hero-body { position: absolute; z-index: 1; right: 38rpx; bottom: 46rpx; left: 38rpx; }
.lux-kicker, .lux-cta-kicker { color: #E2C47F; font-size: 19rpx; letter-spacing: 3rpx; }
.lux-title { margin-top: 12rpx; font-size: 52rpx; line-height: 1.24; text-shadow: 0 4rpx 18rpx rgba(7,31,52,.45); }
.lux-intro { margin-top: 16rpx; color: rgba(255,255,255,.88); font-size: 28rpx; line-height: 1.65; }
.lux-content { padding: 30rpx 32rpx 0; }
.lux-section { position: relative; margin-top: 22rpx; padding: 30rpx 30rpx 28rpx 78rpx; overflow: hidden; box-shadow: 0 14rpx 32rpx rgba(11,60,93,.06); }
.lux-section-index { position: absolute; top: 30rpx; left: 28rpx; color: #C6A15B; font-family: Georgia, serif; font-size: 25rpx; font-weight: 700; }
.lux-section-title { color: #0B3C5D; font-size: 35rpx; line-height: 1.35; }
.lux-list { margin-top: 16rpx; }
.lux-list-item { display: flex; align-items: flex-start; margin-top: 12rpx; color: #5B6B7A; font-size: 27rpx; line-height: 1.65; }
.lux-list-dot { width: 8rpx; height: 8rpx; flex-shrink: 0; margin: 17rpx 14rpx 0 0; border-radius: 50%; background: #C6A15B; }
.lux-note { display: flex; gap: 14rpx; margin: 22rpx 0 0; padding: 22rpx 24rpx; border-radius: 22rpx; background: #EEF4F7; color: #668093; font-size: 24rpx; line-height: 1.65; }
.lux-note-mark { width: 28rpx; height: 28rpx; flex-shrink: 0; border: 1rpx solid #7290A4; border-radius: 50%; box-sizing: border-box; color: #4D718A; font-family: Georgia, serif; font-size: 20rpx; font-style: italic; line-height: 28rpx; text-align: center; }
.lux-cta { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 30rpx; border-radius: 28rpx; background: linear-gradient(135deg, #092B43, #1567A8); color: #FFFFFF; box-shadow: 0 16rpx 30rpx rgba(11,60,93,.17); }
.lux-cta-press { opacity: .9; transform: scale(.99); }
.lux-cta-title { margin-top: 9rpx; font-size: 34rpx; }
.lux-cta-arrow { color: #E2C47F; font-size: 52rpx; font-weight: 200; }
.lux-footer { margin-top: 44rpx; color: #8AA3B5; font-size: 20rpx; letter-spacing: 1rpx; text-align: center; }
