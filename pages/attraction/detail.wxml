<view class="spot-page" wx:if="{{spot}}">
  <!-- 头图 -->
  <view class="spot-hero">
    <image class="spot-hero-img" src="{{spot.image}}" mode="aspectFill" />
    <view class="spot-hero-mask"></view>
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="spot-nav sy-nav">
      <view class="spot-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="spot-brand">{{i18n.brand}}</view>
      <view class="spot-mark">✦</view>
    </view>
    <view class="spot-hero-body">
      <view class="spot-cat">{{spot.category}}</view>
      <view class="spot-title serif">{{spot.name}}</view>
      <view class="spot-en">{{spot.en}}</view>
    </view>
  </view>

  <!-- 简介 -->
  <view class="spot-section card">
    <view class="spot-kicker">ABOUT</view>
    <view class="spot-heading serif">{{i18n.contentPage.about}}</view>
    <view class="spot-intro">{{spot.summary}}</view>
  </view>

  <!-- 必看亮点 -->
  <view class="spot-section card">
    <view class="spot-kicker">HIGHLIGHTS</view>
    <view class="spot-heading serif">{{i18n.contentPage.highlights}}</view>
    <view class="highlight-list">
      <block wx:for="{{spot.highlights}}" wx:key="name">
        <view wx:if="{{showAllHighlights || index < 3}}" class="highlight-item">
          <image class="highlight-img" src="{{spot.image}}" mode="aspectFill" />
          <view class="highlight-body">
            <view class="highlight-name">{{item.name}}</view>
            <view class="highlight-desc">{{item.desc}}</view>
          </view>
        </view>
      </block>
    </view>
    <view class="highlight-more" bindtap="onToggleHighlights">
      {{showAllHighlights ? i18n.contentPage.collapseHighlights : i18n.contentPage.allHighlights + spot.highlights.length + (locale === 'en' ? ' highlights' : '个亮点')}} <text>›</text>
    </view>
  </view>

  <!-- 参观指南 -->
  <view class="spot-section card">
    <view class="spot-kicker">VISITOR GUIDE</view>
    <view class="spot-heading serif">{{i18n.contentPage.visitorGuide}}</view>
    <scroll-view class="guide-scroll" scroll-x>
      <view
        wx:for="{{guideTabs}}"
        wx:key="key"
        class="guide-tab {{guideIndex === index ? 'guide-tab-on' : ''}}"
        data-index="{{index}}"
        bindtap="onGuideTap"
      >{{item.label}}</view>
    </scroll-view>
    <view class="guide-panel">
      <view class="guide-label">{{guideTabs[guideIndex].label}}</view>
      <view class="guide-text">{{guideTabs[guideIndex].text}}</view>
    </view>
  </view>

  <!-- 视频讲解与试看权限 -->
  <view class="spot-section card paid-video-section">
    <view class="spot-kicker">VIDEO GUIDE</view>
    <view class="spot-heading serif">{{i18n.paidContent.video}}</view>
    <view class="video-shell">
      <video wx:if="{{spot.videoUrl}}" id="knowledge-video" src="{{spot.videoUrl}}" controls object-fit="contain" bindplay="onVideoPlay" bindtimeupdate="onVideoTimeUpdate" binderror="onVideoError"></video>
      <view wx:else class="video-empty"><view class="video-empty-icon">▶</view><view>{{i18n.paidContent.trialUnavailable}}</view></view>
      <view wx:if="{{!isVideoUnlocked && paidConfig.configured && !trialEnded}}" class="trial-badge">{{i18n.paidContent.trial}} {{paidConfig.trialSeconds}}s</view>
      <view wx:if="{{isVideoUnlocked}}" class="unlock-badge">{{entitlements.member ? i18n.paidContent.memberUnlocked : i18n.paidContent.purchased}}</view>
    </view>
    <view class="video-status" wx:if="{{!isVideoUnlocked}}">{{trialLabel}}</view>
    <view class="preview-label"><text>FREE TEXT</text> {{i18n.paidContent.freeText}}</view>
    <view class="preview-copy">{{spot.deepDive.preview}}</view>
    <view class="locked-list"><view wx:for="{{spot.deepDive.locked}}" wx:key="*this"><text>▧</text>{{item}}<text class="lock-mark">{{isVideoUnlocked ? '' : i18n.contentPage.locked}}</text></view></view>
    <view class="unlock-button" bindtap="onUnlock">{{isVideoUnlocked ? i18n.paidContent.memberUnlocked : i18n.paidContent.unlock}}</view>
  </view>

  <view class="spot-section card related-section" wx:if="{{related.length}}"><view class="spot-kicker">RELATED</view><view class="spot-heading serif">{{i18n.paidContent.related}}</view><view class="related-list"><view wx:for="{{related}}" wx:key="id" class="related-item" data-id="{{item.id}}" bindtap="onRelatedTap"><image src="{{item.image}}" mode="aspectFill"/><view><view class="related-name">{{item.name}}</view><view class="related-desc">{{item.summary}}</view></view><text>›</text></view></view></view>

  <!-- 咨询入口 -->
  <view class="spot-consult card" bindtap="onLiveBooking">
    <view>
      <view class="consult-kicker">ONE-TO-ONE HUMANITIES CONSULTATION</view>
      <view class="consult-title serif">{{i18n.contentPage.consultTitle}}</view>
      <view class="consult-copy">{{i18n.contentPage.consultDesc}}</view>
    </view>
    <view class="consult-arrow">›</view>
  </view>

  <view class="spot-footer">{{i18n.commonSlogan}}</view>
</view>

<view wx:if="{{!spot}}" class="spot-empty">
  <view class="spot-empty-title">{{i18n.contentPage.attractionEmpty}}</view>
  <view class="spot-empty-desc">{{i18n.contentPage.attractionEmptyDesc}}</view>
  <view class="spot-empty-action" bindtap="onBackToDestinations">{{i18n.contentPage.backToDestinations}}</view>
</view>

<view wx:if="{{showPurchaseModal}}" class="purchase-overlay"><view class="purchase-modal card"><view class="purchase-close" bindtap="closePurchase">×</view><view class="spot-kicker">UNLOCK YOUR GREECE</view><view class="purchase-title serif">{{i18n.paidContent.trialEnded}}</view><view class="purchase-copy">{{i18n.paidContent.trialEndedDesc}}</view><button wx:if="{{!pendingSimulationOrder}}" class="purchase-option" data-product="attraction" bindtap="onPurchase" loading="{{purchaseLoading}}"><view>{{i18n.paidContent.buySpot}} <text class="purchase-price">¥{{paidConfig.products.attraction.price}}</text></view><text>{{i18n.paidContent.buySpotDesc}}</text></button><button wx:if="{{!pendingSimulationOrder}}" class="purchase-option purchase-option-featured" data-product="membership" bindtap="onPurchase" loading="{{purchaseLoading}}"><view>{{i18n.paidContent.member}} <text class="purchase-price">¥{{paidConfig.products.membership.price}}</text></view><text>{{i18n.paidContent.memberDesc}}</text></button><view wx:if="{{pendingSimulationOrder && simulationMode}}" class="simulation-box"><view class="simulation-label">{{i18n.paidContent.simulationTitle}}</view><view class="simulation-order">{{pendingSimulationOrder.id}}</view><button class="purchase-option" data-outcome="paid" bindtap="onSimulationPay" loading="{{simulationLoading}}">{{i18n.paidContent.simulationSuccess}}</button><button class="purchase-option simulation-failed-option" data-outcome="failed" bindtap="onSimulationPay" loading="{{simulationLoading}}">{{i18n.paidContent.simulationFailure}}</button></view></view></view>
