<view class="spot-page" wx:if="{{spot}}">
  <view class="spot-hero">
    <image wx:if="{{spot.image}}" class="spot-hero-img" src="{{spot.image}}" mode="aspectFill" />
    <view class="spot-hero-shade"></view>
    <view class="spot-top-inset" style="height: {{statusBarHeight}}px;"></view>
    <view class="spot-nav"><view class="spot-back" bindtap="onBack" aria-label="{{i18n.back}}"><view class="sy-back-chevron"></view></view><view class="spot-nav-title">{{i18n.guideService}}</view><view class="spot-nav-space"></view></view>
    <view class="spot-hero-copy"><view wx:if="{{spot.category}}" class="spot-category">{{spot.category}}</view><view class="spot-title serif">{{spot.name}}</view><view wx:if="{{spot.en}}" class="spot-native">{{spot.en}}</view></view>
  </view>

  <view class="detail-content">
    <view id="section-overview" class="detail-intro-block"><view class="detail-eyebrow">{{i18n.contentPage.about}}</view><view wx:if="{{spot.summary}}" class="spot-intro">{{spot.summary}}</view><view wx:else class="detail-muted">{{i18n.heritage.updatePending}}</view><view wx:if="{{spot.summaryIsDemo}}" class="demo-data-note">{{i18n.heritage.demoData}}</view></view>

    <view id="section-visit" class="detail-section"><view class="detail-section-head"><view><view class="detail-eyebrow">VISIT THE MUSEUM</view><view class="detail-heading serif">{{i18n.heritage.visitor}}</view></view><text class="detail-heading-mark">⌖</text></view>
      <view class="visitor-section-grid"><view wx:for="{{visitorSections}}" wx:key="kind" class="visitor-section-card" data-kind="{{item.kind}}" hover-class="visitor-section-card-pressed" bindtap="onVisitorSectionTap"><view class="visit-tile-head"><text class="visit-icon">{{item.icon}}</text><text class="visit-label">{{item.displayTitle}}</text></view></view></view>
      <view class="detail-caveat">{{i18n.heritage.officialNotice}}</view>
    </view>

    <view id="section-highlights" class="detail-section"><view class="detail-section-head"><view><view class="detail-eyebrow">MUST-SEE</view><view class="detail-heading serif">{{i18n.heritage.highlights}}</view></view><view wx:if="{{spot.highlights.length > 3}}" class="detail-more" bindtap="onToggleHighlights">{{showAllHighlights ? i18n.contentPage.collapseHighlights : i18n.contentPage.allHighlights}} ›</view></view>
      <view wx:if="{{!spot.highlights.length}}" class="detail-empty-note">{{i18n.heritage.updatePending}}</view>
      <scroll-view wx:elif="{{!showAllHighlights}}" class="highlight-rail" scroll-x="true" show-scrollbar="false"><view wx:for="{{spot.highlights}}" wx:key="name" wx:if="{{index < 3}}" class="highlight-card" data-index="{{index}}" bindtap="onHighlightTap"><image wx:if="{{item.image}}" class="highlight-card-image" src="{{item.image}}" mode="aspectFill"/><view class="highlight-card-copy"><view class="highlight-name">{{item.displayName}}</view><view wx:if="{{item.displayDesc}}" class="highlight-desc">{{item.displayDesc}}</view></view></view></scroll-view>
      <view wx:else class="highlight-grid"><view wx:for="{{spot.highlights}}" wx:key="name" class="highlight-card" data-index="{{index}}" bindtap="onHighlightTap"><image wx:if="{{item.image}}" class="highlight-card-image" src="{{item.image}}" mode="aspectFill"/><view class="highlight-card-copy"><view class="highlight-name">{{item.displayName}}</view><view wx:if="{{item.displayDesc}}" class="highlight-desc">{{item.displayDesc}}</view></view></view></view>
    </view>

    <view id="section-audio-how" class="detail-section"><view class="detail-section-head"><view><view class="detail-eyebrow">AUDIO GUIDE</view><view class="detail-heading serif">{{i18n.heritage.audioGuideUsage}}</view></view><text class="detail-heading-mark">♫</text></view>
      <view class="audio-how-card"><view class="audio-how-step"><text>01</text><view>{{i18n.heritage.routeStep}}</view></view><view class="audio-how-step"><text>02</text><view>{{i18n.heritage.onlineStep}}</view></view><view class="audio-how-step"><text>03</text><view>{{i18n.heritage.expertStep}}</view></view><view class="audio-how-note">{{i18n.heritage.previewStep}}</view></view>
    </view>

    <view id="section-routes" class="detail-section"><view class="detail-section-head"><view><view class="detail-eyebrow">ROUTE GUIDE</view><view class="detail-heading serif">{{i18n.heritage.routes}}</view></view><text class="detail-heading-mark">⌁</text></view>
      <view wx:if="{{!routes.length}}" class="detail-empty-note">{{i18n.heritage.noRoutes}}</view>
      <view wx:else class="route-list route-reference-list"><view wx:for="{{routes}}" wx:key="id" class="route-reference-card" data-id="{{item.id}}" bindtap="onRouteTap"><image wx:if="{{item.displayImage}}" class="route-reference-image" src="{{item.displayImage}}" mode="aspectFill"/><view class="route-reference-shade"></view><view class="route-reference-copy"><view wx:if="{{item.isDemo}}" class="demo-pill">{{i18n.heritage.demoData}}</view><view class="route-reference-title">{{item.displayTitle}}</view><view class="route-reference-description">{{item.displayDescription}}</view><view class="route-reference-footer"><text>{{item.durationLabel || i18n.heritage.routeDetails}}</text><text class="route-reference-cta">{{i18n.heritage.routeDetails}} ›</text></view></view></view></view>
    </view>

    <view id="section-online" class="detail-section"><view class="detail-section-head"><view><view class="detail-eyebrow">ONLINE PREVIEW</view><view class="detail-heading serif">{{i18n.heritage.onlinePreview}}</view></view></view>
      <view class="guide-entry-card" data-category="online" bindtap="onGuideCollectionTap"><image wx:if="{{spot.image}}" class="guide-entry-image" src="{{spot.image}}" mode="aspectFill"/><view class="guide-entry-shade"></view><view class="guide-entry-icon">◎</view><view class="audio-preview-tag">{{i18n.heritage.preview}}</view><view class="guide-entry-copy"><view class="guide-entry-title">{{i18n.heritage.online}}</view><view class="guide-entry-desc">{{onlineGuides.length ? i18n.heritage.onlineStep : i18n.heritage.noAudio}}</view><view wx:if="{{onlineDemo}}" class="demo-data-note">{{i18n.heritage.demoData}}</view><view class="guide-entry-cta">{{i18n.heritage.viewGuidePoints}} ›</view></view></view>
    </view>

    <view id="section-expert" class="detail-section"><view class="detail-section-head"><view><view class="detail-eyebrow">EXPERT GUIDE</view><view class="detail-heading serif">{{i18n.heritage.expert}}</view></view></view>
      <view class="guide-entry-card" data-category="expert" bindtap="onGuideCollectionTap"><image wx:if="{{spot.image}}" class="guide-entry-image" src="{{spot.image}}" mode="aspectFill"/><view class="guide-entry-shade"></view><view class="guide-entry-icon">✦</view><view class="audio-preview-tag">{{i18n.heritage.preview}}</view><view class="guide-entry-copy"><view class="guide-entry-title">{{i18n.heritage.expert}}</view><view class="guide-entry-desc">{{expertGuides.length ? i18n.heritage.expertStep : i18n.heritage.noAudio}}</view><view wx:if="{{expertDemo}}" class="demo-data-note">{{i18n.heritage.demoData}}</view><view class="guide-entry-cta">{{i18n.heritage.viewGuidePoints}} ›</view></view></view>
    </view>

    <view wx:if="{{spot.videoUrl}}" id="section-video" class="detail-section"><view class="detail-section-head"><view><view class="detail-eyebrow">VIDEO</view><view class="detail-heading serif">{{i18n.paidContent.video}}</view></view></view><view class="video-shell"><video id="knowledge-video" src="{{spot.videoUrl}}" controls object-fit="contain" bindplay="onVideoPlay" bindtimeupdate="onVideoTimeUpdate" binderror="onVideoError"></video></view><view class="video-status">{{trialLabel}}</view><view wx:if="{{!isVideoUnlocked && paidConfig.configured}}" class="unlock-button" bindtap="onUnlock">{{i18n.paidContent.unlock}}</view></view>

    <view wx:if="{{related.length}}" class="detail-section related-section"><view class="detail-section-head"><view><view class="detail-eyebrow">NEARBY</view><view class="detail-heading serif">{{i18n.paidContent.related}}</view></view></view><view wx:for="{{related}}" wx:key="id" class="related-item" data-id="{{item.id}}" bindtap="onRelatedTap"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><view class="related-name">{{item.name}}</view><text>›</text></view></view>
  </view>
</view>
<view wx:if="{{!spot}}" class="spot-empty"><view class="spot-empty-title">{{contentError ? i18n.heritage.networkFailed : i18n.contentPage.attractionEmpty}}</view><view class="spot-empty-desc">{{i18n.contentPage.attractionEmptyDesc}}</view><view class="spot-empty-action" bindtap="onBackToDestinations">{{i18n.contentPage.backToDestinations}}</view></view>
<view wx:if="{{highlightPreview}}" class="highlight-preview-overlay" bindtap="onCloseHighlightPreview"><view class="highlight-preview-modal" catchtap="onPreviewPanelTap"><view class="highlight-preview-close" catchtap="onCloseHighlightPreview">×</view><scroll-view class="highlight-preview-scroll" scroll-y="true"><image wx:if="{{highlightPreview.image}}" class="highlight-preview-image" src="{{highlightPreview.image}}" mode="aspectFit" data-src="{{highlightPreview.image}}" bindtap="onPreviewHighlightImage" /><view class="highlight-preview-title">{{highlightPreview.displayName}}</view><view wx:if="{{highlightPreview.displayDesc}}" class="highlight-preview-desc">{{highlightPreview.displayDesc}}</view><view wx:if="{{highlightPreview.hasTarget}}" class="highlight-preview-link" catchtap="onHighlightOnlineTap">{{i18n.heritage.online}} ›</view></scroll-view></view></view>
<view wx:if="{{showPurchaseModal}}" class="purchase-overlay"><view class="purchase-modal"><view class="purchase-close" bindtap="closePurchase">×</view><view class="detail-eyebrow">{{spot.name}}</view><view class="purchase-title serif">{{i18n.paidContent.trialEnded}}</view><view class="purchase-copy">{{i18n.paidContent.trialEndedDesc}}</view><button wx:if="{{!pendingSimulationOrder && paidConfig.products.attraction}}" class="purchase-option" data-product="attraction" bindtap="onPurchase" loading="{{purchaseLoading}}">{{i18n.paidContent.buySpot}} ¥{{paidConfig.products.attraction.price}}</button><button wx:if="{{!pendingSimulationOrder && paidConfig.products.membership}}" class="purchase-option" data-product="membership" bindtap="onPurchase" loading="{{purchaseLoading}}">{{i18n.paidContent.member}} ¥{{paidConfig.products.membership.price}}</button><view wx:if="{{pendingSimulationOrder && simulationMode}}" class="simulation-box"><view class="simulation-label">{{i18n.paidContent.simulationTitle}}</view><button data-outcome="paid" bindtap="onSimulationPay">{{i18n.paidContent.simulationSuccess}}</button><button data-outcome="failed" bindtap="onSimulationPay">{{i18n.paidContent.simulationFailure}}</button></view></view></view>
