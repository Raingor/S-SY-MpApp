/* Louvre-inspired night-gallery direction: charcoal canvas, quiet silver rules, electric-blue navigation. */
page { background: #111214; }
.spot-page { min-height: 100vh; padding-bottom: 72rpx; box-sizing: border-box; background: #111214; color: #f4f2ed; }
.spot-hero { position: relative; height: 630rpx; overflow: hidden; background: #191a1d; color: #fff; }
.spot-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.spot-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,9,11,.54) 0%, rgba(8,9,11,.02) 34%, rgba(8,9,11,.20) 58%, rgba(8,9,11,.92) 100%); }
.spot-top-inset { position: relative; z-index: 2; }
.spot-nav { position: relative; z-index: 2; height: 88rpx; padding: 0 32rpx; display: flex; align-items: center; justify-content: space-between; }
.spot-back { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(17,18,20,.56); border: 1rpx solid rgba(255,255,255,.28); }
.spot-back .sy-back-chevron { width: 18rpx; height: 18rpx; border-left: 4rpx solid #fff; border-bottom: 4rpx solid #fff; transform: rotate(45deg); margin-left: 8rpx; }
.spot-nav-title { color: rgba(255,255,255,.92); font-size: 27rpx; font-weight: 600; letter-spacing: 2rpx; text-shadow: 0 2rpx 12rpx #111; }
.spot-nav-space { width: 72rpx; }
.spot-hero-copy { position: absolute; z-index: 2; left: 38rpx; right: 38rpx; bottom: 48rpx; }
.spot-category { display: inline-flex; padding: 8rpx 16rpx; border-radius: 8rpx; border: 1rpx solid rgba(255,255,255,.42); background: rgba(13,14,16,.48); color: #ddd8ca; font-size: 20rpx; letter-spacing: 1rpx; }
.spot-title { margin-top: 17rpx; color: #fff; font-size: 53rpx; line-height: 1.28; letter-spacing: 1rpx; text-shadow: 0 3rpx 18rpx rgba(0,0,0,.55); }
.spot-native { margin-top: 7rpx; color: rgba(245,243,236,.72); font-size: 23rpx; letter-spacing: 1.5rpx; }
.detail-content { padding: 0 34rpx; }
.detail-intro-block { padding: 47rpx 4rpx 40rpx; border-bottom: 1rpx solid #303135; }
.detail-eyebrow { color: #9a9ba1; font-size: 19rpx; line-height: 1.5; letter-spacing: 2.5rpx; text-transform: uppercase; }
.spot-intro { margin-top: 17rpx; color: #c4c4c7; font-size: 27rpx; line-height: 1.78; overflow-wrap: anywhere; }
.detail-muted { margin-top: 16rpx; color: #85868b; font-size: 24rpx; line-height: 1.7; }
.detail-section { padding: 43rpx 0 48rpx; border-bottom: 1rpx solid #303135; scroll-margin-top: 100rpx; }
.detail-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 25rpx; }
.detail-heading { margin-top: 8rpx; color: #f3f1eb; font-size: 37rpx; line-height: 1.35; font-weight: 600; }
.detail-heading-mark { color: #8c8eb0; font-size: 49rpx; line-height: 1; }
.detail-more { color: #8d9cff; font-size: 22rpx; white-space: nowrap; }
.visit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }
.visitor-section-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }
.visitor-section-card { display: flex; min-width: 0; min-height: 112rpx; align-items: center; padding: 18rpx 19rpx; box-sizing: border-box; border: 1rpx solid #2a2b30; border-radius: 13rpx; background: #1b1c20; }
.visitor-section-card .visit-tile-head { min-height: 42rpx; }
.visitor-section-card-pressed { border-color: #555b7c; background: #202126; }
.visitor-rich-text { display: block; margin-top: 15rpx; color: #b3b4ba; font-size: 22rpx; line-height: 1.7; word-break: break-word; }
.visitor-rich-text image { max-width: 100%; }
.visitor-section-empty { margin-top: 15rpx; color: #85868b; font-size: 21rpx; line-height: 1.6; }
.visitor-custom-section { margin-top: 17rpx; padding: 23rpx 20rpx; border: 1rpx solid #2b2c31; border-radius: 13rpx; background: #191a1e; }
.visitor-custom-title { color: #f0eff0; font-size: 26rpx; font-weight: 600; line-height: 1.45; }
.visitor-custom-section .visitor-rich-text { margin-top: 12rpx; }
.visit-tile { min-height: 158rpx; padding: 22rpx 21rpx; box-sizing: border-box; border: 1rpx solid #2a2b30; border-radius: 13rpx; background: #1b1c20; }
.visit-tile-head { display: flex; align-items: center; gap: 13rpx; }
.visit-icon { width: 37rpx; height: 37rpx; display: flex; align-items: center; justify-content: center; color: #a2a2cf; font-size: 31rpx; }
.visit-label { color: #f0eff0; font-size: 24rpx; font-weight: 600; }
.visit-value { margin-top: 14rpx; color: #a8a9ae; font-size: 22rpx; line-height: 1.65; overflow-wrap: anywhere; }
.detail-empty-note { padding: 26rpx 24rpx; border: 1rpx solid #2c2d32; border-radius: 13rpx; background: #1a1b1f; color: #96979c; font-size: 24rpx; line-height: 1.65; }
.detail-action-row { display: flex; align-items: center; gap: 17rpx; margin-top: 18rpx; padding: 22rpx 20rpx; border: 1rpx solid #33343a; border-radius: 14rpx; background: #1d1e22; }
.detail-action-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 13rpx; background: #27355f; color: #b3beff; font-size: 31rpx; }
.detail-action-copy { flex: 1; min-width: 0; color: #f1f0eb; font-size: 25rpx; }
.detail-action-copy text { display: block; margin-top: 6rpx; color: #8f9097; font-size: 20rpx; line-height: 1.45; }
.detail-arrow { margin-left: auto; color: #9b9ca3; font-size: 38rpx; }
.visitor-source { display: flex; flex-wrap: wrap; align-items: center; gap: 18rpx; margin-top: 17rpx; color: #8b8c92; font-size: 20rpx; }
.source-link { color: #9eacff; }
.detail-caveat { margin-top: 18rpx; color: #77787e; font-size: 19rpx; line-height: 1.5; }
.highlight-rail { width: calc(100% + 34rpx); white-space: nowrap; }
.highlight-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.highlight-card { display: inline-flex; flex-direction: column; vertical-align: top; width: 430rpx; min-height: 360rpx; margin-right: 18rpx; overflow: hidden; border: 1rpx solid #2c2d32; border-radius: 14rpx; background: #1b1c20; white-space: normal; }
.highlight-grid .highlight-card { width: 100%; min-width: 0; min-height: 0; margin: 0; box-sizing: border-box; }
.highlight-card-image { width: 100%; height: 215rpx; background: #24252a; }
.highlight-card-copy { flex: 1; padding: 21rpx 23rpx 24rpx; }
.highlight-name { color: #f2f1ec; font-size: 29rpx; line-height: 1.4; font-weight: 600; }
.highlight-name text { margin-left: 12rpx; color: #8c9aff; font-size: 22rpx; }
.highlight-desc { margin-top: 9rpx; color: #a3a4a9; font-size: 22rpx; line-height: 1.6; }
.highlight-card-cta { margin-top: 15rpx; color: #9eacff; font-size: 21rpx; }
.highlight-preview-overlay { position: fixed; z-index: 40; inset: 0; display: flex; align-items: center; justify-content: center; padding: 36rpx; box-sizing: border-box; background: rgba(0,0,0,.78); }
.highlight-preview-modal { position: relative; width: 100%; max-height: 82vh; padding: 22rpx; box-sizing: border-box; overflow: hidden; border: 1rpx solid #3a3b42; border-radius: 18rpx; background: #1b1c20; }
.highlight-preview-scroll { max-height: calc(82vh - 44rpx); }
.highlight-preview-close { position: absolute; z-index: 2; top: 10rpx; right: 16rpx; width: 58rpx; height: 58rpx; border-radius: 50%; background: rgba(17,18,20,.78); color: #fff; font-size: 44rpx; line-height: 54rpx; text-align: center; }
.highlight-preview-image { width: 100%; height: 430rpx; border-radius: 12rpx; background: #24252a; }
.highlight-preview-title { margin-top: 22rpx; padding-right: 48rpx; color: #f2f1ec; font-size: 34rpx; line-height: 1.45; font-weight: 600; }
.highlight-preview-desc { margin-top: 15rpx; color: #c0c0c5; font-size: 27rpx; line-height: 1.8; white-space: pre-wrap; }
.highlight-preview-link { margin-top: 22rpx; padding: 18rpx 0 4rpx; border-top: 1rpx solid #303135; color: #9eacff; font-size: 25rpx; }
.audio-how-card { padding: 7rpx 22rpx; border: 1rpx solid #303136; border-radius: 14rpx; background: #191a1e; }
.audio-how-step { display: flex; gap: 17rpx; padding: 18rpx 0; border-bottom: 1rpx solid #2b2c31; color: #c5c5c9; font-size: 23rpx; line-height: 1.6; }
.audio-how-step text { flex: 0 0 42rpx; color: #9498cb; font-size: 20rpx; letter-spacing: 1rpx; }
.audio-how-step view { flex: 1; }
.audio-how-note { padding: 17rpx 0; color: #8d8e94; font-size: 21rpx; line-height: 1.6; }
.audio-track-list { margin-top: 16rpx; }
.audio-track-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.audio-track-card { display: flex; align-items: center; gap: 16rpx; margin-top: 13rpx; padding: 20rpx; border: 1rpx solid #303136; border-radius: 14rpx; background: #1c1d21; }
.audio-track-preview-card { display: block; min-width: 0; margin: 0; padding: 0; overflow: hidden; }
.audio-track-cover { position: relative; width: 100%; height: 220rpx; overflow: hidden; background: #24252a; }
.audio-track-cover image { width: 100%; height: 100%; }
.audio-track-preview-card .audio-track-copy { padding: 16rpx; }
.audio-preview-tag { position: absolute; top: 13rpx; right: 13rpx; padding: 6rpx 12rpx; border-radius: 18rpx; background: rgba(17,18,20,.82); color: #fff; font-size: 19rpx; }
.audio-track-preview-card .audio-track-symbol { position: absolute; right: 13rpx; bottom: 13rpx; margin: 0; background: rgba(17,18,20,.76); color: #fff; }
.audio-track-symbol { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: #252b43; color: #aab5ff; font-size: 26rpx; }
.audio-track-copy { flex: 1; min-width: 0; }
.audio-track-title { color: #f1f0ed; font-size: 25rpx; line-height: 1.45; overflow-wrap: anywhere; }
.audio-track-meta { margin-top: 5rpx; color: #92939a; font-size: 19rpx; }
.audio-play { color: #aab5ff; font-size: 24rpx; }
.route-list { border-top: 1rpx solid #303135; }
.route-reference-list { display: grid; gap: 18rpx; border: 0; }
.route-reference-card { position: relative; height: 390rpx; overflow: hidden; border: 1rpx solid #36383f; border-radius: 16rpx; background: #1d1e23; }
.route-reference-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.route-reference-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,11,14,.10) 8%, rgba(10,11,14,.16) 36%, rgba(10,11,14,.90) 100%); }
.route-reference-copy { position: absolute; inset: auto 25rpx 23rpx; }
.demo-pill { display: inline-flex; padding: 6rpx 12rpx; border: 1rpx solid rgba(235,199,126,.54); border-radius: 20rpx; background: rgba(18,19,22,.72); color: #eccd92; font-size: 18rpx; }
.route-reference-title { margin-top: 10rpx; color: #fff; font-size: 32rpx; line-height: 1.35; font-weight: 600; }
.route-reference-description { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: rgba(255,255,255,.78); font-size: 20rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.route-reference-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 16rpx; color: rgba(255,255,255,.72); font-size: 19rpx; }
.route-reference-cta { padding: 10rpx 21rpx; border-radius: 30rpx; background: #3c67ed; color: #fff; font-size: 21rpx; }
.guide-entry-card { position: relative; height: 330rpx; overflow: hidden; border: 1rpx solid #36383f; border-radius: 16rpx; background: #1c1d21; }
.guide-entry-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.guide-entry-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12,13,16,.92), rgba(12,13,16,.47) 67%, rgba(12,13,16,.26)); }
.guide-entry-icon { position: absolute; top: 23rpx; left: 23rpx; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(17,18,20,.78); color: #fff; font-size: 30rpx; }
.audio-preview-tag { z-index: 1; }
.guide-entry-copy { position: absolute; top: 99rpx; left: 26rpx; right: 24rpx; }
.guide-entry-title { color: #fff; font-size: 31rpx; line-height: 1.4; font-weight: 600; }
.guide-entry-desc { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 21rpx; line-height: 1.5; }
.guide-entry-copy .demo-data-note { margin-top: 7rpx; color: #eccd92; }
.guide-entry-cta { margin-top: 17rpx; color: #c6d0ff; font-size: 21rpx; }
.demo-data-note { margin-top: 10rpx; color: #c4a96e; font-size: 19rpx; line-height: 1.5; }
.route-card { display: flex; align-items: center; gap: 19rpx; padding: 22rpx 8rpx; border-bottom: 1rpx solid #303135; }
.route-card-number { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: #23253a; color: #aab4ff; font-size: 21rpx; }
.route-card-copy { flex: 1; min-width: 0; color: #efeee9; font-size: 25rpx; }
.route-card-copy text { display: block; margin-top: 7rpx; color: #999aa0; font-size: 21rpx; line-height: 1.55; }
.video-shell { position: relative; overflow: hidden; margin-top: 20rpx; min-height: 330rpx; border-radius: 15rpx; background: #08090b; }
.video-shell video { width: 100%; height: 330rpx; }
.video-status { margin-top: 12rpx; color: #898a90; font-size: 21rpx; }
.unlock-button { height: 70rpx; margin-top: 22rpx; border-radius: 36rpx; background: #355fe9; color: #fff; font-size: 22rpx; line-height: 70rpx; text-align: center; }
.related-item { display: flex; align-items: center; gap: 17rpx; padding: 18rpx 0; border-bottom: 1rpx solid #303135; }
.related-item image { width: 115rpx; height: 85rpx; flex-shrink: 0; border-radius: 9rpx; background: #202125; }
.related-name { flex: 1; color: #e5e4e0; font-size: 24rpx; }
.spot-empty { min-height: 100vh; box-sizing: border-box; padding: 260rpx 64rpx 80rpx; background: #111214; color: #eee; text-align: center; }
.spot-empty-title { font-size: 38rpx; font-weight: 700; }
.spot-empty-desc { margin-top: 18rpx; color: #999aa0; font-size: 26rpx; line-height: 1.7; }
.spot-empty-action { display: flex; align-items: center; justify-content: center; height: 82rpx; margin-top: 44rpx; border-radius: 42rpx; background: #355fe9; color: #fff; font-size: 28rpx; }
.purchase-overlay { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; padding: 24rpx; box-sizing: border-box; background: rgba(0,0,0,.68); }
.purchase-modal { position: relative; width: 100%; padding: 38rpx 28rpx 30rpx; box-sizing: border-box; border: 1rpx solid #38393e; border-radius: 18rpx; background: #1b1c20; color: #eee; }
.purchase-close { position: absolute; right: 28rpx; top: 18rpx; color: #9c9da2; font-size: 46rpx; font-weight: 200; }
.purchase-title { margin-top: 14rpx; color: #f4f2ed; font-size: 38rpx; }
.purchase-copy { margin: 10rpx 0 20rpx; color: #a8a9ae; font-size: 24rpx; }
.purchase-option { display: flex; align-items: center; width: 100%; min-height: 82rpx; margin: 14rpx 0 0; padding: 18rpx 22rpx; border: 1rpx solid #3a3b41; border-radius: 13rpx; background: #232429; color: #eee; text-align: left; line-height: 1.5; }
.purchase-option::after { border: 0; }
.simulation-box { margin-top: 24rpx; padding: 20rpx; border: 1rpx solid rgba(196,145,57,.35); border-radius: 15rpx; background: #27231a; }
.simulation-label { color: #e1be75; font-size: 24rpx; font-weight: 600; }
