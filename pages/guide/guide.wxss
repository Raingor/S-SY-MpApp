/* ============ P4 名人导游 / Richard 李 ============ */
.guide-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #F4F7FA;
  color: var(--c-text);
}

.guide-hero {
  position: relative;
  min-height: 930rpx;
  padding: 0 32rpx 42rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 20%, rgba(198, 161, 91, 0.18), transparent 28%),
    linear-gradient(145deg, #061D31 0%, #0B3C5D 72%, #0F547A 100%);
  color: #FFFFFF;
}

.guide-hero::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: 330rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  box-shadow: 0 0 0 36rpx rgba(255, 255, 255, 0.025), 0 0 0 72rpx rgba(255, 255, 255, 0.018);
  pointer-events: none;
}

.guide-nav,
.hero-content,
.hero-quote {
  position: relative;
  z-index: 1;
}

.guide-nav {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.78);
}

.nav-back {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  font-size: 48rpx;
  font-family: Georgia, serif;
  font-weight: 300;
}

.nav-brand {
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.nav-mark {
  color: #D8B878;
  font-size: 28rpx;
}

.hero-content {
  padding: 68rpx 4rpx 0;
}

.hero-kicker,
.section-kicker {
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #C6A15B;
  text-transform: uppercase;
}

.hero-person {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.guide-avatar {
  width: 164rpx;
  height: 164rpx;
  border: 5rpx solid #D8B878;
  border-radius: 50%;
  box-sizing: border-box;
  box-shadow: 0 12rpx 38rpx rgba(0, 0, 0, 0.28);
}

.hero-person-info {
  margin-left: 24rpx;
  flex: 1;
}

.guide-name {
  font-size: 64rpx;
  line-height: 1.1;
  letter-spacing: 2rpx;
}

.guide-role {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
  line-height: 1.6;
}

.hero-intro {
  margin-top: 38rpx;
  max-width: 580rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.9;
  letter-spacing: 1rpx;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 42rpx;
}

.hero-button {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 38rpx;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.hero-button-primary {
  flex: 1;
  background: linear-gradient(135deg, #E2C47F, #C6A15B);
  color: #10283A;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx rgba(198, 161, 91, 0.25);
}

.hero-button-primary text,
.closing-button text,
.bottom-bar-button text {
  margin-left: 12rpx;
  font-size: 30rpx;
}

.hero-button-ghost {
  width: 168rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
}

.hero-quote {
  margin-top: 58rpx;
  padding: 30rpx 28rpx 26rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  color: var(--c-deep);
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.16);
}

.quote-kicker {
  color: #2E75A0;
  font-family: Georgia, serif;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.quote-title {
  margin-top: 16rpx;
  font-family: 'Source Han Serif CN', 'Songti SC', serif;
  font-size: 27rpx;
  line-height: 1.65;
  font-weight: 600;
}

.quote-line {
  height: 1rpx;
  margin: 18rpx 0;
  background: #DCE6EA;
}

.quote-foot {
  color: #8AA3B5;
  font-size: 18rpx;
  line-height: 1.6;
}

.light-section,
.booking-section {
  padding: 74rpx 32rpx 0;
}

.section-title {
  margin-top: 18rpx;
  color: var(--c-deep);
  font-size: 40rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.story-copy {
  margin-top: 28rpx;
  color: var(--c-sub);
  font-size: 25rpx;
  line-height: 1.95;
}

.story-copy text {
  display: block;
  margin-bottom: 14rpx;
}

.guide-full-image {
  display: block;
  width: 100%;
  margin-top: 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 34rpx rgba(11, 60, 93, 0.14);
}

.story-note {
  margin-top: 34rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 18rpx;
  background: #0E4767;
  color: #F8E9C6;
  font-family: 'Source Han Serif CN', 'Songti SC', serif;
  font-size: 24rpx;
  line-height: 1.8;
}

.story-note text {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-family: -apple-system, sans-serif;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.credentials-section {
  padding-top: 76rpx;
}

.credential-row {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.credential-card {
  flex: 1;
  min-height: 196rpx;
  padding: 22rpx 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 26rpx rgba(11, 60, 93, 0.07);
}

.credential-index,
.direction-index {
  color: #C6A15B;
  font-family: Georgia, serif;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.credential-title {
  margin-top: 24rpx;
  color: var(--c-deep);
  font-size: 24rpx;
  font-weight: 600;
}

.credential-desc {
  margin-top: 12rpx;
  color: var(--c-weak);
  font-size: 17rpx;
  line-height: 1.65;
  white-space: pre-line;
}

.dark-section {
  margin-top: 78rpx;
  padding: 74rpx 32rpx 80rpx;
  background: #0C4564;
  color: #FFFFFF;
}

.signature-section {
  margin-top: 76rpx;
}

.section-kicker-gold {
  color: #D8B878;
}

.section-title-light {
  color: #FFFFFF;
}

.direction-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 30rpx;
  margin-right: -18rpx;
}

.direction-card {
  position: relative;
  width: calc(50% - 18rpx);
  min-height: 366rpx;
  margin: 0 18rpx 18rpx 0;
  padding: 24rpx 20rpx 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: var(--c-deep);
}

.direction-card::after {
  content: '';
  position: absolute;
  right: -35rpx;
  bottom: -45rpx;
  width: 130rpx;
  height: 130rpx;
  border: 1rpx solid rgba(198, 161, 91, 0.26);
  border-radius: 50%;
}

.direction-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 18rpx;
  border-radius: 50%;
  background: #EAF3F7;
  position: relative;
}

.direction-icon::before,
.direction-icon::after {
  content: '';
  position: absolute;
  background: #1567A8;
}

.direction-icon::before {
  width: 28rpx;
  height: 4rpx;
  top: 25rpx;
  left: 13rpx;
  transform: rotate(-35deg);
}

.direction-icon::after {
  width: 4rpx;
  height: 28rpx;
  top: 13rpx;
  left: 25rpx;
  transform: rotate(35deg);
}

.direction-icon-culture { background: #FBF3E3; }
.direction-icon-culture::before,
.direction-icon-culture::after { background: #C6A15B; }
.direction-icon-coast { background: #E4F2F8; }
.direction-icon-photo { background: #EAF1EC; }
.direction-icon-photo::before,
.direction-icon-photo::after { background: #2E7D5B; }

.direction-title {
  margin-top: 8rpx;
  font-size: 29rpx;
}

.direction-subtitle {
  margin-top: 2rpx;
  color: #2E75A0;
  font-size: 19rpx;
}

.direction-desc {
  margin-top: 18rpx;
  min-height: 80rpx;
  color: var(--c-sub);
  font-size: 19rpx;
  line-height: 1.65;
}

.direction-meta {
  margin-top: 12rpx;
  color: var(--c-weak);
  font-size: 17rpx;
  line-height: 1.45;
}

.direction-duration {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #D6E6EC;
  border-radius: 16rpx;
  color: #1567A8;
  font-size: 17rpx;
}

.reviews-section {
  margin-top: 0;
  padding-top: 68rpx;
  padding-bottom: 76rpx;
  background: #082D45;
}

.review-list {
  margin-top: 28rpx;
}

.review-item {
  padding: 22rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.16);
}

.review-item:last-child {
  border-bottom: 0;
}

.review-quote {
  color: rgba(255, 255, 255, 0.92);
  font-family: 'Source Han Serif CN', 'Songti SC', serif;
  font-size: 25rpx;
  line-height: 1.75;
}

.review-author {
  margin-top: 12rpx;
  color: #D8B878;
  font-size: 18rpx;
}

.review-author text {
  color: rgba(255, 255, 255, 0.52);
}

.booking-section {
  padding-top: 74rpx;
}

.booking-sub {
  margin-top: 12rpx;
  color: var(--c-weak);
  font-size: 21rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(11, 60, 93, 0.08);
}

.calendar-card {
  margin-top: 28rpx;
  padding: 30rpx 26rpx 24rpx;
}

.calendar-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.calendar-month {
  color: var(--c-deep);
  font-size: 29rpx;
}

.calendar-note {
  margin-top: 4rpx;
  color: var(--c-weak);
  font-size: 17rpx;
}

.calendar-arrows {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.calendar-arrow {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #DCE8ED;
  border-radius: 50%;
  color: #1567A8;
  font-family: Georgia, serif;
  font-size: 34rpx;
  line-height: 1;
}

.calendar-arrow:active {
  background: #EAF4F9;
}

.calendar-arrow-disabled {
  border-color: #EEF3F5;
  color: #C9D4D9;
  pointer-events: none;
}

.week-row,
.date-grid {
  display: flex;
  flex-wrap: wrap;
  text-align: center;
}

.week-row > view,
.date-cell {
  width: 14.2857%;
  box-sizing: border-box;
}

.week-row {
  margin-top: 30rpx;
  color: var(--c-weak);
  font-size: 18rpx;
}

.date-grid {
  margin-top: 12rpx;
}

.date-cell {
  position: relative;
  height: 58rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #AAB8C0;
  font-size: 22rpx;
}

.date-cell.date-past {
  color: #C9D4D9;
  pointer-events: none;
}

.date-cell.date-available {
  color: #1567A8;
  font-weight: 600;
}

.date-cell.date-booked,
.date-cell.date-pending {
  color: #C6A15B;
}

.date-cell.date-booked {
  text-decoration: line-through;
  text-decoration-color: #C6A15B;
}

.date-cell.date-selected {
  color: #FFFFFF;
  border-radius: 50%;
  background: #1567A8;
}

.date-cell.date-selected .date-dot {
  background: #FFFFFF;
}

.date-blank {
  pointer-events: none;
}

.date-dot {
  position: absolute;
  bottom: 3rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #1567A8;
}

.date-pending .date-dot { background: #C6A15B; }
.date-booked .date-dot { background: #D8A6A0; }

.calendar-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 18rpx;
  color: var(--c-weak);
  font-size: 17rpx;
}

.legend-dot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 6rpx;
  border-radius: 50%;
}

.legend-available { background: #1567A8; }
.legend-pending { background: #C6A15B; }
.legend-booked { background: #D8A6A0; }
.legend-past { background: #C9D4D9; }

.booking-form {
  margin-top: 24rpx;
  padding: 34rpx 28rpx 28rpx;
}

.form-heading {
  color: var(--c-deep);
  font-size: 30rpx;
}

.form-tip {
  margin-top: 6rpx;
  color: var(--c-weak);
  font-size: 18rpx;
}

.form-field {
  margin-top: 26rpx;
}

.form-field-last {
  margin-bottom: 2rpx;
}

.form-label {
  margin-bottom: 10rpx;
  color: var(--c-text);
  font-size: 21rpx;
  font-weight: 600;
}

.form-label text {
  color: var(--c-weak);
  font-weight: 400;
}

.duration-row,
.contact-switch {
  display: flex;
  gap: 12rpx;
}

.duration-option,
.contact-type {
  flex: 1;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #DCE8ED;
  border-radius: 14rpx;
  color: var(--c-sub);
  font-size: 20rpx;
}

.duration-on,
.contact-type-on {
  border-color: #1567A8;
  background: #EAF4F9;
  color: #1567A8;
  font-weight: 600;
}

.form-picker,
.form-input,
.form-textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 14rpx;
  background: #F1F6F8;
  color: var(--c-text);
  font-size: 21rpx;
}

.form-picker,
.form-input {
  height: 66rpx;
  padding: 0 22rpx;
  line-height: 66rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-picker text {
  color: #8AA3B5;
  font-size: 28rpx;
}

.form-textarea {
  height: 122rpx;
  padding: 18rpx 22rpx;
  line-height: 1.6;
}

.form-placeholder {
  color: #A7B8C1;
}

.contact-switch {
  margin-bottom: 12rpx;
}

.contact-type {
  flex: 0 0 120rpx;
  height: 48rpx;
  border-radius: 24rpx;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 76rpx;
  margin-top: 30rpx;
  padding: 0;
  border: 0;
  border-radius: 40rpx;
  background: #09253A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1;
}

.submit-button::after {
  border: 0;
}

.submit-note {
  margin-top: 14rpx;
  text-align: center;
  color: var(--c-weak);
  font-size: 17rpx;
}

.closing-section {
  margin-top: 32rpx;
  padding: 70rpx 32rpx 46rpx;
  background: #C6A15B;
  color: #09253A;
}

.closing-title {
  font-size: 34rpx;
  line-height: 1.45;
}

.closing-copy {
  margin-top: 10rpx;
  font-size: 19rpx;
  opacity: 0.8;
}

.closing-button {
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  border-radius: 40rpx;
  background: #09253A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.closing-site {
  margin-top: 40rpx;
  text-align: center;
  color: rgba(9, 37, 58, 0.58);
  font-family: Georgia, serif;
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.guide-bottom-space {
  height: 128rpx;
}

.guide-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(11, 60, 93, 0.1);
  backdrop-filter: blur(12rpx);
}

.bottom-bar-label {
  color: var(--c-sub);
  font-size: 19rpx;
}

.bottom-bar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 230rpx;
  height: 66rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  background: #1567A8;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
}
