<view class="guide-page">
  <!-- ===== 人物头部 ===== -->
  <view class="guide-hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="guide-nav">
      <view class="nav-back" bindtap="onBack">‹</view>
      <view class="nav-brand">SY 希腊蔚蓝海岸</view>
      <view class="nav-mark">✦</view>
    </view>

    <view class="hero-content">
      <view class="hero-kicker">{{guide.location}}</view>
      <view class="hero-person">
        <image class="guide-avatar" src="{{guide.avatar}}" mode="aspectFill" />
        <view class="hero-person-info">
          <view class="guide-name serif">{{guide.name}}</view>
          <view class="guide-role">{{guide.role}}</view>
        </view>
      </view>
      <view class="hero-intro">{{guide.intro}}</view>
      <view class="hero-actions">
        <view class="hero-button hero-button-primary" bindtap="onBookTap">预约 Richard 的时间 <text>→</text></view>
        <view class="hero-button hero-button-ghost" bindtap="onCopyWechat">添加微信</view>
      </view>
    </view>

    <view class="hero-quote">
      <view class="quote-kicker">RICHARD LI</view>
      <view class="quote-title">把一簇辉映，变成一段真正有温度的希腊经验</view>
      <view class="quote-line"></view>
      <view class="quote-foot">武汉大学双学士 · 英国澳洲双硕士 · 欧盟 / 美国 / 中国驾照</view>
    </view>
  </view>

  <!-- ===== 人物故事 ===== -->
  <view class="light-section story-section">
    <view class="section-kicker">01 · MEET RICHARD</view>
    <view class="section-title serif">先认识本人，再决定这次如何徐徐深入</view>
    <view class="story-copy">
      <text>旅居欧美多年，我一直把希腊当成一座可以慢慢读的博物馆。历史、人文、秘境与镜头感，交给真正生活在这里的人。</text>
      <text>我不负责把行程塞满，而是希望你离开时，仍记得某一束光、某一段海岸，以及途中那些没有被攻略写下的细节。</text>
    </view>
    <view class="story-note">“旅行最珍贵的，不是走过多少地方，<br />而是终于有人替你读懂沿途的故事。”<text>— Richard 李 / SIGNATURE GUIDE</text></view>
  </view>

  <!-- ===== 核心背书 ===== -->
  <view class="light-section credentials-section">
    <view class="section-kicker">02 · THE CREDENTIALS</view>
    <view class="section-title serif">三项背书，足够放心与他一起探索希腊</view>
    <view class="credential-row">
      <view class="credential-card" wx:for="{{credentials}}" wx:key="index">
        <view class="credential-index">{{item.index}}</view>
        <view class="credential-title">{{item.title}}</view>
        <view class="credential-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 擅长方向 ===== -->
  <view class="dark-section signature-section">
    <view class="section-kicker section-kicker-gold">03 · HIS SIGNATURE</view>
    <view class="section-title section-title-light serif">他最擅长的四种希腊时光</view>
    <view class="direction-grid">
      <view class="direction-card" wx:for="{{directions}}" wx:key="key">
        <view class="direction-icon direction-icon-{{item.key}}"></view>
        <view class="direction-index">{{item.index}}</view>
        <view class="direction-title serif">{{item.title}}</view>
        <view class="direction-subtitle">{{item.subtitle}}</view>
        <view class="direction-desc">{{item.desc}}</view>
        <view class="direction-meta">{{item.suitable}}</view>
        <view class="direction-duration">{{item.duration}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 客户评价 ===== -->
  <view class="dark-section reviews-section">
    <view class="section-kicker section-kicker-gold">04 · FROM THE GUESTBOOK</view>
    <view class="section-title section-title-light serif">他们这样记住 Richard</view>
    <view class="review-list">
      <view class="review-item" wx:for="{{reviews}}" wx:key="name">
        <view class="review-quote">“{{item.quote}}”</view>
        <view class="review-author">{{item.name}} <text>· {{item.meta}}</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 预约模块 ===== -->
  <view class="booking-section" id="booking">
    <view class="section-kicker">05 · RESERVE YOUR TIME</view>
    <view class="section-title serif">选一个日期，开始一次专属探索</view>
    <view class="booking-sub">日历中的蓝色日期可预约，提交后由 Richard 确认时间。</view>

    <view class="calendar-card card">
      <view class="calendar-head">
        <view>
          <view class="calendar-month serif">{{calendarMonthLabel}}</view>
          <view class="calendar-note">选择你的希腊同行时光</view>
        </view>
        <view class="calendar-arrows">
          <view class="calendar-arrow {{canPrevMonth ? '' : 'calendar-arrow-disabled'}}" bindtap="onPrevMonth">‹</view>
          <view class="calendar-arrow {{canNextMonth ? '' : 'calendar-arrow-disabled'}}" bindtap="onNextMonth">›</view>
        </view>
      </view>
      <view class="week-row">
        <view wx:for="{{calendarWeeks}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="date-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="key"
          class="date-cell {{item.blank ? 'date-blank' : ''}} date-{{item.state}} {{selectedDate === item.date ? 'date-selected' : ''}}"
          data-date="{{item.date}}"
          data-state="{{item.state}}"
          data-day="{{item.day}}"
          bindtap="onDateTap"
        >
          <text wx:if="{{!item.blank}}">{{item.day}}</text>
          <view wx:if="{{!item.blank && item.state !== 'unavailable'}}" class="date-dot"></view>
        </view>
      </view>
      <view class="calendar-legend">
        <view><text class="legend-dot legend-available"></text>可预约</view>
        <view><text class="legend-dot legend-pending"></text>待确认</view>
        <view><text class="legend-dot legend-booked"></text>已约</view>
        <view><text class="legend-dot legend-past"></text>不可选</view>
      </view>
    </view>

    <view class="booking-form card">
      <view class="form-heading serif">告诉 Richard 你的想法</view>
      <view class="form-tip">已选择 {{selectedDateText}} · 请留下联系方式</view>

      <view class="form-field">
        <view class="form-label">服务时长</view>
        <view class="duration-row">
          <view wx:for="{{durationOptions}}" wx:key="*this" class="duration-option {{selectedDuration === item ? 'duration-on' : ''}}" data-value="{{item}}" bindtap="onDurationTap">{{item}}</view>
        </view>
      </view>

      <view class="form-field">
        <view class="form-label">出行人数</view>
        <picker range="{{peopleOptions}}" value="0" bindchange="onPeopleChange">
          <view class="form-picker">{{form.people}}<text>⌄</text></view>
        </picker>
      </view>

      <view class="form-field">
        <view class="form-label">希望路线与需求 <text>（必填）</text></view>
        <textarea class="form-textarea" maxlength="200" placeholder="例如：雅典历史讲解，希望安排半日步行路线…" placeholder-class="form-placeholder" value="{{form.route}}" data-field="route" bindinput="onInput"></textarea>
      </view>

      <view class="form-field form-field-last">
        <view class="form-label">联系方式 <text>（二选一）</text></view>
        <view class="contact-switch">
          <view class="contact-type {{form.contactType === 'wechat' ? 'contact-type-on' : ''}}" data-type="wechat" bindtap="onContactTypeTap">微信</view>
          <view class="contact-type {{form.contactType === 'phone' ? 'contact-type-on' : ''}}" data-type="phone" bindtap="onContactTypeTap">手机号</view>
        </view>
        <input class="form-input" type="{{form.contactType === 'phone' ? 'number' : 'text'}}" maxlength="{{form.contactType === 'phone' ? 11 : 40}}" placeholder="{{form.contactType === 'phone' ? '请输入手机号' : '请输入微信号'}}" placeholder-class="form-placeholder" value="{{form.contact}}" data-field="contact" bindinput="onInput" />
      </view>

      <button class="submit-button" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? '提交中…' : '提交预约 · 获取专属报价'}}</button>
      <view class="submit-note">提交后 24 小时内由 Richard 或顾问确认时间</view>
    </view>
  </view>

  <!-- ===== 页面收束 ===== -->
  <view class="closing-section">
    <view class="closing-title serif">准备好让希腊，变成你的故事了吗？</view>
    <view class="closing-copy">Richard 李 · 名字背后，是一段值得信任的在地经验</view>
    <view class="closing-button" bindtap="onBookTap">预约 Richard 的时间 <text>→</text></view>
    <view class="closing-site">GREECE BLUE COAST · sy-greece.com</view>
  </view>

  <view class="guide-bottom-space"></view>
  <view class="guide-bottom-bar">
    <view class="bottom-bar-label">Richard 李 · 在地深度陪同</view>
    <view class="bottom-bar-button" bindtap="onBookTap">预约时间 <text>→</text></view>
  </view>
</view>
