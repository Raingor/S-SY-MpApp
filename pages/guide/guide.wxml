<view class="guide-page">
  <!-- ===== 人物头部 ===== -->
  <view class="guide-hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="guide-nav sy-nav">
      <view class="nav-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="nav-brand">SY 希旅人</view>
      <view class="nav-mark">✦</view>
    </view>

    <view class="hero-content">
      <view class="hero-kicker">{{guide.location}}</view>
      <view class="hero-person">
        <image class="guide-avatar" src="{{guide.avatar}}" mode="aspectFill" />
        <view class="hero-person-info">
          <view class="guide-name serif">{{guide.name}}</view>
          <view class="guide-role">{{guide.role}}</view>
        </view>
      </view>
      <view class="hero-intro">{{guide.intro}}</view>
      <view class="hero-actions">
        <view class="hero-button hero-button-primary" bindtap="onBookTap">{{i18n.forms.reserve}} <text>→</text></view>
        <view class="hero-button hero-button-ghost" bindtap="onCopyWechat">{{i18n.forms.addWechat}}</view>
      </view>
    </view>

    <view class="hero-quote">
      <view class="quote-kicker">RICHARD LI</view>
      <view class="quote-title">{{i18n.guide.heroQuote}}</view>
      <view class="quote-line"></view>
      <view class="quote-foot">{{i18n.guide.quoteFoot}}</view>
    </view>
  </view>

  <!-- ===== 人物故事 ===== -->
  <view class="light-section story-section">
    <view class="section-kicker">01 · MEET RICHARD</view>
    <view class="section-title serif">{{i18n.guide.storyTitle}}</view>
    <view class="story-copy">
      <text>{{i18n.guide.story1}}</text>
      <text>{{i18n.guide.story2}}</text>
    </view>
    <image class="guide-full-image" src="{{guide.fullImage}}" mode="widthFix" />
    <view class="story-note">“{{i18n.guide.storyNote}}”<text>— Richard 李 / SIGNATURE GUIDE</text></view>
  </view>

  <!-- ===== 核心背书 ===== -->
  <view class="light-section credentials-section">
    <view class="section-kicker">02 · THE CREDENTIALS</view>
    <view class="section-title serif">{{i18n.guide.credentialsTitle}}</view>
    <view class="credential-row">
      <view class="credential-card" wx:for="{{credentials}}" wx:key="index">
        <view class="credential-index">{{item.index}}</view>
        <view class="credential-title">{{item.title}}</view>
        <view class="credential-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 擅长方向 ===== -->
  <view class="dark-section signature-section">
    <view class="section-kicker section-kicker-gold">03 · HIS SIGNATURE</view>
    <view class="section-title section-title-light serif">{{i18n.guide.signatureTitle}}</view>
    <view class="direction-grid">
      <view class="direction-card" wx:for="{{directions}}" wx:key="key">
        <view class="direction-icon direction-icon-{{item.key}}"></view>
        <view class="direction-index">{{item.index}}</view>
        <view class="direction-title serif">{{item.title}}</view>
        <view class="direction-subtitle">{{item.subtitle}}</view>
        <view class="direction-desc">{{item.desc}}</view>
        <view class="direction-meta">{{item.suitable}}</view>
        <view class="direction-duration">{{item.duration}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 客户评价 ===== -->
  <view class="dark-section reviews-section">
    <view class="section-kicker section-kicker-gold">04 · FROM THE GUESTBOOK</view>
    <view class="section-title section-title-light serif">{{i18n.guide.reviewsTitle}}</view>
    <view class="review-list">
      <view class="review-item" wx:for="{{reviews}}" wx:key="name">
        <view class="review-quote">“{{item.quote}}”</view>
        <view class="review-author">{{item.name}} <text>· {{item.meta}}</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 预约模块 ===== -->
  <view class="booking-section" id="booking">
    <view class="section-kicker">05 · RESERVE YOUR TIME</view>
    <view class="section-title serif">{{i18n.guide.bookingTitle}}</view>
    <view class="booking-sub">{{i18n.guide.bookingSub}}</view>

    <view class="calendar-card card">
      <view class="calendar-head">
        <view>
          <view class="calendar-month serif">{{calendarMonthLabel}}</view>
          <view class="calendar-note">{{i18n.guide.calendarNote}}</view>
        </view>
        <view class="calendar-arrows">
          <view class="calendar-arrow {{canPrevMonth ? '' : 'calendar-arrow-disabled'}}" bindtap="onPrevMonth">‹</view>
          <view class="calendar-arrow {{canNextMonth ? '' : 'calendar-arrow-disabled'}}" bindtap="onNextMonth">›</view>
        </view>
      </view>
      <view class="week-row">
        <view wx:for="{{calendarWeeks}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="date-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="key"
          class="date-cell {{item.blank ? 'date-blank' : ''}} date-{{item.state}} {{selectedDate === item.date ? 'date-selected' : ''}}"
          data-date="{{item.date}}"
          data-state="{{item.state}}"
          data-day="{{item.day}}"
          bindtap="onDateTap"
        >
          <text wx:if="{{!item.blank}}">{{item.day}}</text>
          <view wx:if="{{!item.blank && item.state !== 'unavailable'}}" class="date-dot"></view>
        </view>
      </view>
      <view class="calendar-legend">
        <view><text class="legend-dot legend-available"></text>{{i18n.guide.available}}</view>
        <view><text class="legend-dot legend-pending"></text>{{i18n.guide.pending}}</view>
        <view><text class="legend-dot legend-booked"></text>{{i18n.guide.booked}}</view>
        <view><text class="legend-dot legend-past"></text>{{i18n.guide.unavailable}}</view>
      </view>
    </view>

    <view class="booking-form card">
      <view class="form-heading serif">{{i18n.forms.bookingTitle}}</view>
      <view class="form-tip">{{i18n.guide.selectedPrefix}} {{selectedDateText}} · {{i18n.forms.contactMethod}}</view>

      <view class="form-field">
        <view class="form-label">{{i18n.forms.serviceDuration}}</view>
        <view class="duration-row">
          <view wx:for="{{durationOptions}}" wx:key="*this" class="duration-option {{selectedDuration === item ? 'duration-on' : ''}}" data-value="{{item}}" bindtap="onDurationTap">{{item}}</view>
        </view>
      </view>

      <view class="form-field">
        <view class="form-label">{{i18n.forms.travelers}}</view>
        <picker range="{{peopleOptions}}" value="0" bindchange="onPeopleChange">
          <view class="form-picker">{{form.people}}<text>⌄</text></view>
        </picker>
      </view>

      <view class="form-field">
        <view class="form-label">{{i18n.forms.routeNeed}} <text>{{i18n.forms.industryRequired}}</text></view>
        <textarea class="form-textarea" maxlength="200" placeholder="{{i18n.forms.routePlaceholder}}" placeholder-class="form-placeholder" value="{{form.route}}" data-field="route" bindinput="onInput"></textarea>
      </view>

      <view class="form-field form-field-last">
        <view class="form-label">{{i18n.forms.contactMethod}} <text>{{i18n.forms.contactChoose}}</text></view>
        <view class="contact-switch">
          <view class="contact-type {{form.contactType === 'wechat' ? 'contact-type-on' : ''}}" data-type="wechat" bindtap="onContactTypeTap">{{i18n.forms.wechat}}</view>
          <view class="contact-type {{form.contactType === 'phone' ? 'contact-type-on' : ''}}" data-type="phone" bindtap="onContactTypeTap">{{i18n.profile.phone}}</view>
        </view>
        <input class="form-input" type="{{form.contactType === 'phone' ? 'number' : 'text'}}" maxlength="{{form.contactType === 'phone' ? 11 : 40}}" placeholder="{{form.contactType === 'phone' ? i18n.forms.phonePlaceholderShort : i18n.forms.wechatPlaceholder}}" placeholder-class="form-placeholder" value="{{form.contact}}" data-field="contact" bindinput="onInput" />
      </view>

      <button class="submit-button" hover-class="guide-submit-hover" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? i18n.submitting : i18n.forms.submitBooking}}</button>
      <view class="submit-note">{{i18n.forms.submitBookingNote}}</view>
    </view>
  </view>

  <!-- ===== 页面收束 ===== -->
  <view class="closing-section">
    <view class="closing-title serif">{{i18n.guide.closingTitle}}</view>
    <view class="closing-copy">{{i18n.guide.closingCopy}}</view>
    <view class="closing-button" bindtap="onBookTap">{{i18n.forms.reserve}} <text>→</text></view>
    <view class="closing-site">SY TRAVELER · sy-greece.com</view>
  </view>

  <view class="guide-bottom-space"></view>
  <view class="guide-bottom-bar">
    <view class="bottom-bar-label">{{i18n.guide.bottomBar}}</view>
    <view class="bottom-bar-button" hover-class="guide-bottom-button-hover" bindtap="onBookTap">{{i18n.guide.reserveShort}} <text>→</text></view>
  </view>
</view>
