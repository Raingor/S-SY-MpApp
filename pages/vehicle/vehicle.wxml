<view class="consult-page">
  <view class="consult-hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="consult-nav sy-nav">
      <view class="consult-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="consult-brand">{{i18n.brand}}</view>
      <view class="consult-mark">✦</view>
    </view>
    <view class="consult-hero-body">
      <view class="consult-kicker">LOCAL MOBILITY CONSULTATION</view>
      <block wx:if="{{configured}}">
        <view class="consult-title serif">{{service.title}}<br />{{service.subtitle}}</view>
        <view wx:if="{{service.description}}" class="consult-subtitle">{{service.description}}</view>
        <view wx:if="{{tags.length}}" class="consult-tag-row">
          <view class="consult-tag" wx:for="{{tags}}" wx:key="*this">{{item}}</view>
        </view>
      </block>
      <view wx:else class="consult-subtitle">{{i18n.vehiclePending}}</view>
    </view>
  </view>

  <view class="consult-card">
    <view class="consult-card-title serif">{{copy.formTitle}}</view>
    <view class="consult-card-tip">{{copy.formTip}}</view>

    <view class="consult-field">
      <view class="consult-label">{{copy.dateLabel}}</view>
      <picker mode="date" start="{{dateStart}}" end="{{dateEnd}}" bindchange="onDateChange">
        <view class="consult-picker">{{form.date || i18n.forms.chooseDate}}<text>›</text></view>
      </picker>
    </view>

    <view wx:if="{{durationOptions.length}}" class="consult-field">
      <view class="consult-label">{{copy.durationLabel}}</view>
      <view class="consult-options">
        <view wx:for="{{durationOptions}}" wx:key="id" class="consult-option {{form.duration === item.id ? 'consult-option-on' : ''}}" data-field="duration" data-value="{{item.id}}" bindtap="onOptionTap">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{vehicleOptions.length}}" class="consult-field">
      <view class="consult-label">{{copy.vehicleLabel}}</view>
      <view class="consult-options">
        <view wx:for="{{vehicleOptions}}" wx:key="id" class="consult-option {{form.vehicleType === item.id ? 'consult-option-on' : ''}}" data-field="vehicleType" data-value="{{item.id}}" bindtap="onOptionTap">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{peopleOptions.length}}" class="consult-field">
      <view class="consult-label">{{copy.peopleLabel}}</view>
      <picker range="{{peopleOptions}}" range-key="label" value="{{peopleIndex}}" bindchange="onPeopleChange">
        <view class="consult-picker">{{peopleLabel}}<text>⌄</text></view>
      </picker>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{copy.routeLabel}} <text wx:if="{{copy.routeRequired}}">{{i18n.forms.industryRequired}}</text></view>
      <textarea class="consult-textarea" maxlength="240" placeholder="{{copy.routePlaceholder}}" placeholder-class="consult-placeholder" value="{{form.route}}" data-field="route" bindinput="onInput"></textarea>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{copy.contactLabel}} <text wx:if="{{copy.showPhone && copy.showWechat}}">{{i18n.forms.contactChoose}}</text></view>
      <view class="consult-contact-switch">
        <view wx:if="{{copy.showPhone}}" class="consult-contact-type {{form.contactType === 'phone' ? 'consult-contact-on' : ''}}" data-type="phone" bindtap="onContactTypeTap">{{i18n.profile.phone}}</view>
        <view wx:if="{{copy.showWechat}}" class="consult-contact-type {{form.contactType === 'wechat' ? 'consult-contact-on' : ''}}" data-type="wechat" bindtap="onContactTypeTap">{{i18n.forms.wechat}}</view>
      </view>
      <input class="consult-input" type="{{form.contactType === 'phone' ? 'number' : 'text'}}" maxlength="{{form.contactType === 'phone' ? 11 : 40}}" placeholder="{{form.contactType === 'phone' ? copy.phonePlaceholder : copy.wechatPlaceholder}}" placeholder-class="consult-placeholder" value="{{form.contact}}" data-field="contact" bindinput="onInput" />
    </view>

    <button class="consult-submit" hover-class="consult-submit-hover" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? i18n.submitting : copy.submitLabel}}</button>
    <view wx:if="{{service.note}}" class="consult-note">{{service.note}}</view>
    <view wx:if="{{service.disclaimer}}" class="consult-note">{{service.disclaimer}}</view>
  </view>
  <view class="consult-footer">{{i18n.commonSlogan}}</view>
</view>
