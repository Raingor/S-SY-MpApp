<view class="consult-page">
  <view class="consult-hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="consult-nav sy-nav">
      <view class="consult-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
        <view class="sy-back-chevron"></view>
      </view>
      <view class="consult-brand">{{i18n.brand}}</view>
      <view class="consult-mark">✦</view>
    </view>
    <view class="consult-hero-body">
      <view class="consult-kicker">LOCAL MOBILITY CONSULTATION</view>
      <view class="consult-title serif">{{i18n.vehicleTitle}}<br />{{i18n.vehicleSubtitle}}</view>
      <view class="consult-subtitle">{{i18n.vehicleDescription}}</view>
      <view class="consult-tag-row">
        <view class="consult-tag">{{i18n.vehicleTag1}}</view>
        <view class="consult-tag">{{i18n.vehicleTag2}}</view>
        <view class="consult-tag">{{i18n.vehicleTag3}}</view>
      </view>
    </view>
  </view>

  <view class="consult-card">
    <view class="consult-card-title serif">{{i18n.forms.vehiclePlan}}</view>
    <view class="consult-card-tip">{{i18n.forms.vehicleTip}}</view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.vehicleDate}}</view>
      <picker mode="date" start="2026-09-14" bindchange="onDateChange">
        <view class="consult-picker">{{form.date || i18n.forms.chooseDate}}<text>›</text></view>
      </picker>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.vehicleDuration}}</view>
      <view class="consult-options">
        <view wx:for="{{durationOptions}}" wx:key="*this" class="consult-option {{form.duration === item ? 'consult-option-on' : ''}}" data-field="duration" data-value="{{item}}" bindtap="onOptionTap">{{item}}</view>
      </view>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.vehicleType}}</view>
      <view class="consult-options">
        <view wx:for="{{vehicleOptions}}" wx:key="*this" class="consult-option {{form.vehicleType === item ? 'consult-option-on' : ''}}" data-field="vehicleType" data-value="{{item}}" bindtap="onOptionTap">{{item}}</view>
      </view>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.people}}</view>
      <picker range="{{peopleOptions}}" value="0" bindchange="onPeopleChange">
        <view class="consult-picker">{{form.people}}<text>⌄</text></view>
      </picker>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.vehicleRoute}} <text>{{i18n.forms.industryRequired}}</text></view>
      <textarea class="consult-textarea" maxlength="240" placeholder="{{i18n.forms.vehicleRoutePlaceholder}}" placeholder-class="consult-placeholder" value="{{form.route}}" data-field="route" bindinput="onInput"></textarea>
    </view>

    <view class="consult-field">
      <view class="consult-label">{{i18n.forms.contactMethod}} <text>{{i18n.forms.contactChoose}}</text></view>
      <view class="consult-contact-switch">
        <view class="consult-contact-type {{form.contactType === 'phone' ? 'consult-contact-on' : ''}}" data-type="phone" bindtap="onContactTypeTap">{{i18n.profile.phone}}</view>
        <view class="consult-contact-type {{form.contactType === 'wechat' ? 'consult-contact-on' : ''}}" data-type="wechat" bindtap="onContactTypeTap">{{i18n.forms.wechat}}</view>
      </view>
      <input class="consult-input" type="{{form.contactType === 'phone' ? 'number' : 'text'}}" maxlength="{{form.contactType === 'phone' ? 11 : 40}}" placeholder="{{form.contactType === 'phone' ? i18n.forms.phonePlaceholderShort : i18n.forms.wechatPlaceholder}}" placeholder-class="consult-placeholder" value="{{form.contact}}" data-field="contact" bindinput="onInput" />
    </view>

    <button class="consult-submit" hover-class="consult-submit-hover" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? i18n.submitting : i18n.forms.submitVehicle}}</button>
    <view class="consult-note">{{i18n.vehicleNote}}</view>
  </view>
  <view class="consult-footer">{{i18n.commonSlogan}}</view>
</view>
