/* 定制旅行服务流程页：深海军蓝编辑风，呼应流程图泳道与品牌蓝金。 */
page { background: #0C1B33; }

.flow-page { min-height: 100vh; padding-bottom: 60rpx; color: #EAF0F8; }

/* ===== 页头 ===== */
.hero {
  position: relative;
  overflow: hidden;
  padding: 0 36rpx 84rpx;
  background: linear-gradient(168deg, #123059 0%, #0C1B33 72%);
}
.hero::before {
  content: '';
  position: absolute; right: -140rpx; top: -120rpx;
  width: 460rpx; height: 460rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(31, 88, 153, 0.5) 0%, rgba(31, 88, 153, 0) 68%);
}
.hero-wave {
  position: absolute; left: 0; right: 0; bottom: -2rpx; height: 56rpx;
  background: #0C1B33;
  border-radius: 56rpx 56rpx 0 0;
}
.hero-inner { position: relative; padding-top: 40rpx; }
.flow-nav { position: relative; display: flex; align-items: center; height: 88rpx; padding: 0 36rpx; }
.hero-kicker { color: #D8C396; letter-spacing: 6rpx; }
.hero-title { margin-top: 18rpx; font-size: 52rpx; line-height: 1.28; color: #F5F8FC; letter-spacing: 2rpx; }
.hero-sub { margin-top: 20rpx; color: #9FB4CF; font-size: 25rpx; letter-spacing: 1rpx; }
.hero-note { margin-top: 12rpx; color: #5F7694; font-size: 21rpx; }

/* ===== 泳道图例 ===== */
.card { margin: 30rpx 32rpx 0; padding: 26rpx 28rpx; border-radius: 22rpx; background: #13253F; border: 1rpx solid rgba(216, 195, 150, 0.16); }
.lanes { display: flex; gap: 26rpx; justify-content: space-between; }
.lane-row { display: flex; align-items: center; gap: 12rpx; color: #B9C8DC; font-size: 21rpx; }
.lane-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.lane-dot-you { background: #4D8FD1; }
.lane-dot-crew { background: #D8C396; }
.lane-dot-greece { background: #5FA98F; }

/* ===== 阶段 ===== */
.stages { padding: 8rpx 32rpx 0; }
.stage { margin-top: 40rpx; }
.stage-head { display: flex; align-items: baseline; gap: 16rpx; padding: 0 6rpx; }
.stage-no { color: rgba(216, 195, 150, 0.55); font-size: 58rpx; font-weight: 600; letter-spacing: 2rpx; }
.stage-title { color: #F0F4FA; font-size: 33rpx; letter-spacing: 2rpx; }
.stage-body { margin-top: 18rpx; }

/* ===== 步骤 ===== */
.step { position: relative; display: flex; gap: 20rpx; padding-bottom: 26rpx; }
.step:last-child { padding-bottom: 0; }
.step-rail { display: flex; flex-direction: column; align-items: center; width: 44rpx; flex-shrink: 0; }
.step-no {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #1A3557; color: #D8C396; font-size: 21rpx; font-weight: 600;
  border: 1rpx solid rgba(216, 195, 150, 0.35);
}
.step-line { flex: 1; width: 2rpx; margin-top: 8rpx; background: linear-gradient(180deg, rgba(216, 195, 150, 0.35), rgba(216, 195, 150, 0.08)); }
.step-card { flex: 1; min-width: 0; padding: 24rpx 26rpx; border-radius: 18rpx; background: #101F38; border: 1rpx solid rgba(122, 150, 186, 0.14); }
.step-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.step-title { color: #F0F4FA; font-size: 28rpx; letter-spacing: 1rpx; }
.step-desc { margin-top: 12rpx; color: #9DAEC7; font-size: 23rpx; line-height: 1.65; }

/* 泳道小标签 */
.lane-chip { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; padding: 5rpx 14rpx; border-radius: 999rpx; font-size: 19rpx; color: #93A8C4; background: rgba(77, 143, 209, 0.1); border: 1rpx solid rgba(122, 150, 186, 0.2); }
.lane-mini { width: 10rpx; height: 10rpx; border-radius: 50%; }
.lane-mini-you { background: #4D8FD1; }
.lane-mini-crew { background: #D8C396; }
.lane-mini-greece { background: #5FA98F; }

/* ===== 服务费 ===== */
.fee { margin-top: 44rpx; }
.fee-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.fee-title { color: #F0F4FA; font-size: 29rpx; letter-spacing: 1rpx; }
.fee-note { color: #63788F; font-size: 20rpx; }
.fee-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.fee-cell { flex: 1 1 40%; display: flex; align-items: baseline; justify-content: space-between; padding: 18rpx 22rpx; border-radius: 14rpx; background: rgba(77, 143, 209, 0.08); border: 1rpx solid rgba(122, 150, 186, 0.14); }
.fee-days { color: #9DAEC7; font-size: 23rpx; }
.fee-amount { color: #D8C396; font-size: 30rpx; font-weight: 600; }

/* ===== 品牌 ===== */
.brand { margin-top: 56rpx; text-align: center; }
.brand-mark { color: #4A6285; font-size: 19rpx; letter-spacing: 4rpx; }
.brand-slogan { margin-top: 14rpx; color: #D8C396; font-size: 30rpx; letter-spacing: 8rpx; }

/* ===== CTA：沙金胶囊按钮（与全站 btn-inquiry 同款渐变） ===== */
.cta-wrap { margin: 48rpx 36rpx 0; }
.cta {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 96rpx;
  background: linear-gradient(135deg, #D8B878 0%, #C6A15B 60%, #B08D45 100%);
  border: none; border-radius: 48rpx;
  color: #FFFFFF; font-weight: 600; letter-spacing: 2rpx; line-height: inherit;
  box-shadow: 0 10rpx 24rpx rgba(198, 161, 91, 0.35);
}
.cta::after { border: none; }
.cta-hover { opacity: 0.88; }
.cta-title { font-size: 31rpx; color: #FFFFFF; white-space: nowrap; }
.cta-title::after { content: ' ›'; margin-left: 4rpx; }
.cta-hint { margin-top: 14rpx; color: #63788F; font-size: 21rpx; letter-spacing: 1rpx; text-align: center; }
.cta-arrow { display: none; }
