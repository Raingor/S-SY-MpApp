<view class="city-page" wx:if="{{city}}">
  <!-- 顶部导航 -->
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="city-nav sy-nav">
    <view class="city-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
      <view class="sy-back-chevron"></view>
    </view>
    <view class="city-mark">✦</view>
  </view>

  <!-- 拼贴 Mosaic 主视觉 + 暗色遮罩 + 大字标题 -->
  <view class="city-mosaic">
    <view class="mosaic-grid">
      <view class="mosaic-cell" wx:for="{{city.mosaic}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
      </view>
    </view>
    <view class="mosaic-mask"></view>
    <view class="mosaic-title-wrap">
      <view class="mosaic-title serif">{{city.name}}</view>
      <view class="mosaic-subtitle">{{city.subtitle}}</view>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="city-stats">
    <view class="stat" wx:for="{{stats}}" wx:key="label">
      <view class="stat-value">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 说明入口 -->
  <view class="city-about" bindtap="onAboutGuide">💡 {{i18n.contentPage.cityAbout}}</view>

  <!-- 深色内容区（占位说明） -->
  <view class="city-note">
    <view class="city-note-kicker">WHAT'S INSIDE</view>
    <view class="city-note-text">{{i18n.contentPage.cityInside}}</view>
  </view>

  <!-- 底部双 CTA -->
  <view class="city-cta">
    <view class="cta-buy" hover-class="city-cta-press" bindtap="onBuy">
      <view class="cta-label">{{cityUnlocked ? i18n.contentPage.cityUnlocked : i18n.contentPage.buy}}</view>
      <view wx:if="{{cityUnlocked && cityMember}}" class="cta-sub">{{i18n.paidContent.memberUnlocked}}</view>
      <view wx:elif="{{cityUnlocked}}" class="cta-sub">{{i18n.contentPage.cityUnlocked}}</view>
      <view wx:elif="{{cityPriceDisplay}}" class="cta-sub">{{cityPriceDisplay}}</view>
      <view wx:else class="cta-sub">{{i18n.contentPage.priceUnavailable}}</view>
    </view>
    <view class="cta-view" hover-class="city-cta-press" bindtap="onView">
      <view class="cta-label">{{i18n.contentPage.viewSpots}}</view>
      <view class="cta-sub">{{i18n.contentPage.freeBrowse}}</view>
    </view>
  </view>
  <view wx:if="{{showCityPaywall}}" class="city-paywall-overlay" catchtap="onCityPaywallClose">
    <view class="city-paywall-sheet" catchtap="noop">
      <view class="city-paywall-topbar"><view class="city-paywall-handle"></view><view class="city-paywall-close" bindtap="onCityPaywallClose">×</view></view>
      <view class="city-paywall-eyebrow">{{i18n.contentPage.cityPaywallEyebrow}}</view>
      <view class="city-paywall-title">{{city.name}} · {{i18n.contentPage.cityPaywallTitle}}</view>
      <view class="city-paywall-subtitle">{{i18n.contentPage.cityPaywallSubtitle}}</view>
      <view wx:if="{{!pendingSimulationOrder}}" class="city-purchase-options">
        <view wx:for="{{cityPurchaseOptions}}" wx:key="product" class="city-purchase-option {{item.featured ? 'featured' : ''}} {{!item.available ? 'unavailable' : ''}}" data-product="{{item.product}}" bindtap="onCityProductTap">
          <view class="city-purchase-copy">
            <view class="city-purchase-name">{{item.title}}<text wx:if="{{item.featured}}" class="city-purchase-badge">VIP</text></view>
            <view class="city-purchase-desc">{{item.description}}</view>
          </view>
          <view class="city-purchase-price">{{item.priceDisplay}} <text>›</text></view>
        </view>
      </view>
      <view wx:if="{{pendingSimulationOrder && simulationMode}}" class="city-simulation-box">
        <view class="city-simulation-title">{{i18n.paidContent.simulationTitle}}</view>
        <view class="city-simulation-order">{{selectedCityProductTitle}}</view>
        <button class="city-simulation-button" data-outcome="paid" bindtap="onSimulationPay" loading="{{purchaseLoading}}">{{i18n.paidContent.simulationSuccess}}</button>
        <button class="city-simulation-button secondary" data-outcome="failed" bindtap="onSimulationPay" loading="{{purchaseLoading}}">{{i18n.paidContent.simulationFailure}}</button>
      </view>
      <view wx:if="{{!pendingSimulationOrder}}" class="city-paywall-footnote">{{i18n.contentPage.cityPaywallFootnote}}</view>
      <view wx:if="{{!pendingSimulationOrder}}" class="city-paywall-later" bindtap="onCityPaywallClose">{{i18n.contentPage.cityPaywallClose}}</view>
    </view>
  </view>
</view>
<view wx:else class="city-empty">
  <view class="city-empty-title">{{i18n.contentPage.destinationEmpty}}</view>
  <view class="city-empty-desc">{{i18n.contentPage.destinationEmptyDesc}}</view>
  <view class="city-empty-action" bindtap="onBackToDestinations">{{i18n.contentPage.backToDestinations}}</view>
</view>
