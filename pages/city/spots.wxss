/* ============ 城市景点列表页（深色卡片） ============ */
page { background: #10131A; }

.spots-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: #10131A;
  color: #FFFFFF;
}

.spots-nav {
  height: 82rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.spots-title {
  flex: 1;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
}

.spots-buy {
  flex-shrink: 0;
  white-space: nowrap;
  padding: 8rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1E7BC0 0%, #1567A8 55%, #0F5488 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

/* ===== 卡片列表 ===== */
.spots-list { padding: 16rpx 32rpx 0; }

.spot-card {
  margin-bottom: 26rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #1C222E;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.35);
}

.spot-card-img-wrap { position: relative; }

.spot-card-img { width: 100%; height: 320rpx; display: block; }

.spot-card-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(16, 19, 26, 0) 40%, rgba(28, 34, 46, 0.66) 100%);
}

/* 左上规模标签 */
.spot-size-label {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.size-xl { background: rgba(198, 161, 91, 0.92); color: #FFFFFF; }
.size-lg { background: rgba(21, 103, 168, 0.9); color: #FFFFFF; }
.size-md { background: rgba(255, 255, 255, 0.2); color: #FFFFFF; }

/* 信息区 */
.spot-card-body {
  display: flex;
  padding: 24rpx 26rpx 28rpx;
}

.spot-logo {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.16);
}

.spot-info { flex: 1; min-width: 0; }

.spot-name-cn {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.spot-name-orig {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.46);
  font-size: 23rpx;
  line-height: 1.5;
}

.spot-summary {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 24rpx;
  line-height: 1.75;
}

.spots-footer {
  margin: 40rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.36);
  font-size: 21rpx;
  text-align: center;
}

.city-paywall-overlay { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, 0.62); }
.city-paywall-sheet { width: 100%; max-height: 84vh; overflow-y: auto; box-sizing: border-box; padding: 12rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #F8F7F3; color: #26333B; }
.city-paywall-topbar { height: 42rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.city-paywall-handle { width: 68rpx; height: 8rpx; border-radius: 8rpx; background: #D6D5D0; }
.city-paywall-close { position: absolute; right: 0; top: -4rpx; padding: 8rpx 4rpx; color: #68747A; font-size: 46rpx; line-height: 1; }
.city-paywall-eyebrow { margin-top: 14rpx; color: #A8894E; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.city-paywall-title { margin-top: 12rpx; color: #202B32; font-size: 38rpx; font-weight: 700; }
.city-paywall-subtitle { margin-top: 10rpx; color: #7B858A; font-size: 25rpx; }
.city-purchase-options { margin-top: 28rpx; }
.city-purchase-option { min-height: 112rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 16rpx; padding: 22rpx 24rpx; border: 2rpx solid #E1E3E2; border-radius: 22rpx; background: #FFFFFF; box-sizing: border-box; }
.city-purchase-option.featured { border-color: #D4B16C; background: #FFFEFB; }
.city-purchase-option.unavailable { opacity: 0.72; }
.city-purchase-copy { flex: 1; min-width: 0; }
.city-purchase-name { color: #2B3940; font-size: 28rpx; font-weight: 700; }
.city-purchase-badge { margin-left: 12rpx; padding: 4rpx 11rpx; border-radius: 18rpx; background: #EEE3CC; color: #91713D; font-size: 18rpx; }
.city-purchase-desc { margin-top: 8rpx; color: #818A8D; font-size: 22rpx; line-height: 1.5; }
.city-purchase-price { flex-shrink: 0; color: #176BAA; font-size: 31rpx; font-weight: 700; }
.city-purchase-price text { color: #9AA7AA; font-size: 36rpx; }
.city-paywall-footnote { margin-top: 22rpx; color: #A0A5A5; font-size: 20rpx; text-align: center; }
.city-paywall-later { padding: 26rpx 0 2rpx; color: #6F7A7E; font-size: 25rpx; text-align: center; }
.city-simulation-box { margin-top: 26rpx; padding: 24rpx; border-radius: 20rpx; background: #ECEBE6; color: #26333B; }
.city-simulation-title { font-size: 32rpx; font-weight: 700; }
.city-simulation-order { margin: 16rpx 0 24rpx; color: #68747A; font-size: 25rpx; }
.city-simulation-button { margin: 14rpx 0 0; border-radius: 40rpx; background: #176BAA; color: #FFFFFF; font-size: 27rpx; }
.city-simulation-button.secondary { background: #E8E9E8; color: #37454D; }

.spots-empty {
  padding: 180rpx 64rpx 80rpx;
  color: #FFFFFF;
  text-align: center;
}

.spots-page-empty {
  min-height: 100vh;
  box-sizing: border-box;
  background: #10131A;
}

.spots-empty-title {
  font-size: 36rpx;
  font-weight: 700;
}

.spots-empty-desc {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  line-height: 1.7;
}

.spots-empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin-top: 44rpx;
  border-radius: 42rpx;
  background: #1567A8;
  color: #FFFFFF;
  font-size: 28rpx;
}
