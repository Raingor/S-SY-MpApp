/* ============ 城市景点列表页（深色卡片） ============ */
page { background: #10131A; }

.spots-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: #10131A;
  color: #FFFFFF;
}

.spots-nav {
  height: 82rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.spots-title {
  flex: 1;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
}

.spots-buy {
  flex-shrink: 0;
  white-space: nowrap;
  padding: 10rpx 34rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1E7BC0 0%, #1567A8 55%, #0F5488 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
}

/* ===== 卡片列表 ===== */
.spots-list { padding: 16rpx 32rpx 0; }

.spot-card {
  margin-bottom: 26rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #1C222E;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.35);
}

.spot-card-img-wrap { position: relative; }

.spot-card-img { width: 100%; height: 320rpx; display: block; }

.spot-card-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(16, 19, 26, 0) 40%, rgba(28, 34, 46, 0.66) 100%);
}

/* 左上规模标签 */
.spot-size-label {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.size-xl { background: rgba(198, 161, 91, 0.92); color: #FFFFFF; }
.size-lg { background: rgba(21, 103, 168, 0.9); color: #FFFFFF; }
.size-md { background: rgba(255, 255, 255, 0.2); color: #FFFFFF; }

/* 信息区 */
.spot-card-body {
  display: flex;
  padding: 24rpx 26rpx 28rpx;
}

.spot-logo {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.16);
}

.spot-info { flex: 1; min-width: 0; }

.spot-name-cn {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.spot-name-orig {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.46);
  font-size: 23rpx;
  line-height: 1.5;
}

.spot-summary {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 24rpx;
  line-height: 1.75;
}

.spots-footer {
  margin: 40rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.36);
  font-size: 21rpx;
  text-align: center;
}
