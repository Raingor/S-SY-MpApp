<view class="spots-page" wx:if="{{city}}">
  <!-- 顶部导航 -->
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="spots-nav sy-nav" style="padding-right: {{menuRightSpace}}px;">
    <view class="spots-back sy-back-button" bindtap="onBack" hover-class="sy-back-button-hover" aria-label="{{i18n.back}}">
      <view class="sy-back-chevron"></view>
    </view>
    <view class="spots-title">{{city.name}}</view>
    <view class="spots-buy" bindtap="onBuy">
      <view>{{cityUnlocked ? i18n.contentPage.cityUnlocked : i18n.contentPage.buySpots}}</view>
      <view wx:if="{{cityPriceDisplay && !cityUnlocked}}" class="spots-buy-price">{{cityPriceDisplay}}</view>
    </view>
  </view>

  <!-- 景点卡片列表 -->
  <view class="spots-list" wx:if="{{spots.length}}">
    <view class="spot-card" wx:for="{{spots}}" wx:key="id" data-id="{{item.id}}" bindtap="onSpotTap">
      <view class="spot-card-img-wrap">
        <image class="spot-card-img" src="{{item.image}}" mode="aspectFill" />
        <view class="spot-card-mask"></view>
        <view class="spot-size-label {{item.sizeLabel === '超大型' ? 'size-xl' : (item.sizeLabel === '大型' ? 'size-lg' : 'size-md')}}">{{item.sizeLabel}}</view>
      </view>
      <view class="spot-card-body">
        <image class="spot-logo" src="{{item.logoSrc}}" mode="aspectFill" />
        <view class="spot-info">
          <view class="spot-name-cn">{{item.name}}</view>
          <view class="spot-name-orig">{{item.originalName}}</view>
          <view class="spot-summary">{{item.summary}}</view>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="spots-empty">
    <view class="spots-empty-title">{{i18n.contentPage.spotsEmpty}}</view>
    <view class="spots-empty-desc">{{i18n.contentPage.spotsEmptyDesc}}</view>
    <view class="spots-empty-action" bindtap="onBackToDestinations">{{i18n.contentPage.backToDestinations}}</view>
  </view>

  <view class="spots-footer">{{i18n.commonSlogan}}</view>
  <view wx:if="{{pendingSimulationOrder && simulationMode}}" class="city-simulation-overlay" catchtap="noop">
    <view class="city-simulation-modal" catchtap="noop">
      <view class="city-simulation-title">{{i18n.paidContent.simulationTitle}}</view>
      <view class="city-simulation-order">{{city.name}} · {{cityPriceDisplay}}</view>
      <button class="city-simulation-button" data-outcome="paid" bindtap="onSimulationPay" loading="{{purchaseLoading}}">{{i18n.paidContent.simulationSuccess}}</button>
      <button class="city-simulation-button secondary" data-outcome="failed" bindtap="onSimulationPay" loading="{{purchaseLoading}}">{{i18n.paidContent.simulationFailure}}</button>
    </view>
  </view>
</view>
<view wx:else class="spots-empty spots-page-empty">
  <view class="spots-empty-title">{{i18n.contentPage.destinationEmpty}}</view>
  <view class="spots-empty-desc">{{i18n.contentPage.destinationEmptyDesc}}</view>
  <view class="spots-empty-action" bindtap="onBackToDestinations">{{i18n.contentPage.backToDestinations}}</view>
</view>
