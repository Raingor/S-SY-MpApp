/* ============ 城市介绍页（深色 + 拼贴 Mosaic + 双 CTA） ============ */
page { background: #10131A; }

.city-page {
  min-height: 100vh;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: #10131A;
  color: #FFFFFF;
}

.city-nav {
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.city-mark {
  color: #C6A15B;
  font-size: 26rpx;
}

/* ===== 拼贴 Mosaic ===== */
.city-mosaic {
  position: relative;
  margin: 8rpx 24rpx 0;
  overflow: hidden;
  border-radius: 28rpx;
}

.mosaic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.mosaic-cell {
  width: calc((100% - 20rpx) / 3);
  height: 250rpx;
}

.mosaic-cell:nth-child(1) { width: calc((100% - 20rpx) / 3 * 2); height: 510rpx; }
.mosaic-cell:nth-child(4) { width: calc((100% - 20rpx) / 3 * 2); }

.mosaic-cell image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 暗色渐变遮罩 */
.mosaic-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(16, 19, 26, 0.18) 0%, rgba(16, 19, 26, 0.42) 55%, rgba(16, 19, 26, 0.9) 100%);
}

.mosaic-title-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 34rpx;
  z-index: 1;
  text-align: center;
}

.mosaic-title {
  font-size: 88rpx;
  line-height: 1.15;
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.6);
}

.mosaic-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
  letter-spacing: 6rpx;
}

/* ===== 统计 ===== */
.city-stats {
  display: flex;
  margin: 52rpx 32rpx 0;
}

.stat { flex: 1; text-align: center; }

.stat + .stat { border-left: 1rpx solid rgba(255, 255, 255, 0.1); }

.stat-value {
  color: #FFFFFF;
  font-family: Georgia, serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
}

/* ===== 说明入口 ===== */
.city-about {
  margin: 44rpx 32rpx 0;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  text-align: center;
  text-decoration: underline;
}

/* ===== 内容说明 ===== */
.city-note {
  margin: 52rpx 40rpx 0;
  padding: 30rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
}

.city-note-kicker {
  color: #C6A15B;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.city-note-text {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 27rpx;
  line-height: 1.85;
}

/* ===== 底部双 CTA ===== */
.city-cta {
  display: flex;
  gap: 20rpx;
  margin: 64rpx 32rpx 0;
}

.cta-buy {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1E7BC0 0%, #1567A8 55%, #0F5488 100%);
  box-shadow: 0 12rpx 26rpx rgba(21, 103, 168, 0.4);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-align: center;
}

.cta-view {
  flex: 1;
  height: 96rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-align: center;
}

.cta-label {
  padding-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  line-height: 1.2;
}

.cta-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  line-height: 1.2;
  opacity: 0.72;
}

.city-cta-press {
  opacity: 0.84;
  transform: scale(0.98);
}

.city-empty {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 260rpx 64rpx 80rpx;
  background: #10131A;
  color: #FFFFFF;
  text-align: center;
}

.city-empty-title {
  font-size: 38rpx;
  font-weight: 700;
}

.city-empty-desc {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  line-height: 1.7;
}

.city-empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin-top: 44rpx;
  border-radius: 42rpx;
  background: #1567A8;
  color: #FFFFFF;
  font-size: 28rpx;
}

.city-paywall-overlay { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, 0.62); }
.city-paywall-sheet { width: 100%; max-height: 84vh; overflow-y: auto; box-sizing: border-box; padding: 12rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #F8F7F3; color: #26333B; }
.city-paywall-topbar { height: 42rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.city-paywall-handle { width: 68rpx; height: 8rpx; border-radius: 8rpx; background: #D6D5D0; }
.city-paywall-close { position: absolute; right: 0; top: -4rpx; padding: 8rpx 4rpx; color: #68747A; font-size: 46rpx; line-height: 1; }
.city-paywall-eyebrow { margin-top: 14rpx; color: #A8894E; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.city-paywall-title { margin-top: 12rpx; color: #202B32; font-size: 38rpx; font-weight: 700; }
.city-paywall-subtitle { margin-top: 10rpx; color: #7B858A; font-size: 25rpx; }
.city-purchase-options { margin-top: 28rpx; }
.city-purchase-option { min-height: 112rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 16rpx; padding: 22rpx 24rpx; border: 2rpx solid #E1E3E2; border-radius: 22rpx; background: #FFFFFF; box-sizing: border-box; }
.city-purchase-option.featured { border-color: #D4B16C; background: #FFFEFB; }
.city-purchase-option.unavailable { opacity: 0.72; }
.city-purchase-copy { flex: 1; min-width: 0; }
.city-purchase-name { color: #2B3940; font-size: 28rpx; font-weight: 700; }
.city-purchase-badge { margin-left: 12rpx; padding: 4rpx 11rpx; border-radius: 18rpx; background: #EEE3CC; color: #91713D; font-size: 18rpx; }
.city-purchase-desc { margin-top: 8rpx; color: #818A8D; font-size: 22rpx; line-height: 1.5; }
.city-purchase-price { flex-shrink: 0; color: #176BAA; font-size: 31rpx; font-weight: 700; }
.city-purchase-price text { color: #9AA7AA; font-size: 36rpx; }
.city-paywall-footnote { margin-top: 22rpx; color: #A0A5A5; font-size: 20rpx; text-align: center; }
.city-paywall-later { padding: 26rpx 0 2rpx; color: #6F7A7E; font-size: 25rpx; text-align: center; }
.city-simulation-box { margin-top: 26rpx; padding: 24rpx; border-radius: 20rpx; background: #ECEBE6; }
.city-simulation-title { font-size: 32rpx; font-weight: 700; }
.city-simulation-order { margin: 16rpx 0 24rpx; color: #68747A; font-size: 25rpx; }
.city-simulation-button { margin: 14rpx 0 0; border-radius: 40rpx; background: #176BAA; color: #FFFFFF; font-size: 27rpx; }
.city-simulation-button.secondary { background: #E8E9E8; color: #37454D; }
