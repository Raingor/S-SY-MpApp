<view class="knowledge-page">
  <view class="knowledge-hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="knowledge-nav sy-nav"><view class="knowledge-back sy-back-button" bindtap="onBack"><view class="sy-back-chevron"></view></view><view class="knowledge-brand">{{i18n.brand}}</view></view>
    <view class="knowledge-hero-body"><view class="knowledge-kicker">GREEK HERITAGE</view><view class="knowledge-title serif">{{i18n.knowledgePage.title}}</view><view class="knowledge-subtitle">{{i18n.heritage.libraryIntro}}</view></view>
  </view>
  <view class="knowledge-panel-tabs" role="tablist"><view wx:for="{{panelTabs}}" wx:key="*this" class="knowledge-panel-tab {{activePanel === index ? 'knowledge-panel-tab-active' : ''}}" data-index="{{index}}" bindtap="onPanelTap" role="tab" aria-selected="{{activePanel === index}}"><view class="knowledge-panel-tab-index">0{{index + 1}}</view><view>{{item}}</view></view></view>
  <view wx:if="{{offline}}" class="knowledge-product-empty card">{{i18n.heritage.offlineNotice}}</view>
  <view wx:if="{{contentError}}" class="knowledge-product-empty card">{{i18n.heritage.networkFailed}} <view bindtap="refresh">{{i18n.heritage.retry}} ›</view></view>
  <block wx:if="{{activePanel === 0}}">
    <view class="knowledge-product-intro"><view class="knowledge-product-title serif">{{i18n.heritage.sights}}</view><view class="knowledge-product-copy">{{i18n.heritage.sightsIntro}}</view></view>
    <view class="knowledge-product-search card"><input value="{{searchQuery}}" confirm-type="search" placeholder="{{i18n.heritage.searchSights}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" /></view>
    <scroll-view wx:if="{{!audioOnly && cities.length}}" class="knowledge-product-categories" scroll-x="true"><view class="knowledge-product-category {{!categoryId ? 'knowledge-product-category-on' : ''}}" data-id="" bindtap="onCategoryTap">{{i18n.heritage.allCities}}</view><view wx:for="{{cities}}" wx:key="id" class="knowledge-product-category {{categoryId === item.id ? 'knowledge-product-category-on' : ''}}" data-id="{{item.id}}" bindtap="onCategoryTap">{{locale === 'en' ? (item.nameEn || item.name) : (locale === 'zh-TW' ? (item.nameTw || item.name) : item.name)}}</view></scroll-view>
    <view wx:if="{{loading}}" class="knowledge-product-empty card">{{i18n.loading}}</view>
    <view wx:elif="{{hotSpots.length}}" class="knowledge-hot-grid"><view wx:for="{{hotSpots}}" wx:key="id" class="knowledge-hot-card card" data-id="{{item.id}}" bindtap="onHotSpotTap"><view class="knowledge-hot-image"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" /></view><view class="knowledge-hot-body"><view class="knowledge-hot-name serif">{{item.displayName}}</view><view class="knowledge-hot-desc">{{item.displaySummary}}</view><view>{{i18n.heritage.visitorAndPreview}} ›</view></view></view></view>
    <view wx:else class="knowledge-product-empty card">{{audioOnly ? i18n.heritage.noPreviews : i18n.heritage.noSights}}</view>
    <block wx:if="{{!audioOnly}}">
      <view wx:if="{{cities.length}}" class="knowledge-catalog"><view class="knowledge-heading serif">{{i18n.knowledgePage.cities}}</view><view class="city-grid"><view class="city-card card" wx:for="{{cities}}" wx:key="id" data-id="{{item.id}}" bindtap="onCityTap"><image wx:if="{{item.cover}}" class="city-card-img" src="{{item.cover}}" mode="aspectFill" /><view class="city-card-mask"></view><view class="city-card-info"><view class="city-card-name serif">{{locale === 'en' ? (item.nameEn || item.name) : (locale === 'zh-TW' ? (item.nameTw || item.name) : item.name)}}</view><view class="city-card-sub">{{item.subtitle}}</view></view><view class="city-card-arrow">›</view></view></view></view>
      <view wx:if="{{sampleTrips.length}}" class="trip-section"><view class="knowledge-heading serif">{{i18n.knowledgePage.trips}}</view><view class="trip-row card" wx:for="{{sampleTrips}}" wx:key="id" data-id="{{item.id}}" bindtap="onTripTap"><image wx:if="{{item.img}}" class="trip-thumb" src="{{item.img}}" mode="aspectFill" /><view class="trip-info"><view class="trip-name ellipsis">{{item.title}}</view><view class="trip-highlights ellipsis">{{item.highlights}}</view></view><view class="trip-arrow">›</view></view><view class="trip-more" bindtap="onMoreTrips">{{i18n.knowledgePage.viewTrips}} ›</view></view>
    </block>
  </block>
  <block wx:else><view class="knowledge-product-intro"><view class="knowledge-product-title serif">{{i18n.heritage.history}}</view><view class="knowledge-product-copy">{{i18n.heritage.albumsIntro}}</view></view><view class="knowledge-product-search card"><input value="{{searchQuery}}" confirm-type="search" placeholder="{{i18n.heritage.searchAlbums}}" bindinput="onSearchInput" /></view><view wx:if="{{loading}}" class="knowledge-product-empty card">{{i18n.loading}}</view><view wx:elif="{{visibleAlbums.length}}" class="heritage-albums"><view wx:for="{{visibleAlbums}}" wx:key="id" class="heritage-album card" data-id="{{item.id}}" bindtap="onAlbumTap"><image wx:if="{{item.cover}}" class="heritage-album-cover" src="{{item.cover}}" mode="aspectFill" /><view class="heritage-album-body"><view class="heritage-album-title serif">{{item.displayTitle}}</view><view class="heritage-album-desc">{{item.displayDescription}}</view><view class="heritage-album-meta">{{item.episodes.length}} {{i18n.heritage.episodes}} <text wx:if="{{item.durationMinutes}}"> · {{item.durationMinutes}} {{i18n.heritage.minutes}}</text> ›</view></view></view></view><view wx:else class="knowledge-product-empty card">{{contentError ? i18n.heritage.networkFailed : i18n.heritage.noAlbums}}</view></block>
  <view class="knowledge-consult card" bindtap="onConsult"><view><view class="consult-title serif">{{i18n.knowledgePage.consultTitle}}</view><view class="consult-copy">{{i18n.knowledgePage.consultDesc}}</view></view><view class="consult-arrow">›</view></view>
</view>
