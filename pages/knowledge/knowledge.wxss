/* ============ 服务4：景点区（博物旅人风格） ============ */
.knowledge-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: #F4F7FA;
  color: #16283A;
}

.knowledge-hero {
  position: relative;
  padding: 0 32rpx 76rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #071F34, #0B3C5D 70%, #364D71);
  color: #FFFFFF;
}

.knowledge-hero::after {
  content: '';
  position: absolute;
  right: -140rpx;
  top: 220rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
  box-shadow: 0 0 0 60rpx rgba(255, 255, 255, 0.025);
}

.knowledge-nav {
  position: relative;
  z-index: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.82);
}

.knowledge-brand { font-size: 20rpx; letter-spacing: 2rpx; }
.knowledge-mark { color: #D8B878; font-size: 26rpx; }

.knowledge-hero-body {
  position: relative;
  z-index: 1;
  padding-top: 50rpx;
}

.knowledge-kicker,
.knowledge-section-kicker,
.consult-kicker {
  color: #C6A15B;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.knowledge-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.35;
}

.knowledge-subtitle {
  max-width: 600rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.8;
}

.knowledge-pills { display: flex; gap: 12rpx; margin-top: 28rpx; }

.knowledge-pills text {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 22rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 18rpx;
}

.knowledge-catalog,
.spot-list-wrap,
.trip-section {
  padding: 56rpx 32rpx 0;
}

.knowledge-heading {
  margin-top: 16rpx;
  color: #0B3C5D;
  font-size: 38rpx;
}

.card {
  background: #FFFFFF;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 精选城市卡片 */
.city-grid { margin-top: 26rpx; }

.city-card {
  position: relative;
  height: 240rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
}

.city-card-img { width: 100%; height: 100%; }

.city-card-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(11, 60, 93, 0.62) 0%, rgba(11, 60, 93, 0.16) 100%);
}

.city-card-info {
  position: absolute;
  left: 28rpx;
  right: 100rpx;
  bottom: 26rpx;
  z-index: 1;
  color: #FFFFFF;
}

.city-card-name { font-size: 36rpx; text-shadow: 0 4rpx 12rpx rgba(7, 31, 52, 0.4); }

.city-card-sub {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
}

.city-card-stats {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(7, 31, 52, 0.5);
  color: rgba(255, 255, 255, 0.86);
  font-size: 17rpx;
}

.city-card-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 34rpx;
  z-index: 1;
  color: rgba(255, 255, 255, 0.8);
  font-family: Georgia, serif;
  font-size: 40rpx;
}

/* 关联参考行程 */
.trip-section { padding-top: 20rpx; }

.trip-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx;
}

.trip-thumb {
  flex-shrink: 0;
  width: 132rpx;
  height: 100rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
}

.trip-info { flex: 1; min-width: 0; }

.trip-name { color: #0B3C5D; font-size: 25rpx; font-weight: 600; }

.trip-highlights {
  margin-top: 4rpx;
  color: #5B6B7A;
  font-size: 19rpx;
}

.trip-days { margin-top: 4rpx; color: #8AA3B5; font-size: 17rpx; }

.trip-arrow {
  margin-left: 12rpx;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 34rpx;
}

.trip-more {
  margin-top: 22rpx;
  color: #1567A8;
  font-size: 22rpx;
  text-align: center;
}

/* 咨询入口 */
.knowledge-consult {
  display: flex;
  align-items: center;
  margin: 44rpx 32rpx 0;
  padding: 26rpx 24rpx;
}

.consult-title { margin-top: 8rpx; color: #0B3C5D; font-size: 28rpx; }

.consult-copy { margin-top: 4rpx; color: #8AA3B5; font-size: 18rpx; }

.consult-arrow {
  margin-left: auto;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 34rpx;
}

.knowledge-footer {
  margin: 56rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid #DCE8ED;
  color: #8AA3B5;
  font-size: 18rpx;
  line-height: 1.7;
  text-align: center;
}
