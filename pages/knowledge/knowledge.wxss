/* ============ 服务4：景点文史知识库 ============ */
.knowledge-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: #F4F7FA;
  color: #16283A;
}

.knowledge-hero {
  position: relative;
  padding: 0 32rpx 76rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #071F34, #0B3C5D 70%, #364D71);
  color: #FFFFFF;
}

.knowledge-hero::after {
  content: '';
  position: absolute;
  right: -140rpx;
  top: 220rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
  box-shadow: 0 0 0 60rpx rgba(255, 255, 255, 0.025);
}

.knowledge-nav {
  position: relative;
  z-index: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.82);
}

.knowledge-back { width: 56rpx; font-family: Georgia, serif; font-size: 48rpx; }
.knowledge-brand { font-size: 20rpx; letter-spacing: 2rpx; }
.knowledge-mark { color: #D8B878; font-size: 26rpx; }

.knowledge-hero-body {
  position: relative;
  z-index: 1;
  padding-top: 50rpx;
}

.knowledge-kicker,
.knowledge-section-kicker,
.spot-en,
.consult-kicker {
  color: #C6A15B;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.knowledge-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.35;
}

.knowledge-subtitle {
  max-width: 600rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.8;
}

.knowledge-pills {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.knowledge-pills text {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 22rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 18rpx;
}

.knowledge-catalog {
  padding: 68rpx 32rpx 0;
}

.knowledge-heading {
  margin-top: 16rpx;
  color: #0B3C5D;
  font-size: 38rpx;
}

.spot-scroll {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}

.spot-tab {
  display: inline-block;
  width: 148rpx;
  margin-right: 14rpx;
  padding-bottom: 14rpx;
  color: #5B6B7A;
  font-size: 21rpx;
  text-align: center;
  vertical-align: top;
}

.spot-tab image {
  width: 148rpx;
  height: 118rpx;
  display: block;
  margin-bottom: 10rpx;
  border-radius: 14rpx;
  opacity: 0.7;
}

.spot-tab text {
  display: block;
  margin-top: 3rpx;
  color: #8AA3B5;
  font-size: 16rpx;
}

.spot-tab-on {
  color: #1567A8;
  font-weight: 600;
}

.spot-tab-on image {
  opacity: 1;
  box-shadow: 0 0 0 4rpx #C6A15B;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(11, 60, 93, 0.08);
}

.spot-detail {
  margin-top: 22rpx;
  overflow: hidden;
}

.spot-cover {
  width: 100%;
  height: 300rpx;
  display: block;
}

.spot-detail-body {
  padding: 28rpx;
}

.spot-en {
  color: #2E75A0;
  font-size: 17rpx;
}

.spot-name {
  margin-top: 5rpx;
  color: #0B3C5D;
  font-size: 36rpx;
}

.spot-intro,
.preview-copy {
  color: #5B6B7A;
  font-size: 23rpx;
  line-height: 1.8;
}

.spot-intro { margin-top: 18rpx; }

.preview-label,
.locked-label {
  margin-top: 28rpx;
  color: #16283A;
  font-size: 21rpx;
  font-weight: 600;
}

.preview-label text,
.locked-label text {
  margin-right: 10rpx;
  color: #1567A8;
  font-family: Georgia, serif;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.preview-copy {
  margin-top: 10rpx;
  color: #5B6B7A;
}

.preview-audio {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #DCE8ED;
  border-radius: 16rpx;
  color: #1567A8;
  font-size: 21rpx;
}

.play-icon {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #EAF4F9;
  font-size: 19rpx;
}

.preview-audio text {
  display: block;
  margin-top: 2rpx;
  color: #8AA3B5;
  font-size: 17rpx;
}

.preview-arrow,
.consult-arrow {
  margin-left: auto;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 34rpx;
}

.locked-label { color: #16283A; }
.locked-label text { color: #C6A15B; }

.locked-list {
  margin-top: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #F4F7FA;
  color: #5B6B7A;
  font-size: 20rpx;
  line-height: 2.2;
}

.locked-list > view { display: flex; align-items: center; }
.locked-list > view > text:first-child { margin-right: 8rpx; color: #C6A15B; }
.lock-mark { margin-left: auto; color: #A7B8C1; font-size: 17rpx; }

.unlock-button {
  height: 70rpx;
  margin-top: 22rpx;
  border-radius: 36rpx;
  background: #0B3C5D;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 70rpx;
  text-align: center;
}

.knowledge-consult {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
}

.consult-title {
  margin-top: 8rpx;
  color: #0B3C5D;
  font-size: 28rpx;
}

.consult-copy {
  margin-top: 4rpx;
  color: #8AA3B5;
  font-size: 18rpx;
}

.knowledge-footer {
  margin: 56rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid #DCE8ED;
  color: #8AA3B5;
  font-size: 18rpx;
  line-height: 1.7;
  text-align: center;
}
