/* ============ 服务4：景点区（博物旅人风格） ============ */
.knowledge-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: #F4F7FA;
  color: #16283A;
}

.knowledge-hero {
  position: relative;
  padding: 0 32rpx 76rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #071F34, #0B3C5D 70%, #364D71);
  color: #FFFFFF;
}

.knowledge-hero::after {
  content: '';
  position: absolute;
  right: -140rpx;
  top: 220rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
  box-shadow: 0 0 0 60rpx rgba(255, 255, 255, 0.025);
}

.knowledge-nav {
  position: relative;
  z-index: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.82);
}

.knowledge-back { width: 56rpx; font-family: Georgia, serif; font-size: 48rpx; }
.knowledge-brand { font-size: 20rpx; letter-spacing: 2rpx; }
.knowledge-mark { color: #D8B878; font-size: 26rpx; }

.knowledge-hero-body {
  position: relative;
  z-index: 1;
  padding-top: 50rpx;
}

.knowledge-kicker,
.knowledge-section-kicker,
.consult-kicker {
  color: #C6A15B;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.knowledge-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.35;
}

.knowledge-subtitle {
  max-width: 600rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.8;
}

.knowledge-pills { display: flex; gap: 12rpx; margin-top: 28rpx; }

.knowledge-pills text {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 22rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 18rpx;
}

.knowledge-catalog,
.spot-list-wrap,
.trip-section {
  padding: 56rpx 32rpx 0;
}

.knowledge-heading {
  margin-top: 16rpx;
  color: #0B3C5D;
  font-size: 38rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(11, 60, 93, 0.08);
}

/* 精选城市横滑 */
.city-scroll {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}

.city-tab {
  display: inline-block;
  width: 176rpx;
  margin-right: 16rpx;
  padding-bottom: 14rpx;
  color: #5B6B7A;
  font-size: 22rpx;
  text-align: center;
  vertical-align: top;
}

.city-tab image {
  width: 176rpx;
  height: 132rpx;
  display: block;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  opacity: 0.72;
}

.city-tab text {
  display: block;
  margin-top: 3rpx;
  color: #8AA3B5;
  font-size: 16rpx;
}

.city-tab-on { color: #1567A8; font-weight: 600; }

.city-tab-on image {
  opacity: 1;
  box-shadow: 0 0 0 4rpx #C6A15B;
}

/* 景点列表（封面图 + 名称） */
.spot-grid { margin-top: 26rpx; }

.spot-item {
  display: flex;
  margin-bottom: 22rpx;
  overflow: hidden;
}

.spot-item-img {
  flex-shrink: 0;
  width: 220rpx;
  height: 100%;
  min-height: 240rpx;
}

.spot-item-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
}

.spot-item-name { color: #0B3C5D; font-size: 30rpx; }

.spot-item-cat {
  margin-top: 6rpx;
  color: #1567A8;
  font-size: 18rpx;
}

.spot-item-intro {
  margin-top: 10rpx;
  color: #5B6B7A;
  font-size: 20rpx;
  line-height: 1.7;
}

.spot-item-cta {
  margin-top: 12rpx;
  color: #C6A15B;
  font-size: 19rpx;
}

.spot-item-cta text { font-family: Georgia, serif; }

/* 关联参考行程 */
.trip-section { padding-top: 56rpx; }

.trip-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx;
}

.trip-thumb {
  flex-shrink: 0;
  width: 132rpx;
  height: 100rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
}

.trip-info { flex: 1; min-width: 0; }

.trip-name { color: #0B3C5D; font-size: 25rpx; font-weight: 600; }

.trip-highlights {
  margin-top: 4rpx;
  color: #5B6B7A;
  font-size: 19rpx;
}

.trip-days { margin-top: 4rpx; color: #8AA3B5; font-size: 17rpx; }

.trip-arrow {
  margin-left: 12rpx;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 34rpx;
}

.trip-more {
  margin-top: 22rpx;
  color: #1567A8;
  font-size: 22rpx;
  text-align: center;
}

/* 咨询入口 */
.knowledge-consult {
  display: flex;
  align-items: center;
  margin: 44rpx 32rpx 0;
  padding: 26rpx 24rpx;
}

.consult-title { margin-top: 8rpx; color: #0B3C5D; font-size: 28rpx; }

.consult-copy { margin-top: 4rpx; color: #8AA3B5; font-size: 18rpx; }

.consult-arrow {
  margin-left: auto;
  color: #8AA3B5;
  font-family: Georgia, serif;
  font-size: 34rpx;
}

.knowledge-footer {
  margin: 56rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid #DCE8ED;
  color: #8AA3B5;
  font-size: 18rpx;
  line-height: 1.7;
  text-align: center;
}
