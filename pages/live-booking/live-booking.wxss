.live-page{min-height:100vh;padding-bottom:50rpx;background:#F4F7FA;color:#16283A}.live-hero{padding:0 32rpx 40rpx;background:linear-gradient(150deg,#082F49,#0B3C5D 58%,#1567A8);color:#fff}.live-nav{height:84rpx;display:flex;align-items:center;justify-content:space-between}.back{font-size:58rpx;font-weight:200;line-height:1;color:#CFE0EE}.brand{font-size:26rpx;font-weight:600}.mark{color:#D8B878;font-size:28rpx}.eyebrow,.form-kicker{color:#C6A15B;font-size:18rpx;letter-spacing:3rpx}.live-title{margin-top:16rpx;font-size:50rpx;line-height:1.3}.live-sub{margin-top:12rpx;color:#CFE0EE;font-size:26rpx;line-height:1.7}.compliance{margin:24rpx 32rpx 0;padding:24rpx 26rpx;border:1rpx solid #E1C68E;border-radius:18rpx;background:#FFFAF0;color:#765A21;font-size:24rpx;line-height:1.7}.compliance-title{margin-bottom:8rpx;font-weight:700;color:#513B12}.live-contact{padding:26rpx 28rpx}.live-service-note{padding:26rpx 28rpx}.live-service-title{color:#0B3C5D;font-size:30rpx;font-weight:700}.live-service-item{display:flex;align-items:flex-start;gap:14rpx;margin-top:16rpx;color:#4D6171;font-size:24rpx;line-height:1.65}.live-service-index{flex:0 0 auto;color:#C08D3B;font-family:Inter,sans-serif;font-size:20rpx;font-weight:700;letter-spacing:1rpx}.live-service-notice{margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #E8EEF2;color:#765A21;font-size:23rpx;line-height:1.65}.live-contact-title{color:#0B3C5D;font-size:30rpx;font-weight:700}.live-contact-desc{margin-top:8rpx;color:#5B6B7A;font-size:23rpx;line-height:1.6}.live-contact-actions{display:flex;gap:16rpx;margin-top:18rpx}.live-contact-actions button{display:flex;align-items:center;justify-content:center;flex:1;min-height:66rpx;height:66rpx;margin:0;padding:0 16rpx;box-sizing:border-box;border:1rpx solid #1567A8;border-radius:34rpx;background:#FFFFFF;color:#1567A8;font-size:24rpx;line-height:1.2;text-align:center}.live-contact-actions button:last-child{background:#1567A8;color:#FFFFFF}.live-contact-actions button::after{border:0}.card{margin:24rpx 32rpx 0;border-radius:20rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(8,47,73,.08)}.form{padding:30rpx 28rpx}.form-kicker{margin-bottom:20rpx;color:#1567A8}.field{padding:22rpx 0;border-bottom:1rpx solid #EDF1F4}.label{margin-bottom:12rpx;color:#16283A;font-size:25rpx;font-weight:600}.field input,.field textarea,.picker{width:100%;box-sizing:border-box;color:#16283A;font-size:27rpx}.field textarea{min-height:150rpx;line-height:1.7}.muted{color:#8AA3B5}.submit,.done{display:flex;align-items:center;justify-content:center;height:82rpx;margin:28rpx 0 0;padding:0 24rpx;box-sizing:border-box;border:0;border-radius:42rpx;background:#1567A8;color:#fff;font-size:28rpx;font-weight:700;line-height:1.2;text-align:center}.submit::after,.done::after,.wechat button::after{border:0}.footer-note{padding:28rpx 54rpx;color:#8AA3B5;font-size:21rpx;line-height:1.7;text-align:center}.overlay{position:fixed;z-index:30;inset:0;display:flex;align-items:center;justify-content:center;padding:32rpx;background:rgba(8,47,73,.62)}.success{width:100%;padding:42rpx 30rpx 30rpx;text-align:center}.success-icon{width:72rpx;height:72rpx;margin:0 auto 20rpx;border-radius:50%;background:#2C8C66;color:#fff;font-size:48rpx;line-height:72rpx}.success-title{font-size:38rpx;color:#0B3C5D}.success-copy{margin:16rpx 0 24rpx;color:#5B6B7A;font-size:25rpx;line-height:1.7}.wechat{display:flex;align-items:center;justify-content:space-between;padding:22rpx;border-radius:14rpx;background:#F1F6F9;text-align:left}.wechat-label{color:#8AA3B5;font-size:22rpx}.wechat-id{margin-top:6rpx;color:#1567A8;font-family:Inter,sans-serif;font-size:30rpx;font-weight:700;letter-spacing:2rpx}.wechat button{display:flex;align-items:center;justify-content:center;min-width:150rpx;height:60rpx;margin:0;padding:0 20rpx;box-sizing:border-box;border-radius:30rpx;background:#1567A8;color:#fff;font-size:23rpx;line-height:1.2;text-align:center}.done{margin-top:24rpx}.live-contact-actions button[disabled],.submit[disabled],.done[disabled],.wechat button[disabled]{opacity:.58}
