<view class="live-page">
  <view class="live-hero"><view style="height: {{statusBarHeight}}px;"></view><view class="live-nav"><view class="back" bindtap="onBack">‹</view><view class="brand">{{i18n.brand}}</view><view class="mark">✦</view></view><view class="eyebrow">LIVE HUMANITIES SESSION</view><view class="live-title serif">{{i18n.liveBooking.title}}</view><view class="live-sub">{{i18n.liveBooking.subtitle}}</view></view>
  <view class="compliance"><view class="compliance-title">{{i18n.liveBooking.complianceTitle}}</view><view>{{i18n.liveBooking.compliance}}</view></view>
  <view class="form card"><view class="form-kicker">RESERVE A SESSION</view><view class="field"><view class="label">{{i18n.liveBooking.name}} *</view><input value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="{{i18n.liveBooking.namePlaceholder}}" /></view><view class="field"><view class="label">{{i18n.liveBooking.phone}} *</view><input type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="onInput" placeholder="{{i18n.liveBooking.phonePlaceholder}}" /></view><view class="field"><view class="label">{{i18n.liveBooking.attraction}} *</view><picker range="{{spots}}" range-key="name" bindchange="onSpotChange"><view class="picker {{form.attraction ? '' : 'muted'}}">{{form.attraction || i18n.liveBooking.chooseAttraction}} ›</view></picker></view><view class="field"><view class="label">{{i18n.liveBooking.time}} *</view><picker range="{{timeSlots}}" bindchange="onTimeChange"><view class="picker {{form.timeSlot ? '' : 'muted'}}">{{form.timeSlot || i18n.liveBooking.chooseTime}} ›</view></picker></view><view class="field"><view class="label">{{i18n.liveBooking.note}}</view><textarea maxlength="300" value="{{form.note}}" data-field="note" bindinput="onInput" placeholder="{{i18n.liveBooking.notePlaceholder}}"></textarea></view><button class="submit" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? i18n.submitting : i18n.liveBooking.submit}}</button></view>
  <view class="footer-note">{{i18n.liveBooking.footer}}</view>
  <view wx:if="{{submitted}}" class="overlay"><view class="success card"><view class="success-icon">✓</view><view class="success-title serif">{{i18n.liveBooking.successTitle}}</view><view class="success-copy">{{i18n.liveBooking.successCopy}}</view><view class="wechat"><view><view class="wechat-label">{{i18n.liveBooking.wechat}}</view><view class="wechat-id">SYGJ1130</view></view><button bindtap="onCopyWechat">{{i18n.liveBooking.copy}}</button></view><button class="done" bindtap="onDone">{{i18n.liveBooking.done}}</button></view></view>
</view>
