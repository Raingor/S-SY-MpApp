/* 胶囊式自定义 TabBar（适配全面屏安全区） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  pointer-events: none;
}

.tabbar-inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 112rpx;
  padding: 0 14rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-radius: 60rpx;
  box-shadow: 0 -6rpx 24rpx rgba(11, 60, 93, 0.1), 0 12rpx 36rpx rgba(11, 60, 93, 0.14);
  pointer-events: auto;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-top: 14rpx;
  padding-bottom: 10rpx;
  transition: transform 120ms ease, opacity 120ms ease;
}

.tab-item-hover {
  transform: scale(0.96);
  opacity: 0.78;
}

.tab-text {
  font-size: 22rpx;
  color: #5B6B7A;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

.tab-item.active .tab-text {
  color: #1567A8;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 10rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #C6A15B;
  transform: translateX(-50%);
}

.tab-item.active .tab-icon {
  opacity: 1;
}

.tab-icon {
  opacity: 0.65;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 图标（纯 CSS 绘制） ===== */
/* 首页：屋形 */
.icon-home {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}
.icon-home-roof {
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 34rpx;
  height: 34rpx;
  border-top: 5rpx solid currentColor;
  border-left: 5rpx solid currentColor;
  transform: translateX(-50%) rotate(45deg);
  border-radius: 4rpx;
}
.icon-home-body {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 20rpx;
  border-left: 5rpx solid currentColor;
  border-right: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  border-radius: 0 0 6rpx 6rpx;
}
.tab-item.active .icon-home {
  color: #1567A8;
}
.tab-item .icon-home {
  color: #5B6B7A;
}

/* 我的：人形 */
.icon-user {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}
.icon-user-head {
  position: absolute;
  top: 3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 5rpx solid currentColor;
}
.icon-user-body {
  position: absolute;
  bottom: 1rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 34rpx;
  height: 14rpx;
  border: 5rpx solid currentColor;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
}
.tab-item.active .icon-user {
  color: #1567A8;
}
.tab-item .icon-user {
  color: #5B6B7A;
}

/* ===== 中间凸起主按钮「立即联系」 ===== */
.tab-center {
  position: relative;
}

.center-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(-28rpx);
}

.center-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(140deg, #1E7BC0 0%, #1567A8 50%, #0F5488 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 26rpx rgba(21, 103, 168, 0.4), 0 0 0 8rpx rgba(255, 255, 255, 0.92);
}

/* 对话气泡图标 */
.icon-chat {
  position: relative;
  width: 48rpx;
  height: 38rpx;
  border: 6rpx solid #FFFFFF;
  border-radius: 12rpx;
}
.icon-chat::after {
  content: '';
  position: absolute;
  left: 9rpx;
  bottom: -12rpx;
  width: 0;
  height: 0;
  border-top: 12rpx solid #FFFFFF;
  border-right: 12rpx solid transparent;
}
.icon-chat::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #FFFFFF;
  box-shadow: 14rpx 0 #FFFFFF;
}

.center-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #0B3C5D;
  letter-spacing: 1rpx;
}
