/* ============================================
   SY希旅人 · 全局样式（设计系统）
   色彩：爱琴海主蓝 #1567A8 / 深海蓝 #0B3C5D
        页面底 #F4F7FA / 卡片白 #FFFFFF / 沙金 #C6A15B
   正文 #16283A / 次要 #5B6B7A / 弱 #8AA3B5
   ============================================ */

page {
  --c-primary: #1567A8;
  --c-deep: #0B3C5D;
  --c-bg: #F4F7FA;
  --c-card: #FFFFFF;
  --c-gold: #C6A15B;
  --c-text: #16283A;
  --c-sub: #5B6B7A;
  --c-weak: #8AA3B5;
  --c-line: #DCE8ED;
  --c-muted: #EEF3F7;
  --radius-card: 28rpx;
  --radius-control: 18rpx;
  --shadow-card: 0 12rpx 28rpx rgba(11, 60, 93, 0.08);
  --shadow-float: 0 14rpx 34rpx rgba(11, 60, 93, 0.16);
  --page-gutter: 32rpx;
  --tabbar-safe-bottom: 220rpx;

  background: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, 'Noto Sans SC',
    'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  /* 正文默认字号提升；标题与按钮由各自组件保留独立层级 */
  font-size: 30rpx;
  line-height: 1.65;
}

/* 衬线品牌标题 */
.serif {
  font-family: 'Source Han Serif CN', 'Songti SC', 'Noto Serif SC',
    Georgia, serif;
  font-weight: 600;
}

/* 英文小标（大写字距） */
.eyebrow {
  font-family: 'Inter', -apple-system, sans-serif;
  font-weight: 500;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: var(--c-weak);
}

/* 通用卡片 */
.card {
  background: var(--c-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.card-press {
  opacity: 0.92;
  transform: scale(0.985);
}

/* 统一页面导航：爱琴海玻璃质感 */
.sy-nav {
  padding: 0 24rpx;
  box-sizing: border-box;
}

.sy-back-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(7, 31, 52, 0.34), rgba(7, 31, 52, 0.78));
  box-shadow: 0 10rpx 24rpx rgba(7, 31, 52, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
  transition: transform 120ms ease, background 120ms ease, border-color 120ms ease;
}

.sy-back-chevron {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: translateX(3rpx) rotate(45deg);
}

.sy-back-button-hover {
  border-color: rgba(255, 255, 255, 0.68);
  background: linear-gradient(145deg, rgba(7, 31, 52, 0.52), rgba(7, 31, 52, 0.9));
  transform: scale(0.96);
}

.sy-back-button-light {
  border-color: #DCE8ED;
  background: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(11, 60, 93, 0.08);
}

.sy-back-button-light .sy-back-chevron {
  border-color: var(--c-primary);
}

.sy-back-button-light.sy-back-button-hover {
  border-color: #BBD8EA;
  background: #F4F9FC;
}

.sy-back-button-light-hover {
  border-color: #BBD8EA;
  background: #F4F9FC;
  transform: scale(0.96);
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 沙金「价格电询」按钮 */
.btn-inquiry {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #D8B878 0%, #C6A15B 60%, #B08D45 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 20rpx rgba(198, 161, 91, 0.35);
}

.btn-inquiry::after {
  border: none;
}

/* 主按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1E7BC0 0%, #1567A8 55%, #0F5488 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 14rpx 30rpx rgba(21, 103, 168, 0.35);
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary-hover {
  opacity: 0.9;
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 8rpx 20rpx rgba(21, 103, 168, 0.24);
}
