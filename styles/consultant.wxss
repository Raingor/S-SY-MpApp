/* ===== 中文顾问微信卡片 ===== */
.consultant {
  margin-top: 40rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  border: 1rpx solid rgba(21, 103, 168, 0.08);
  box-shadow: 0 18rpx 44rpx rgba(11, 60, 93, 0.08);
}

.consultant::after {
  content: '';
  position: absolute;
  right: -110rpx;
  top: -150rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(211, 170, 91, 0.16);
  box-shadow: 0 0 0 36rpx rgba(211, 170, 91, 0.05);
  pointer-events: none;
}

.consultant-top {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.consultant-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid #EAF1F7;
}

.consultant-info {
  min-width: 0;
}

.consultant-name {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 600;
  color: var(--c-text);
}

.consultant-title {
  margin-top: 5rpx;
  color: var(--c-primary);
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.consultant-slogan {
  margin-top: 9rpx;
  font-size: 24rpx;
  color: var(--c-sub);
}

.consultant-wechat {
  margin-top: 13rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #F2F7FA;
  font-size: 24rpx;
  color: var(--c-primary);
  line-height: 1.45;
}

.consultant-qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.qr-img {
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  border: 6rpx solid #FFFFFF;
  background: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(11, 60, 93, 0.12);
}

.qr-tip {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--c-weak);
}

/* ===== 电话辅助 ===== */
.phone-row {
  margin-top: 20rpx;
  margin-bottom: 180rpx;
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--c-sub);
  padding: 20rpx 12rpx 0;
  border-top: 1rpx solid var(--c-line);
}

.phone-row > text:first-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.phone-arrow {
  flex-shrink: 0;
  color: var(--c-primary);
  font-weight: 600;
}
