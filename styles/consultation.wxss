/* 资讯咨询类页面共享样式 */
.consult-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #F4F7FA;
  color: var(--c-text);
}

.consult-hero {
  position: relative;
  padding: 0 32rpx 72rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #071F34, #0B3C5D 70%, #1567A8);
  color: #FFFFFF;
}

.consult-hero::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: 120rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  box-shadow: 0 0 0 52rpx rgba(255, 255, 255, 0.03), 0 0 0 104rpx rgba(255, 255, 255, 0.025);
}

.consult-nav {
  position: relative;
  z-index: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.82);
}

.consult-back {
  width: 56rpx;
  font-family: Georgia, serif;
  font-size: 48rpx;
}

.consult-brand {
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.consult-mark {
  color: #D8B878;
  font-size: 26rpx;
}

.consult-hero-body {
  position: relative;
  z-index: 1;
  padding-top: 52rpx;
}

.consult-kicker,
.consult-section-kicker {
  color: #D8B878;
  font-family: Inter, -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.consult-title {
  margin-top: 18rpx;
  max-width: 600rpx;
  font-size: 48rpx;
  line-height: 1.35;
}

.consult-subtitle {
  margin-top: 16rpx;
  max-width: 580rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.75;
}

.consult-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.consult-tag {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 19rpx;
}

.consult-card {
  position: relative;
  z-index: 2;
  margin: -38rpx 32rpx 0;
  padding: 30rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(11, 60, 93, 0.1);
}

.consult-card-title {
  color: var(--c-deep);
  font-size: 30rpx;
}

.consult-card-tip {
  margin-top: 6rpx;
  color: var(--c-weak);
  font-size: 19rpx;
}

.consult-field {
  margin-top: 26rpx;
}

.consult-label {
  margin-bottom: 10rpx;
  color: var(--c-text);
  font-size: 22rpx;
  font-weight: 600;
}

.consult-label text {
  color: var(--c-weak);
  font-weight: 400;
}

.consult-input,
.consult-picker,
.consult-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #F1F6F8;
  color: var(--c-text);
  font-size: 22rpx;
}

.consult-input,
.consult-picker {
  height: 68rpx;
  padding: 0 22rpx;
  line-height: 68rpx;
}

.consult-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.consult-picker text {
  color: var(--c-weak);
  font-size: 28rpx;
}

.consult-textarea {
  height: 140rpx;
  padding: 18rpx 22rpx;
  line-height: 1.65;
}

.consult-placeholder {
  color: #A7B8C1;
}

.consult-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.consult-option {
  flex: 1;
  min-width: 150rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid #DCE8ED;
  border-radius: 14rpx;
  color: var(--c-sub);
  font-size: 20rpx;
}

.consult-option-on {
  border-color: var(--c-primary);
  background: #EAF4F9;
  color: var(--c-primary);
  font-weight: 600;
}

.consult-contact-switch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.consult-contact-type {
  width: 120rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #DCE8ED;
  border-radius: 24rpx;
  color: var(--c-sub);
  font-size: 20rpx;
}

.consult-contact-on {
  border-color: var(--c-primary);
  background: #EAF4F9;
  color: var(--c-primary);
}

.consult-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 78rpx;
  margin-top: 32rpx;
  padding: 0;
  border: 0;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1E7BC0, #0F5488);
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1rpx;
}

.consult-submit::after {
  border: 0;
}

.consult-note {
  margin-top: 14rpx;
  color: var(--c-weak);
  font-size: 18rpx;
  line-height: 1.7;
  text-align: center;
}

.consult-compliance {
  margin: 28rpx 46rpx 0;
  color: var(--c-weak);
  font-size: 19rpx;
  line-height: 1.7;
  text-align: center;
}

.consult-footer {
  margin-top: 62rpx;
  padding: 28rpx 32rpx;
  border-top: 1rpx solid #DCE8ED;
  color: var(--c-weak);
  font-size: 18rpx;
  line-height: 1.7;
  text-align: center;
}
