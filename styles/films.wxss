.film-section { margin: 46rpx 32rpx 0; }
.film-section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.film-section-heading { flex: 1; min-width: 0; }
.film-eyebrow { color: #9A7737; font-size: 18rpx; letter-spacing: 4rpx; line-height: 1.5; }
.film-section-title { margin-top: 8rpx; color: #0B3C5D; font-size: 38rpx; line-height: 1.35; }
.film-all { flex: 0 0 auto; padding: 18rpx 0 18rpx 10rpx; color: #617683; font-size: 21rpx; }
.film-all text { margin-left: 8rpx; color: #A58142; font-size: 28rpx; }
.film-section-subtitle { margin: 12rpx 0 24rpx; color: #81909A; font-size: 22rpx; line-height: 1.6; }
.film-feature { overflow: hidden; border-radius: 26rpx; background: #0B354E; box-shadow: 0 12rpx 32rpx rgba(11,60,93,.1); }
.film-feature-poster { position: relative; height: 360rpx; overflow: hidden; background: #153E53; }
.film-poster-image { display: block; width: 100%; height: 100%; }
.film-poster-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,28,40,.04) 45%, rgba(8,28,40,.6)); }
.film-feature-label { position: absolute; top: 22rpx; left: 22rpx; padding: 8rpx 16rpx; border: 1rpx solid rgba(236,214,170,.55); border-radius: 8rpx; color: #F4E7CC; background: rgba(11,45,63,.78); font-size: 19rpx; letter-spacing: 2rpx; }
.film-play-mark { position: absolute; top: 50%; left: 50%; display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin: -38rpx 0 0 -38rpx; border: 1rpx solid rgba(255,255,255,.8); border-radius: 50%; background: rgba(12,44,62,.35); }
.film-play-mark view { width: 0; height: 0; margin-left: 6rpx; border-top: 13rpx solid transparent; border-bottom: 13rpx solid transparent; border-left: 20rpx solid #FFFFFF; }
.film-duration { position: absolute; bottom: 18rpx; right: 20rpx; padding: 4rpx 10rpx; border-radius: 5rpx; background: rgba(5,23,34,.6); color: #FFFFFF; font-size: 19rpx; font-variant-numeric: tabular-nums; }
.film-feature-copy { padding: 24rpx 28rpx 28rpx; }
.film-feature-number { color: #DFC48D; font-family: Georgia,serif; font-size: 24rpx; }
.film-feature-number text { color: #86A1B1; font-size: 19rpx; }
.film-feature-title { margin-top: 10rpx; color: #FFFFFF; font-size: 30rpx; line-height: 1.5; font-weight: 600; overflow-wrap: anywhere; }
.film-feature-description { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin-top: 10rpx; color: #B6C8D2; font-size: 22rpx; line-height: 1.7; }
.film-feature-cta { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-top: 19rpx; border-top: 1rpx solid rgba(218,198,155,.22); color: #E7C991; font-size: 22rpx; }
.film-feature-cta text { font-size: 29rpx; }
.film-more-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24rpx 18rpx; margin-top: 22rpx; }
.film-small { min-width: 0; }
.film-small-poster { position: relative; height: 184rpx; overflow: hidden; border-radius: 18rpx; background: #153E53; }
.film-small-play { position: absolute; bottom: 14rpx; left: 18rpx; color: #FFFFFF; font-size: 30rpx; }
.film-small-title { margin-top: 12rpx; color: #173C53; font-size: 25rpx; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
.film-empty { display: flex; align-items: center; gap: 24rpx; padding: 30rpx; border: 1rpx solid #E5DAC3; border-radius: 22rpx; background: #FAF8F2; color: #7B878C; font-size: 24rpx; line-height: 1.7; }
.film-empty-symbol { color: #B89B62; font-family: Georgia,serif; font-size: 48rpx; }
